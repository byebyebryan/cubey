#version 450

layout(local_size_x = 128) in;

struct Particle {
    vec4 position_radius;
    vec4 velocity_seed;
    vec4 color;
};

layout(set = 0, binding = 0, std430) buffer ParticleBuffer {
    Particle particles[];
};

layout(push_constant) uniform ComputeParams {
    vec4 attractor_strength_dt;
    vec4 bounds_damping_time;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= particles.length()) {
        return;
    }

    Particle particle = particles[index];
    vec2 position = particle.position_radius.xy;
    vec2 velocity = particle.velocity_seed.xy;
    float seed = particle.velocity_seed.w;

    vec2 to_attractor = params.attractor_strength_dt.xy - position;
    float distance2 = max(dot(to_attractor, to_attractor), 0.0125);
    vec2 direction = to_attractor * inversesqrt(distance2);
    vec2 tangent = vec2(-direction.y, direction.x);
    float spin = seed < 0.5 ? -1.0 : 1.0;
    float dt = params.attractor_strength_dt.w;

    vec2 acceleration =
        direction * (params.attractor_strength_dt.z / (distance2 + 0.08)) * 0.35 +
        tangent * spin * (0.22 / (distance2 + 0.20));
    velocity += acceleration * dt;
    velocity *= pow(params.bounds_damping_time.y, dt * 60.0);
    position += velocity * dt;

    float bounds = params.bounds_damping_time.x;
    if (position.x < -bounds || position.x > bounds) {
        position.x = clamp(position.x, -bounds, bounds);
        velocity.x *= -0.62;
    }
    if (position.y < -bounds || position.y > bounds) {
        position.y = clamp(position.y, -bounds, bounds);
        velocity.y *= -0.62;
    }

    particle.position_radius.xy = position;
    particle.velocity_seed.xy = velocity;
    particles[index] = particle;
}
