#version 450
#extension GL_GOOGLE_include_directive : require
#include "cubey/atmosphere.glsl"
#include "fluid_25d_daylight.glsl"
// Same captured-sky SH convolution as fixed daylight, on coherent generations.
layout(local_size_x=10) in;
layout(set=0,binding=0) uniform samplerCube current_sky;
layout(set=0,binding=2) uniform samplerCube previous_sky;
layout(set=0,binding=1,std430) writeonly buffer Output { vec4 coefficients[10]; } result;
layout(push_constant) uniform Medium {
    vec4 camera_blend,radii_ground,rayleigh,mie,ozone;
    vec4 sun_direction_radius,atmosphere_options,primary_source;
} medium;
void main() {
    int index=int(gl_LocalInvocationID.x);
    if(index==9) {
        vec3 radiance=medium.primary_source.xyz;
        if(medium.primary_source.w<0.5) {
            CubeyAtmosphereMedium m=CubeyAtmosphereMedium(vec3(0),medium.radii_ground.x,
                medium.radii_ground.y,medium.rayleigh.xyz,medium.rayleigh.w,
                medium.mie.x,medium.mie.y,medium.mie.z,medium.mie.w,
                medium.ozone.xyz,medium.ozone.w,medium.atmosphere_options.x,
                normalize(medium.sun_direction_radius.xyz),medium.sun_direction_radius.w,
                vec3(CUBEY_ATMOSPHERE_SUN_INTENSITY),0.022);
            radiance=CUBEY_ATMOSPHERE_SUN_INTENSITY*cubey_atmosphere_sun_transmittance(m,medium.camera_blend.xyz);
            if(medium.sun_direction_radius.y<=0.0) radiance=vec3(0);
        }
        result.coefficients[9]=vec4(radiance,0);return;
    }
    const int count=2048;
    vec3 sum=vec3(0);
    for(int i=0;i<count;++i) {
        float y=1.0-2.0*(float(i)+0.5)/float(count),r=sqrt(max(1.0-y*y,0.0));
        float phi=float(i)*2.39996322972865332;
        vec3 direction=vec3(cos(phi)*r,y,sin(phi)*r);
        vec3 light=mix(textureLod(previous_sky,direction,0).rgb,
            textureLod(current_sky,direction,0).rgb,medium.camera_blend.w);
        sum+=light*fluid25d_sh_basis(index,direction);
    }
    result.coefficients[index]=vec4(sum*(4.0*CUBEY_ATMOSPHERE_PI/float(count))*fluid25d_sh_lambert(index),0);
}
