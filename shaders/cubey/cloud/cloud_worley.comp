#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Compact 32^3 Worley erosion/detail volume.

#include "cubey/cloud/cloud_noise_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba8, set = 0, binding = 0) uniform writeonly image3D out_volume;

vec4 cloud_stackable_detail_noise(ivec3 pixel) {
    vec3 coord =
        vec3(float(pixel.x) / 32.0, float(pixel.y) / 32.0, float(pixel.z) / 32.0);

    float cell_count = 2.0;
    float worley0 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 1.0);
    float worley1 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 2.0);
    float worley2 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 4.0);
    float worley3 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 8.0);

    float worley_fbm0 = worley0 * 0.625 + worley1 * 0.25 + worley2 * 0.125;
    float worley_fbm1 = worley1 * 0.625 + worley2 * 0.25 + worley3 * 0.125;
    float worley_fbm2 = worley2 * 0.75 + worley3 * 0.25;
    return vec4(worley_fbm0, worley_fbm1, worley_fbm2, 1.0);
}

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(out_volume);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    imageStore(out_volume, pixel, cloud_stackable_detail_noise(pixel));
}
