#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Push {
    uint width;
    uint height;
    float time;
} pc;

layout(rgba8, binding = 0) uniform writeonly image2D out_image;

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) {
        return;
    }

    vec2 uv = vec2(p) / vec2(max(pc.width - 1, 1), max(pc.height - 1, 1));
    float wave = sin(uv.x * 14.0 + pc.time) * sin(uv.y * 11.0 - pc.time * 0.7);
    float ring = sin(length(uv - vec2(0.5)) * 32.0 - pc.time * 1.3);
    float v = clamp(wave * 0.35 + ring * 0.25 + 0.5, 0.0, 1.0);

    vec3 color = vec3(v, uv.x * v, (1.0 - uv.y) * (1.0 - v * 0.5));
    imageStore(out_image, ivec2(p), vec4(color, 1.0));
}
