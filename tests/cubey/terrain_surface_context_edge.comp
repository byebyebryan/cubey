#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Terrain { float values[]; } terrain;
layout(set=0,binding=1,std430) readonly buffer Depth { float values[]; } depth;
struct Vertex { vec4 position_wet; vec4 normal; vec4 surface; };
layout(set=0,binding=2,std430) readonly buffer Perimeter { Vertex values[]; } edge;
layout(set=0,binding=3,std430) writeonly buffer Results { vec4 values[]; } results;
layout(push_constant) uniform Params {vec4 grid_cell;} params;
#include "cubey/terrain/surface_patch/fluid_25d_bspline_surface.glsl"
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uint(params.grid_cell.w)) return;
    uvec2 grid=uvec2(params.grid_cell.xy);
    Vertex v=edge.values[i];
    vec2 p=v.position_wet.xz/params.grid_cell.z+0.5*vec2(grid-uvec2(1));
    vec2 bh,dx,dz;fluid25d_bspline_sample(p,grid,bh,dx,dz);
    vec3 n=fluid25d_bspline_normal(dx,dz,params.grid_cell.z,1.0,false);
    results.values[i]=vec4(abs(bh.x-v.position_wet.y),length(n-v.normal.xyz),bh.x,v.position_wet.y);
}
