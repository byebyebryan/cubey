#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) readonly uniform image2D height_dx_image;
layout(rgba32f, set = 0, binding = 1) readonly uniform image2D dz_slope_x_image;
layout(rgba32f, set = 0, binding = 2) readonly uniform image2D slope_z_curvature_image;
layout(rgba32f, set = 0, binding = 3) writeonly uniform image2D displacement_image;
layout(rgba32f, set = 0, binding = 4) writeonly uniform image2D normal_foam_image;

layout(push_constant) uniform FinalizeParams {
    vec4 ocean_options;
    vec4 cascade_options;
    vec4 foam_options;
    vec4 foam_shaping_options;
    vec4 debug_options;
} params;

ivec2 wrapped_texel(ivec2 texel, ivec2 size) {
    return ivec2((texel.x + size.x) % size.x, (texel.y + size.y) % size.y);
}

vec4 height_dx_at(ivec2 texel, ivec2 size) {
    ivec2 wrapped = ivec2((texel.x + size.x) % size.x, (texel.y + size.y) % size.y);
    return imageLoad(height_dx_image, wrapped) * params.cascade_options.w;
}

vec4 dz_slope_x_at(ivec2 texel, ivec2 size) {
    ivec2 wrapped = wrapped_texel(texel, size);
    return imageLoad(dz_slope_x_image, wrapped) * params.cascade_options.w;
}

vec4 slope_z_curvature_at(ivec2 texel, ivec2 size) {
    ivec2 wrapped = wrapped_texel(texel, size);
    return imageLoad(slope_z_curvature_image, wrapped) * params.cascade_options.w;
}

vec2 raw_horizontal_at(ivec2 texel, ivec2 size) {
    vec4 height_dx = height_dx_at(texel, size);
    vec4 dz_slope_x = dz_slope_x_at(texel, size);
    return vec2(height_dx.z, dz_slope_x.x);
}

float cascade_chop_scale(float cascade, float chop) {
    return chop * (cascade < 0.5 ? 1.18 : (cascade < 1.5 ? 1.08 : 1.0));
}

vec2 bounded_choppy_displacement(vec2 horizontal, float patch_length, float cascade) {
    float horizontal_limit =
        patch_length * (cascade < 0.5 ? 0.030 : (cascade < 1.5 ? 0.030 : 0.034));
    float horizontal_length = length(horizontal);
    return horizontal * min(1.0, horizontal_limit / max(horizontal_length, 0.0001));
}

vec2 choppy_horizontal_at(ivec2 texel, ivec2 size, float cascade_chop, float patch_length,
                          float cascade) {
    return bounded_choppy_displacement(raw_horizontal_at(texel, size) * cascade_chop,
                                       patch_length, cascade);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(displacement_image);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    float patch_length = params.cascade_options.x;
    float cell_size = patch_length / max(params.ocean_options.x, 1.0);
    vec4 height_dx = height_dx_at(texel, size);
    vec4 dz_slope_x = dz_slope_x_at(texel, size);
    vec4 slope_z_curvature = slope_z_curvature_at(texel, size);
    float center = height_dx.x;
    float chop = max(params.cascade_options.z, 0.0);
    float cascade = params.cascade_options.y;
    float cascade_chop = cascade_chop_scale(cascade, chop);
    vec2 horizontal = bounded_choppy_displacement(vec2(height_dx.z, dz_slope_x.x) * cascade_chop,
                                                  patch_length, cascade);
    vec2 slope = vec2(dz_slope_x.z, slope_z_curvature.x);
    vec3 normal = normalize(vec3(-slope.x * params.ocean_options.w, 1.0,
                                 -slope.y * params.ocean_options.w));

    vec2 horizontal_left =
        choppy_horizontal_at(texel + ivec2(-1, 0), size, cascade_chop, patch_length, cascade);
    vec2 horizontal_right =
        choppy_horizontal_at(texel + ivec2(1, 0), size, cascade_chop, patch_length, cascade);
    vec2 horizontal_down =
        choppy_horizontal_at(texel + ivec2(0, -1), size, cascade_chop, patch_length, cascade);
    vec2 horizontal_up =
        choppy_horizontal_at(texel + ivec2(0, 1), size, cascade_chop, patch_length, cascade);
    vec2 d_horizontal_dx = (horizontal_right - horizontal_left) / max(2.0 * cell_size, 0.0001);
    vec2 d_horizontal_dz = (horizontal_up - horizontal_down) / max(2.0 * cell_size, 0.0001);
    float jacobian =
        (1.0 + d_horizontal_dx.x) * (1.0 + d_horizontal_dz.y) -
        (d_horizontal_dz.x * d_horizontal_dx.y);
    float compression = clamp(max(0.0, 1.0 - jacobian), 0.0, 2.0);
    float curvature = max(0.0, -slope_z_curvature.z);
    float crest_signal = compression * 1.5 + curvature * cascade_chop * 0.14;
    float foam_coverage = clamp(params.foam_shaping_options.x, 0.0, 1.5);
    float foam_width = mix(0.74, 0.36, clamp(foam_coverage, 0.0, 1.0));
    float foam = smoothstep(params.foam_options.z, params.foam_options.z + foam_width,
                            crest_signal) *
                 params.foam_options.x * params.foam_options.w;
    foam *= mix(0.28, 0.92, clamp(foam_coverage, 0.0, 1.0));
    imageStore(displacement_image, texel, vec4(horizontal.x, center, horizontal.y, compression));
    imageStore(normal_foam_image, texel, vec4(normal, foam));
}
