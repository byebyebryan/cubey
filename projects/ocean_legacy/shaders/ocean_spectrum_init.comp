#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) writeonly uniform image2D h0_image;

layout(push_constant) uniform SpectrumParams {
    vec4 ocean_options;
    vec4 cascade_options;
    vec4 wind_options;
    vec4 seed_options;
} params;

const float PI = 3.14159265359;
const float G = 9.81;

float hash12(vec2 value) {
    vec3 p = fract(vec3(value.xyx) * vec3(443.8975, 397.2973, 491.1871));
    p += dot(p, p.yzx + 19.19);
    return fract((p.x + p.y) * p.z);
}

vec2 gaussian_pair(vec2 value) {
    float u1 = max(hash12(value), 0.000001);
    float u2 = hash12(value + vec2(37.2, 17.7));
    float radius = sqrt(-2.0 * log(u1));
    float angle = 2.0 * PI * u2;
    return radius * vec2(cos(angle), sin(angle));
}

int signed_frequency(int value, int size) {
    return value <= size / 2 ? value : value - size;
}

vec2 wave_vector(ivec2 texel, int size, float patch_length) {
    return (2.0 * PI / patch_length) *
           vec2(float(signed_frequency(texel.x, size)), float(signed_frequency(texel.y, size)));
}

vec2 finite_depth_dispersion(float k_len) {
    const float depth = 20.0;
    float kd = k_len * depth;
    float tanh_kd = tanh(kd);
    float omega = sqrt(G * k_len * tanh_kd);
    float d_omega_dk =
        0.5 * G * (tanh_kd + kd * (1.0 - tanh_kd * tanh_kd)) / max(omega, 0.0001);
    return vec2(omega, d_omega_dk);
}

float jonswap_alpha(float wind_speed, float fetch_m) {
    return 0.076 * pow((wind_speed * wind_speed) / max(fetch_m * G, 0.001), 0.22);
}

float jonswap_peak_omega(float wind_speed, float fetch_m) {
    return 22.0 * pow((G * G) / max(wind_speed * fetch_m, 0.001), 1.0 / 3.0);
}

float longuet_higgins_normalization(float value) {
    float root = sqrt(value);
    return value < 0.4 ? (0.5 / PI) + value * (0.220636 + value * (-0.109 + value * 0.090))
                       : inversesqrt(PI) * (root * 0.5 + (1.0 / root) * 0.0625);
}

float longuet_higgins(float value, float theta) {
    return longuet_higgins_normalization(value) * pow(abs(cos(theta * 0.5)), 2.0 * value);
}

float hasselmann_directional_spread(float omega, float peak_omega, float wind_speed,
                                    float theta, float wind_angle, float swell_scale) {
    float peak_ratio = omega / max(peak_omega, 0.0001);
    float base_shape =
        omega <= peak_omega
            ? 6.97 * pow(abs(peak_ratio), 4.06)
            : 9.77 *
                  pow(abs(peak_ratio),
                      -2.33 - 1.45 * ((wind_speed * peak_omega / G) - 1.17));
    float swell_shape = 16.0 * tanh(peak_omega / max(omega, 0.0001)) * swell_scale * swell_scale;
    return longuet_higgins(base_shape + swell_shape, theta - wind_angle);
}

float tma_spectrum(float omega, float peak_omega, float alpha) {
    const float beta = 1.25;
    const float gamma = 3.3;
    const float depth = 20.0;
    float sigma = omega <= peak_omega ? 0.07 : 0.09;
    float peak_shape = exp(-((omega - peak_omega) * (omega - peak_omega)) /
                           max(2.0 * sigma * sigma * peak_omega * peak_omega, 0.0001));
    float jonswap = (alpha * G * G) / max(pow(omega, 5.0), 0.0001) *
                    exp(-beta * pow(peak_omega / max(omega, 0.0001), 4.0)) *
                    pow(gamma, peak_shape);
    float depth_omega = min(omega * sqrt(depth / G), 2.0);
    float depth_attenuation =
        depth_omega <= 1.0 ? 0.5 * depth_omega * depth_omega
                           : 1.0 - 0.5 * (2.0 - depth_omega) * (2.0 - depth_omega);
    return jonswap * depth_attenuation;
}

float spectral_envelope(vec2 k, float patch_length, vec2 wind_dir) {
    float k_len = length(k);
    if (k_len < 0.00001) {
        return 0.0;
    }

    float wind_speed = max(params.wind_options.z, 0.1);
    float fetch_m = max(params.cascade_options.z, 0.1) * 1000.0;
    float swell_scale = clamp(params.wind_options.w, 0.35, 2.5);
    float spread = clamp(params.seed_options.y, 0.0, 1.0);
    float small_wave_detail = clamp(params.seed_options.z, 0.0, 1.0);
    vec2 dispersion = finite_depth_dispersion(k_len);
    float omega = dispersion.x;
    float d_omega_dk = dispersion.y;
    float peak_omega = jonswap_peak_omega(wind_speed, fetch_m);
    float alpha = jonswap_alpha(wind_speed, fetch_m);
    float theta = atan(k.x, k.y);
    float wind_angle = atan(wind_dir.x, wind_dir.y);
    float directional =
        mix(0.5 / PI,
            hasselmann_directional_spread(omega, peak_omega, wind_speed, theta, wind_angle,
                                          swell_scale),
            1.0 - spread);
    float detail_attenuation =
        exp(-((1.0 - small_wave_detail) * (1.0 - small_wave_detail)) * k_len * k_len);
    float dk = (2.0 * PI) / max(patch_length, 0.001);
    float omega_normalization = d_omega_dk / k_len * dk * dk;
    return 2.0 * tma_spectrum(omega, peak_omega, alpha) * directional *
           max(omega_normalization, 0.0) * detail_attenuation;
}

vec2 h0_for_frequency(ivec2 texel, int size, float patch_length, vec2 wind_dir, float seed) {
    vec2 k = wave_vector(texel, size, patch_length);
    float envelope = spectral_envelope(k, patch_length, wind_dir);
    float coefficient_scale =
        params.ocean_options.z * params.ocean_options.w * sqrt(max(envelope, 0.0));
    vec2 gaussian = gaussian_pair(vec2(texel) + vec2(seed, seed * 1.37));
    return gaussian * coefficient_scale;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(h0_image);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    int n = size.x;
    float patch_length = params.cascade_options.x;
    vec2 wind_dir = normalize(params.wind_options.xy);
    float seed = params.seed_options.x + params.cascade_options.y * 101.0;
    ivec2 mirrored = ivec2((n - texel.x) % n, (n - texel.y) % n);
    vec2 h0 = h0_for_frequency(texel, n, patch_length, wind_dir, seed);
    vec2 h0_minus = h0_for_frequency(mirrored, n, patch_length, wind_dir, seed);
    imageStore(h0_image, texel, vec4(h0, h0_minus));
}
