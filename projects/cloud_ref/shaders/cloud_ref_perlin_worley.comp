#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Noise layout follows the Hillaire/Nubis-style Perlin-Worley base volume used
// by TerrainEngine and credited there to NadirRoGue-style cloud references.

#include "cloud_ref_noise_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba8, set = 0, binding = 0) uniform writeonly image3D out_volume;

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(out_volume);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec3 coord = (vec3(pixel) + vec3(0.5)) / vec3(size);
    float perlin_noise = cloud_ref_fbm_3d(coord * 8.0, 3);

    float worley0 = 1.0 - cloud_ref_worley_3d(coord, 4.0 * 2.0);
    float worley1 = 1.0 - cloud_ref_worley_3d(coord, 4.0 * 8.0);
    float worley2 = 1.0 - cloud_ref_worley_3d(coord, 4.0 * 14.0);
    float worley3 = 1.0 - cloud_ref_worley_3d(coord, 4.0 * 20.0);
    float worley4 = 1.0 - cloud_ref_worley_3d(coord, 4.0 * 26.0);
    float worley_fbm = worley0 * 0.625 + worley1 * 0.25 + worley2 * 0.125;
    float perlin_worley =
        cloud_ref_noise_remap(perlin_noise, 0.0, 1.0, worley_fbm, 1.0);

    float layer0 = worley1 * 0.625 + worley2 * 0.25 + worley3 * 0.125;
    float layer1 = worley2 * 0.625 + worley3 * 0.25 + worley4 * 0.125;
    float layer2 = worley3 * 0.75 + worley4 * 0.25;
    imageStore(out_volume, pixel, vec4(perlin_worley * perlin_worley, layer0, layer1, layer2));
}
