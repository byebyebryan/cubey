#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Compact 32^3 Worley erosion/detail volume.

#include "cloud_ref_noise_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba8, set = 0, binding = 0) uniform writeonly image3D out_volume;

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(out_volume);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec3 coord = (vec3(pixel) + vec3(0.5)) / vec3(size);
    float worley0 = 1.0 - cloud_ref_worley_3d(coord, 2.0);
    float worley1 = 1.0 - cloud_ref_worley_3d(coord, 4.0);
    float worley2 = 1.0 - cloud_ref_worley_3d(coord, 8.0);
    float worley3 = 1.0 - cloud_ref_worley_3d(coord, 16.0);

    float layer0 = worley0 * 0.625 + worley1 * 0.25 + worley2 * 0.125;
    float layer1 = worley1 * 0.625 + worley2 * 0.25 + worley3 * 0.125;
    float layer2 = worley2 * 0.75 + worley3 * 0.25;
    imageStore(out_volume, pixel, vec4(layer0, layer1, layer2, 1.0));
}
