#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Core path: spherical shell march, Perlin-Worley base density, Worley erosion,
// Beer transmittance, Bayer jitter, and short cone light march.

#include "cloud_ref_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D cloud_product;
layout(set = 0, binding = 2) uniform sampler3D base_noise_texture;
layout(set = 0, binding = 3) uniform sampler3D detail_noise_texture;
layout(set = 0, binding = 4) uniform sampler2D weather_texture;

const vec4 STRATUS_GRADIENT = vec4(0.00, 0.10, 0.20, 0.30);
const vec4 STRATOCUMULUS_GRADIENT = vec4(0.02, 0.20, 0.48, 0.625);
const vec4 CUMULUS_GRADIENT = vec4(0.00, 0.1625, 0.88, 0.98);
const vec3 WIND_DIRECTION = normalize(vec3(0.5, 0.0, 0.1));
const float CLOUD_TOP_OFFSET = 750.0;
const vec3 NOISE_KERNEL[6] = vec3[](
    vec3(0.38051305, 0.92453449, -0.02111345),
    vec3(-0.50625799, -0.03590792, -0.86163418),
    vec3(-0.32509218, -0.94557439, 0.01428793),
    vec3(0.09026238, -0.27376545, 0.95755165),
    vec3(0.28128598, 0.42443639, -0.86065785),
    vec3(-0.16852403, 0.14748697, 0.97460106));
const float BAYER[16] = float[](
    0.0 / 16.0, 8.0 / 16.0, 2.0 / 16.0, 10.0 / 16.0,
    12.0 / 16.0, 4.0 / 16.0, 14.0 / 16.0, 6.0 / 16.0,
    3.0 / 16.0, 11.0 / 16.0, 1.0 / 16.0, 9.0 / 16.0,
    15.0 / 16.0, 7.0 / 16.0, 13.0 / 16.0, 5.0 / 16.0);

struct DensitySample {
    float density;
    float base_density;
    float detail_density;
    float weather;
    float height_fraction;
};

struct MarchResult {
    vec3 radiance;
    float transmittance;
    float alpha;
    float avg_density;
    float last_light;
    float first_distance;
    float steps;
};

float cloud_ref_height_fraction(vec3 position) {
    return (length(position - cloud_ref_sphere_center()) - cloud_ref_inner_radius()) /
           max(cloud_ref_outer_radius() - cloud_ref_inner_radius(), 0.001);
}

float cloud_ref_density_gradient(float height_fraction, float cloud_type) {
    float stratus = 1.0 - clamp(cloud_type * 2.0, 0.0, 1.0);
    float stratocumulus = 1.0 - abs(cloud_type - 0.5) * 2.0;
    float cumulus = clamp(cloud_type - 0.5, 0.0, 1.0) * 2.0;
    vec4 gradient = stratus * STRATUS_GRADIENT +
                    stratocumulus * STRATOCUMULUS_GRADIENT +
                    cumulus * CUMULUS_GRADIENT;
    return smoothstep(gradient.x, gradient.y, height_fraction) -
           smoothstep(gradient.z, gradient.w, height_fraction);
}

vec2 cloud_ref_project_uv(vec3 position) {
    return position.xz / cloud_ref_inner_radius() + vec2(0.5);
}

DensitySample cloud_ref_sample_density(vec3 position, bool expensive, float lod) {
    float height_fraction = cloud_ref_height_fraction(position);
    if (height_fraction <= 0.0 || height_fraction >= 1.0) {
        return DensitySample(0.0, 0.0, 0.0, 0.0, height_fraction);
    }

    float crispiness = max(params.shape_options.x, 0.001);
    float curliness = max(params.shape_options.y, 0.001);
    vec3 animation =
        height_fraction * WIND_DIRECTION * CLOUD_TOP_OFFSET + WIND_DIRECTION * params.weather.w;
    vec2 shape_uv = cloud_ref_project_uv(position);
    vec2 moving_shape_uv = cloud_ref_project_uv(position + animation);

    vec4 low_frequency =
        textureLod(base_noise_texture, vec3(shape_uv * crispiness, height_fraction), lod);
    float low_fbm = dot(low_frequency.gba, vec3(0.625, 0.25, 0.125));
    float base_cloud =
        cloud_ref_remap(low_frequency.r, -(1.0 - low_fbm), 1.0, 0.0, 1.0);

    float density_profile = cloud_ref_density_gradient(height_fraction, 1.0);
    base_cloud *= density_profile / max(height_fraction, 0.0001);

    vec3 weather = texture(weather_texture, moving_shape_uv).rgb;
    float coverage = weather.r * params.weather.x;
    float base_with_coverage =
        cloud_ref_remap(base_cloud, coverage, 1.0, 0.0, 1.0) * coverage;
    float detail_density = 0.0;

    if (expensive) {
        vec3 detail =
            textureLod(detail_noise_texture,
                       vec3(moving_shape_uv * crispiness, height_fraction) * curliness, lod)
                .rgb;
        float high_fbm = dot(detail, vec3(0.625, 0.25, 0.125));
        float high_modifier =
            mix(high_fbm, 1.0 - high_fbm, clamp(height_fraction * 10.0, 0.0, 1.0));
        detail_density = high_modifier;
        base_with_coverage -= high_modifier * (1.0 - base_with_coverage);
        base_with_coverage = cloud_ref_remap(base_with_coverage * 2.0,
                                             high_modifier * 0.2, 1.0, 0.0, 1.0);
    }

    float density = clamp(base_with_coverage, 0.0, 1.0);
    return DensitySample(density, clamp(base_cloud, 0.0, 1.0), detail_density, coverage,
                         height_fraction);
}

float cloud_ref_light_transmittance(vec3 start, float step_size, vec3 light_dir,
                                    float original_density, float light_dot_eye) {
    int light_steps = clamp(int(params.ref_options.z + 0.5), 1, 6);
    float ds = step_size * 6.0;
    vec3 ray_step = light_dir * ds;
    float absorption = params.shape_options.z * 0.01;
    float sigma_ds = -ds * absorption;
    float transmittance = 1.0;
    float cone_radius = 1.0;
    float density_sum = 0.0;
    vec3 pos = start;

    for (int i = 0; i < 6; ++i) {
        if (i >= light_steps) {
            break;
        }
        vec3 cone_pos = pos + cone_radius * NOISE_KERNEL[i] * float(i);
        DensitySample sample_data = cloud_ref_sample_density(cone_pos, density_sum > 0.3,
                                                             float(i / 16));
        if (sample_data.density > 0.0) {
            transmittance *= exp(sample_data.density * sigma_ds);
            density_sum += sample_data.density;
        }
        pos += ray_step;
        cone_radius += 1.0 / 6.0;
    }
    return transmittance;
}

bool cloud_ref_shell_segment(vec3 origin, vec3 direction, out float start_t, out float end_t) {
    float outer_near = 0.0;
    float outer_far = 0.0;
    if (!cloud_ref_ray_sphere(origin, direction, cloud_ref_outer_radius(), outer_near,
                              outer_far)) {
        start_t = 0.0;
        end_t = 0.0;
        return false;
    }

    float inner_near = 0.0;
    float inner_far = 0.0;
    bool inner_hit = cloud_ref_ray_sphere(origin, direction, cloud_ref_inner_radius(),
                                          inner_near, inner_far);

    float camera_radius = length(origin - cloud_ref_sphere_center());
    start_t = max(outer_near, 0.0);
    end_t = outer_far;

    if (camera_radius < cloud_ref_inner_radius()) {
        if (!inner_hit || inner_far <= 0.0) {
            return false;
        }
        start_t = max(start_t, inner_far);
    } else if (camera_radius < cloud_ref_outer_radius()) {
        start_t = 0.0;
        if (inner_hit && inner_near > 0.0) {
            end_t = min(end_t, inner_near);
        }
    } else if (inner_hit && inner_near > start_t) {
        end_t = min(end_t, inner_near);
    }

    float ground_near = 0.0;
    float ground_far = 0.0;
    if (cloud_ref_ray_sphere(origin, direction, cloud_ref_planet_radius(), ground_near,
                             ground_far) &&
        ground_near > 0.0) {
        end_t = min(end_t, ground_near);
    }

    return end_t > start_t;
}

MarchResult cloud_ref_march(vec3 origin, vec3 direction, float start_t, float end_t,
                            vec3 background, ivec2 pixel) {
    int max_steps = clamp(int(params.ref_options.y + 0.5), 1, 96);
    float length_km = max(end_t - start_t, 0.001);
    float ds = length_km / float(max_steps);
    vec3 step_vec = direction * ds;
    int bx = pixel.x & 3;
    int by = pixel.y & 3;
    vec3 pos = origin + direction * (start_t + ds * BAYER[by * 4 + bx]);
    vec3 sun_dir = normalize(params.sun_direction_intensity.xyz);
    vec3 sun_color = vec3(1.1, 1.1, 0.95) * max(params.sun_direction_intensity.w, 0.0);
    float light_dot_eye = dot(sun_dir, direction);
    float density_factor = max(params.weather.y, 0.0);
    float sigma_ds = -ds * density_factor;
    float transmittance = 1.0;
    vec3 color = vec3(0.0);
    float density_sum = 0.0;
    float last_light = 1.0;
    float first_distance = -1.0;
    float steps_taken = 0.0;

    for (int i = 0; i < 96; ++i) {
        if (i >= max_steps) {
            break;
        }
        DensitySample sample_data = cloud_ref_sample_density(pos, true, float(i / 16));
        if (sample_data.density > 0.0) {
            if (first_distance < 0.0) {
                first_distance = length(pos - origin);
            }
            float light_transmittance =
                cloud_ref_light_transmittance(pos, ds * 0.1, sun_dir, sample_data.density,
                                              light_dot_eye);
            float scattering = cloud_ref_phase(light_dot_eye);
            vec3 ambient = params.cloud_color_bottom_horizon.rgb;
            float powder_term =
                params.shape_options.w > 0.5 ? (1.0 - exp(-2.0 * sample_data.density)) : 1.0;
            vec3 source = 0.6 *
                          mix(mix(ambient * 1.8, background, 0.2),
                              scattering * sun_color, powder_term * light_transmittance) *
                          sample_data.density;
            float d_transmittance = exp(sample_data.density * sigma_ds);
            vec3 integral = (source - source * d_transmittance) /
                            max(sample_data.density, 0.0001);
            color += transmittance * integral;
            transmittance *= d_transmittance;
            density_sum += sample_data.density;
            last_light = light_transmittance;
        }
        if (transmittance <= 0.01) {
            break;
        }
        pos += step_vec;
        steps_taken += 1.0;
    }

    float alpha = 1.0 - transmittance;
    color = max(color * 1.8 - vec3(0.1 * alpha), vec3(0.0));
    if (first_distance > 0.0) {
        float fog = 1.0 - exp(-first_distance * 0.00006 * params.cloud_color_bottom_horizon.w);
        color = mix(color, background * alpha, clamp(fog, 0.0, 1.0));
    }
    return MarchResult(color, transmittance, alpha, density_sum / float(max_steps), last_light,
                       first_distance, steps_taken);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloud_product);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 position = uv * 2.0 - 1.0;
    vec3 origin = params.camera_position_radius.xyz;
    vec3 direction = cloud_ref_view_direction(position);
    vec3 background = cloud_ref_background(direction);
    int debug_view = int(params.ref_options.x + 0.5);

    float start_t = 0.0;
    float end_t = 0.0;
    bool has_segment = cloud_ref_shell_segment(origin, direction, start_t, end_t);
    if (!has_segment) {
        vec3 debug_color = debug_view == CLOUD_REF_DEBUG_BACKGROUND ? background : vec3(0.0);
        imageStore(cloud_product, pixel,
                   vec4(debug_view == CLOUD_REF_DEBUG_FINAL ? vec3(0.0) : debug_color, 1.0));
        return;
    }

    MarchResult result = cloud_ref_march(origin, direction, start_t, end_t, background, pixel);
    vec3 debug_color = result.radiance;
    float debug_alpha = 1.0;

    if (debug_view == CLOUD_REF_DEBUG_WEATHER ||
        debug_view == CLOUD_REF_DEBUG_BASE_DENSITY ||
        debug_view == CLOUD_REF_DEBUG_DETAIL_DENSITY ||
        debug_view == CLOUD_REF_DEBUG_DENSITY) {
        vec3 mid = origin + direction * mix(start_t, end_t, 0.5);
        DensitySample sample_data = cloud_ref_sample_density(mid, true, 0.0);
        if (debug_view == CLOUD_REF_DEBUG_WEATHER) {
            debug_color = vec3(sample_data.weather);
        } else if (debug_view == CLOUD_REF_DEBUG_BASE_DENSITY) {
            debug_color = vec3(sample_data.base_density);
        } else if (debug_view == CLOUD_REF_DEBUG_DETAIL_DENSITY) {
            debug_color = vec3(sample_data.detail_density);
        } else {
            debug_color = vec3(sample_data.density);
        }
    } else if (debug_view == CLOUD_REF_DEBUG_TRANSMITTANCE) {
        debug_color = vec3(result.transmittance);
    } else if (debug_view == CLOUD_REF_DEBUG_LIGHTING) {
        debug_color = vec3(result.last_light);
    } else if (debug_view == CLOUD_REF_DEBUG_SHADOW) {
        debug_color = vec3(1.0 - result.last_light);
    } else if (debug_view == CLOUD_REF_DEBUG_STEPS) {
        debug_color = vec3(result.steps / max(params.ref_options.y, 1.0));
    } else if (debug_view == CLOUD_REF_DEBUG_BACKGROUND) {
        debug_color = background;
    } else if (debug_view == CLOUD_REF_DEBUG_CLOUD_ALPHA) {
        debug_color = vec3(result.alpha);
    } else if (debug_view == CLOUD_REF_DEBUG_DISTANCE) {
        debug_color = vec3(clamp(result.first_distance / 500.0, 0.0, 1.0));
    } else if (debug_view == CLOUD_REF_DEBUG_FINAL ||
               debug_view == CLOUD_REF_DEBUG_RAW_FINAL) {
        debug_alpha = result.transmittance;
    }

    imageStore(cloud_product, pixel,
               vec4(max(debug_color, vec3(0.0)), debug_alpha));
}
