#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#define AUTHORED_BINDING 10
#include "authored.glsl"
layout(local_size_x=64) in;
layout(std430,set=0,binding=5) readonly buffer Frontier {uint inputs[];};
layout(r16f,set=0,binding=9) writeonly uniform image3D atlas;
layout(std430,set=0,binding=20) readonly buffer Fallbacks {uint fallbacks[];};
layout(std430,set=0,binding=21) readonly buffer NewBricks {uint newBricks[];};
layout(push_constant) uniform Params {uint depth;uint count;uint newTexels;uint refCapacity;uint atlasAxis;} pc;
void main() {
    uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*65535u)*64u+gl_LocalInvocationIndex;
    if(id>=pc.count) return;
    uint packed=id<pc.newTexels ? newBricks[id/512u]*512u+(id%512u) : fallbacks[id-pc.newTexels];
    uint index=packed/512u,local=packed%512u;
    ivec3 cell=ivec3(local%8u,(local/8u)%8u,local/64u);
    uint ptr=inputs[index];
    vec3 p=(vec3(unmorton(ptr-LEVEL[pc.depth]))+vec3(cell)/7.0)/float(1u<<pc.depth)-0.5;
    imageStore(atlas,brickOrigin(index,pc.atlasAxis)+cell,vec4(authoredDistance(p)));
}
