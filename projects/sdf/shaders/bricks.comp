#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
layout(local_size_x=8,local_size_y=8,local_size_z=8) in;
layout(std430,set=0,binding=1) buffer Nodes { uint nodes[]; };
layout(std430,set=0,binding=2) readonly buffer EditHeaders { uvec2 editHeaders[]; };
layout(std430,set=0,binding=3) readonly buffer References { uint refs[]; };
layout(std430,set=0,binding=4) readonly buffer Edits { Edit edits[]; };
layout(std430,set=0,binding=5) readonly buffer InputNodes { uint inputs[]; };
layout(std430,set=0,binding=7) buffer Counters { uint outputCount; uint refCount; uint overflow; uint updated; };
layout(set=0,binding=8) uniform sampler3D originalAtlas;
layout(r16f,set=0,binding=9) writeonly uniform image3D atlas;
layout(push_constant) uniform Params { uint depth; uint count; uint capacity; uint refCapacity; uint atlasAxis; } pc;
shared uint header;
shared uint editCount;
shared Edit cache[128];
void main() {
    uint index = gl_WorkGroupID.x + gl_WorkGroupID.y * 1024u;
    if (index >= pc.count) return;
    uint ptr = inputs[index];
    if (gl_LocalInvocationIndex == 0) {
        header = nodes[ptr];
        editCount = (header & NEW_EDIT) != 0 ? editHeaders[ptr].y : 0;
    }
    barrier();
    if (gl_LocalInvocationIndex < editCount)
        cache[gl_LocalInvocationIndex] = edits[refs[editHeaders[ptr].x+gl_LocalInvocationIndex]];
    barrier();
    ivec3 cell = ivec3(gl_LocalInvocationID);
    float d = (header & FILLED) != 0 ? -1000.0 : 1000.0;
    if ((header & OVERWRITTEN) == 0)
        d = texelFetch(originalAtlas,brickOrigin(header & POINTER,pc.atlasAxis)+cell,0).r;
    vec3 p = (vec3(unmorton(ptr-LEVEL[pc.depth])) + vec3(cell)/7.0) /
              float(1u<<pc.depth) - 0.5;
    for (uint i=0; i<editCount; ++i) d = applyEdit(d,editDistance(p,cache[i]),cache[i]);
    imageStore(atlas,brickOrigin(index,pc.atlasAxis)+cell,vec4(d));
    if (gl_LocalInvocationIndex == 0) {
        nodes[ptr] = SUBDIVIDED | index;
        if (editCount>0) atomicAdd(updated,1u);
    }
}
