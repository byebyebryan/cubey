#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
layout(local_size_x=64) in;
layout(push_constant) uniform Params { uint axis; uint count; } pc;
#define atlasAxis pc.axis
#include "trace.glsl"
struct Ray { vec4 origin; vec4 direction; };
layout(std430,set=0,binding=2) readonly buffer Rays { Ray rays[]; };
layout(std430,set=0,binding=3) writeonly buffer Results { vec4 results[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=pc.count) return;
    Hit hit=trace(rays[i].origin.xyz,rays[i].direction.xyz,5.0);
    results[i]=vec4(hit.t,float(hit.status),float(hit.steps),0);
}
