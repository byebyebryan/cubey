#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#include "authored.glsl"
layout(push_constant) uniform Params {uint count;uint atlas_axis;} pc;
#define atlasAxis pc.atlas_axis
#define SDF_ACCELERATION
#define SDF_LIVE_COUNTS
#include "live_edit_trace.glsl"
layout(local_size_x=64) in;
struct Query {vec4 origin;vec4 direction;};
struct Result {vec4 hit;vec4 normal;vec4 values;uvec4 counts;uvec4 instructions;vec4 corners0;vec4 corners1;vec4 sampleInfo;};
layout(std430,set=0,binding=2) readonly buffer Queries {Query queries[];};
layout(std430,set=0,binding=15) writeonly buffer Results {Result results[];};
void storedCorners(vec3 p,out vec4 a,out vec4 b,out vec4 info) {
    a=vec4(0);b=vec4(0);info=vec4(0);
    LiveBase base=liveBase(p,vec3(0));
    if(!base.sampled)return;
    ivec3 cell;uint level;uint header=liveLookup(p,vec3(0),cell,level);
    vec3 local=clamp((p+.5)*256.0-vec3(cell),0.0,1.0)*7.0;
    ivec3 voxel=min(ivec3(floor(local)),ivec3(6));
    ivec3 point=brickOrigin(header&POINTER,atlasAxis)+voxel;
    for(int k=0;k<8;++k) {
        float v=texelFetch(atlas,point+ivec3(k&1,(k>>1)&1,(k>>2)&1),0).r;
        if(k<4)a[k]=v;else b[k-4]=v;
    }
    info=vec4(local-vec3(voxel),1);
}
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    Query q=queries[i];
    liveCounts=uvec4(0);liveInstructions=uvec2(0);
    if(q.origin.w>.5) {
        LiveBase b=liveBase(q.origin.xyz,vec3(0));
        vec2 interval=liveFold(q.origin.xyz,b.interval);
        float d=livePointDistance(q.origin.xyz);
        vec4 a,c,info;storedCorners(q.origin.xyz,a,c,info);
        results[i]=Result(vec4(d,0,0,0),vec4(0),
            vec4(authoredDistance(q.origin.xyz),interval,liveBaseRaw(q.origin.xyz)),
            liveCounts,uvec4(liveInstructions,0,0),a,c,info);return;
    }
    Hit h=trace(q.origin.xyz,q.direction.xyz,3.0);
    vec3 p=q.origin.xyz+h.t*q.direction.xyz;
    vec3 n=h.status==1?hitNormal(p,h):vec3(0);
    vec4 a,c,info;storedCorners(p,a,c,info);
    results[i]=Result(vec4(h.t,h.status,h.steps,h.status==1?livePointDistance(p):0.0),
        vec4(n,0),vec4(h.status==1?authoredDistance(p):0.0,0,0,0),
        liveCounts,uvec4(liveInstructions,0,0),a,c,info);
}
