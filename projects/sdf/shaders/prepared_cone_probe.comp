#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#include "authored.glsl"
#include "prepared_cones.glsl"
layout(local_size_x=64) in;
layout(push_constant) uniform Params { uint count; } pc;
layout(std430,set=0,binding=2) readonly buffer Queries { vec4 queries[]; };
struct Output {vec4 distance;vec4 normalReference;vec4 normalPrepared;};
layout(std430,set=0,binding=15) writeonly buffer Results {Output results[];};
const float delta=1.0/(256.0*7.0*16.0);
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count) return;
    vec3 p=queries[i].xyz;uint id=uint(queries[i].w);
    SceneInstruction n=authoredNodes[id];
    float a=authoredPrimitive(p,n),b=authoredPreparedPrimitive(p,n,id);
    vec3 ga,gb;
    for(int axis=0;axis<3;++axis) {
        vec3 e=vec3(0);e[axis]=delta;
        ga[axis]=authoredPrimitive(p+e,n)-authoredPrimitive(p-e,n);
        gb[axis]=authoredPreparedPrimitive(p+e,n,id)-authoredPreparedPrimitive(p-e,n,id);
    }
    results[i]=Output(vec4(a,b,0,0),vec4(ga,0),vec4(gb,0));
}
