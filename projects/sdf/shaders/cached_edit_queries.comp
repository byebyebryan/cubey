#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#include "authored.glsl"
layout(push_constant) uniform Params {uint count;uint atlas_axis;} pc;
#define atlasAxis pc.atlas_axis
#include "cached_edit_trace.glsl"
layout(local_size_x=64) in;
struct Query {vec4 origin;vec4 direction;};
struct Result {vec4 hit;vec4 normal;vec4 diagnostic;};
layout(std430,set=0,binding=2) readonly buffer Queries {Query queries[];};
layout(std430,set=0,binding=15) writeonly buffer Results {Result results[];};
void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    Query q=queries[i];Hit hit=trace(q.origin.xyz,q.direction.xyz,3.0);
    vec3 p=q.origin.xyz+q.direction.xyz*hit.t;
    vec3 n=hit.status==1?hitNormal(p,hit):vec3(0);
    results[i]=Result(vec4(hit.t,hit.status,hit.steps,hit.pointer==EDIT_SURFACE?1:0),vec4(n,0),
        vec4(hit.status==1?authoredDistance(p):0,0,0,0));
}
