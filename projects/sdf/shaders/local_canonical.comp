void main() {
    uint id=(gl_WorkGroupID.x+gl_WorkGroupID.y*65535u)*64u+gl_LocalInvocationIndex;if(id>=pc.count)return;
    uint packed=id<pc.newTexels?newBricks[id/512u]*512u+(id%512u):fallbacks[id-pc.newTexels];
