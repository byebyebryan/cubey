#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#define AUTHORED_BINDING 0
#define AUTHORED_MATERIAL_BINDING 1
#define AUTHORED_PATTERN_BINDING 4
#define SDF_OPTICS
#define AUTHORED_OPTICS_BINDING 5
#define AUTHORED_DOMAIN_BINDING 6
#define AUTHORED_LIBRARY_BINDING 7
#include "authored.glsl"
#include "authored_material.glsl"
#include "optics_math.glsl"
layout(local_size_x=64) in;
layout(std430,set=0,binding=2) readonly buffer Points { vec4 points[]; };
layout(std430,set=0,binding=3) writeonly buffer Results { vec4 results[]; };
layout(push_constant) uniform Params { uint count; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=pc.count) return;
    SceneSurface surface=authoredSurface(points[i].xyz,points[i].w,true);
    MaterialSample fast=sampleAuthoredMaterial(0u,points[i].xyz,points[i].w,true);
    float error=authoredHeader.x>0u && authoredHeader.y==1u ? max(length(fast.material.base_roughness-surface.material.base_roughness),
        length(fast.height_gradient-surface.height_gradient)) : 0.0;
    results[i*12u]=vec4(surface.distance,authoredDistance(points[i].xyz),float(surface.part),error);
    results[i*12u+1u]=surface.material.base_roughness;
    results[i*12u+2u]=surface.material.emission;
    vec3 roughLight=normalize(vec3(points[i].x,points[i].y,1));
    vec3 roughView=normalize(vec3(-points[i].y,points[i].z,1));
    results[i*12u+3u]=vec4(surface.height_gradient,
        roughDiffuseFactor(roughLight.z,roughView.z,dot(roughLight,roughView),surface.optics.attenuation.w));
    bool inside=points[i].y>0;
    OpticalInterface face=opticalInterface(normalize(vec3(points[i].x*3,.2,-1)),
        inside ? vec3(0,0,-1) : vec3(0,0,1),inside,surface.optics.settings.z);
    results[i*12u+7u]=vec4(face.transmitted,face.fresnel);
    results[i*12u+8u]=vec4(face.reflected,face.tir ? 1 : 0);
    results[i*12u+9u]=vec4(opticalAbsorption(surface.optics.attenuation.rgb,surface.optics.settings.w,.37),0);
    results[i*12u+10u]=surface.sheen;
    results[i*12u+11u]=vec4(surface.rough_glass,0,0,0);
    results[i*12u+5u]=surface.optics.settings;
    results[i*12u+6u]=surface.optics.attenuation;
    results[i*12u+4u]=vec4(materialShadingNormal(normalize(vec3(.2,1,.3)),surface.height_gradient),0);
}
