#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Core path: spherical shell march, Perlin-Worley base density, Worley erosion,
// Beer transmittance, Bayer jitter, and short cone light march.

#include "cloud_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D cloud_product;
layout(set = 0, binding = 2) uniform sampler3D base_noise_texture;
layout(set = 0, binding = 3) uniform sampler3D detail_noise_texture;
layout(set = 0, binding = 4) uniform sampler2D weather_texture;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image2D cloud_metadata;

const vec4 STRATUS_GRADIENT = vec4(0.00, 0.10, 0.20, 0.30);
const vec4 STRATOCUMULUS_GRADIENT = vec4(0.02, 0.20, 0.48, 0.625);
const vec4 CUMULUS_GRADIENT = vec4(0.00, 0.1625, 0.88, 0.98);
const vec3 WIND_DIRECTION = normalize(vec3(0.5, 0.0, 0.1));
const float CLOUD_TOP_OFFSET = 750.0;
const vec3 NOISE_KERNEL[6] = vec3[](
    vec3(0.38051305, 0.92453449, -0.02111345),
    vec3(-0.50625799, -0.03590792, -0.86163418),
    vec3(-0.32509218, -0.94557439, 0.01428793),
    vec3(0.09026238, -0.27376545, 0.95755165),
    vec3(0.28128598, 0.42443639, -0.86065785),
    vec3(-0.16852403, 0.14748697, 0.97460106));
const float BAYER[16] = float[](
    0.0 / 16.0, 8.0 / 16.0, 2.0 / 16.0, 10.0 / 16.0,
    12.0 / 16.0, 4.0 / 16.0, 14.0 / 16.0, 6.0 / 16.0,
    3.0 / 16.0, 11.0 / 16.0, 1.0 / 16.0, 9.0 / 16.0,
    15.0 / 16.0, 7.0 / 16.0, 13.0 / 16.0, 5.0 / 16.0);

struct DensitySample {
    float density;
    float base_density;
    float detail_density;
    float weather;
    float height_fraction;
};

struct MarchResult {
    vec3 radiance;
    float transmittance;
    float alpha;
    float avg_density;
    float last_light;
    float first_distance;
    float mean_distance;
    float steps;
    vec3 ambient_light;
    vec3 direct_light;
    vec3 phase_light;
};

float cloud_interleaved_gradient_noise(ivec2 pixel) {
    vec2 p = vec2(pixel);
    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
}

float cloud_ray_jitter(ivec2 pixel) {
    int mode = int(params.sampling_options.x + 0.5);
    float strength = clamp(params.sampling_options.y, 0.0, 1.0);
    float jitter = 0.5;
    if (mode == CLOUD_SAMPLING_INTERLEAVED) {
        jitter = cloud_interleaved_gradient_noise(pixel);
    } else if (mode == CLOUD_SAMPLING_BAYER) {
        jitter = BAYER[(pixel.y & 3) * 4 + (pixel.x & 3)];
    } else if (mode == CLOUD_SAMPLING_OFF) {
        jitter = 0.5;
    }
    return mix(0.5, jitter, strength);
}

float cloud_height_fraction(vec3 position) {
    return (length(position - cloud_sphere_center()) - cloud_inner_radius()) /
           max(cloud_outer_radius() - cloud_inner_radius(), 0.001);
}

float cloud_density_gradient(float height_fraction, float cloud_type) {
    float stratus = 1.0 - clamp(cloud_type * 2.0, 0.0, 1.0);
    float stratocumulus = 1.0 - abs(cloud_type - 0.5) * 2.0;
    float cumulus = clamp(cloud_type - 0.5, 0.0, 1.0) * 2.0;
    vec4 gradient = stratus * STRATUS_GRADIENT +
                    stratocumulus * STRATOCUMULUS_GRADIENT +
                    cumulus * CUMULUS_GRADIENT;
    return smoothstep(gradient.x, gradient.y, height_fraction) -
           smoothstep(gradient.z, gradient.w, height_fraction);
}

vec2 cloud_project_uv(vec3 position) {
    return position.xz / cloud_inner_radius() + vec2(0.5);
}

DensitySample cloud_sample_density(vec3 position, bool expensive, float lod) {
    float height_fraction = cloud_height_fraction(position);
    if (height_fraction <= 0.0 || height_fraction >= 1.0) {
        return DensitySample(0.0, 0.0, 0.0, 0.0, height_fraction);
    }

    float crispiness = max(params.shape_options.x, 0.001);
    float curliness = max(params.shape_options.y, 0.001);
    vec3 animation =
        height_fraction * WIND_DIRECTION * CLOUD_TOP_OFFSET + WIND_DIRECTION * params.weather.w;
    vec2 shape_uv = cloud_project_uv(position);
    vec2 moving_shape_uv = cloud_project_uv(position + animation);

    vec4 low_frequency =
        textureLod(base_noise_texture, vec3(shape_uv * crispiness, height_fraction), lod);
    float low_fbm = dot(low_frequency.gba, vec3(0.625, 0.25, 0.125));
    float base_cloud =
        cloud_remap(low_frequency.r, -(1.0 - low_fbm), 1.0, 0.0, 1.0);

    float density_profile = cloud_density_gradient(height_fraction, 1.0);
    base_cloud *= density_profile / max(height_fraction, 0.0001);

    vec3 weather = texture(weather_texture, moving_shape_uv).rgb;
    float coverage = weather.r * params.weather.x;
    float base_with_coverage =
        cloud_remap(base_cloud, coverage, 1.0, 0.0, 1.0) * coverage;
    float detail_density = 0.0;

    if (expensive) {
        vec3 detail =
            textureLod(detail_noise_texture,
                       vec3(moving_shape_uv * crispiness, height_fraction) * curliness, lod)
                .rgb;
        float high_fbm = dot(detail, vec3(0.625, 0.25, 0.125));
        float high_modifier =
            mix(high_fbm, 1.0 - high_fbm, clamp(height_fraction * 10.0, 0.0, 1.0));
        detail_density = high_modifier;
        float erosion_strength = clamp(params.weather_feature_weights.w, 0.0, 1.0);
        float eroded = base_with_coverage -
                       high_modifier * (1.0 - base_with_coverage) * erosion_strength;
        float remapped =
            cloud_remap(eroded * 2.0, high_modifier * 0.2, 1.0, 0.0, 1.0);
        base_with_coverage = mix(base_with_coverage, remapped, erosion_strength);
    }

    float density = clamp(base_with_coverage, 0.0, 1.0);
    return DensitySample(density, clamp(base_cloud, 0.0, 1.0), detail_density, coverage,
                         height_fraction);
}

float cloud_light_transmittance(vec3 start, float step_size, vec3 light_dir,
                                    float original_density, float light_dot_eye) {
    int light_steps = clamp(int(params.ref_options.z + 0.5), 1, 6);
    float ds = step_size * 6.0;
    vec3 ray_step = light_dir * ds;
    float absorption = params.shape_options.z * 0.01;
    float sigma_ds = -ds * absorption;
    float transmittance = 1.0;
    float cone_radius = 1.0;
    float density_sum = 0.0;
    vec3 pos = start;

    for (int i = 0; i < 6; ++i) {
        if (i >= light_steps) {
            break;
        }
        vec3 cone_pos = pos + cone_radius * NOISE_KERNEL[i] * float(i);
        DensitySample sample_data = cloud_sample_density(cone_pos, density_sum > 0.3,
                                                             float(i / 16));
        if (sample_data.density > 0.0) {
            transmittance *= exp(sample_data.density * sigma_ds);
            density_sum += sample_data.density;
        }
        pos += ray_step;
        cone_radius += 1.0 / 6.0;
    }
    return transmittance;
}

vec3 cloud_local_up(vec3 position) {
    return normalize(position - cloud_sphere_center());
}

vec3 cloud_horizon_direction(vec3 direction, vec3 local_up) {
    vec3 horizon = direction - local_up * dot(direction, local_up);
    float horizon_len = length(horizon);
    if (horizon_len < 0.001) {
        return normalize(vec3(1.0, 0.0, 0.0));
    }
    return horizon / horizon_len;
}

vec3 cloud_cloud_ambient(vec3 position, vec3 direction, DensitySample sample_data) {
    vec3 local_up = cloud_local_up(position);
    vec3 sun_dir = normalize(params.sun_direction_intensity.xyz);
    float sun_elevation = dot(sun_dir, local_up);
    float day = smoothstep(-0.16, 0.10, sun_elevation) * params.sun_direction_intensity.w;
    float low_sun = 1.0 - smoothstep(0.05, 0.45, max(sun_elevation, 0.0));
    float height_fill = smoothstep(0.08, 0.92, sample_data.height_fraction);

    vec3 sky_top = cloud_sky_color(local_up);
    vec3 horizon_sky = cloud_sky_color(cloud_horizon_direction(direction, local_up));
    vec3 top_fill = params.cloud_color_top_shadow.rgb *
                    (0.36 + 0.46 * day + 0.32 * max(sun_elevation, 0.0));
    top_fill += sky_top * (0.12 + 0.12 * day);

    vec3 bottom_fill = params.cloud_color_bottom_horizon.rgb * (0.14 + 0.38 * day);
    vec3 horizon_fill = horizon_sky * params.cloud_color_bottom_horizon.w * (0.10 + 0.16 * day);
    vec3 twilight_fill = vec3(1.0, 0.48, 0.23) * low_sun * day * 0.18;

    vec3 ambient = mix(bottom_fill, top_fill, height_fill);
    ambient += horizon_fill * (0.55 + 0.45 * (1.0 - height_fill));
    ambient += twilight_fill * (1.0 - 0.35 * height_fill);
    return max(ambient, vec3(0.0));
}

float cloud_direct_phase(float cos_theta) {
    float forward = cloud_hg(cos_theta, 0.58) * 5.0;
    float backward = cloud_hg(cos_theta, -0.20) * 1.4;
    return clamp(0.64 + forward + backward, 0.55, 4.2);
}

float cloud_rim_phase(float cos_theta, float light_transmittance,
                          DensitySample sample_data) {
    float forward_rim = pow(max(cos_theta, 0.0), 7.0);
    float edge = 1.0 - smoothstep(0.16, 0.82, sample_data.density);
    float top_bias = smoothstep(0.18, 0.92, sample_data.height_fraction);
    return forward_rim * (0.30 + 0.70 * light_transmittance) *
           (0.45 + 0.55 * top_bias) * (0.55 + 0.45 * edge);
}

bool cloud_shell_segment(vec3 origin, vec3 direction, out float start_t, out float end_t) {
    float outer_near = 0.0;
    float outer_far = 0.0;
    if (!cloud_ray_sphere(origin, direction, cloud_outer_radius(), outer_near,
                              outer_far)) {
        start_t = 0.0;
        end_t = 0.0;
        return false;
    }

    float inner_near = 0.0;
    float inner_far = 0.0;
    bool inner_hit = cloud_ray_sphere(origin, direction, cloud_inner_radius(),
                                          inner_near, inner_far);

    float camera_radius = length(origin - cloud_sphere_center());
    start_t = max(outer_near, 0.0);
    end_t = outer_far;

    if (camera_radius < cloud_inner_radius()) {
        if (!inner_hit || inner_far <= 0.0) {
            return false;
        }
        start_t = max(start_t, inner_far);
    } else if (camera_radius < cloud_outer_radius()) {
        start_t = 0.0;
        if (inner_hit && inner_near > 0.0) {
            end_t = min(end_t, inner_near);
        }
    } else if (inner_hit && inner_near > start_t) {
        end_t = min(end_t, inner_near);
    }

    float ground_near = 0.0;
    float ground_far = 0.0;
    if (cloud_ray_sphere(origin, direction, cloud_planet_radius(), ground_near,
                             ground_far) &&
        ground_near > 0.0) {
        end_t = min(end_t, ground_near);
    }

    return end_t > start_t;
}

MarchResult cloud_march(vec3 origin, vec3 direction, float start_t, float end_t,
                            vec3 background, ivec2 pixel) {
    int max_steps = clamp(int(params.ref_options.y + 0.5), 1, 96);
    float length_km = max(end_t - start_t, 0.001);
    float ds = length_km / float(max_steps);
    vec3 step_vec = direction * ds;
    vec3 pos = origin + direction * (start_t + ds * cloud_ray_jitter(pixel));
    vec3 sun_dir = normalize(params.sun_direction_intensity.xyz);
    vec3 sun_color = vec3(1.20, 1.12, 0.92) * max(params.sun_direction_intensity.w, 0.0);
    float light_dot_eye = dot(sun_dir, direction);
    float density_factor = max(params.weather.y, 0.0);
    float sigma_ds = -ds * density_factor;
    float transmittance = 1.0;
    vec3 color = vec3(0.0);
    float density_sum = 0.0;
    float last_light = 1.0;
    float first_distance = -1.0;
    float weighted_distance_sum = 0.0;
    float distance_weight_sum = 0.0;
    float steps_taken = 0.0;
    vec3 ambient_sum = vec3(0.0);
    vec3 direct_sum = vec3(0.0);
    vec3 phase_sum = vec3(0.0);

    for (int i = 0; i < 96; ++i) {
        if (i >= max_steps) {
            break;
        }
        DensitySample sample_data = cloud_sample_density(pos, true, float(i / 16));
        if (sample_data.density > 0.0) {
            float sample_distance = length(pos - origin);
            if (first_distance < 0.0) {
                first_distance = sample_distance;
            }
            float light_transmittance =
                cloud_light_transmittance(pos, ds * 0.1, sun_dir, sample_data.density,
                                              light_dot_eye);
            vec3 local_up = cloud_local_up(pos);
            float sun_elevation = max(dot(sun_dir, local_up), 0.0);
            float day = smoothstep(-0.16, 0.10, dot(sun_dir, local_up)) *
                        params.sun_direction_intensity.w;
            float shadow_strength = clamp(params.cloud_color_top_shadow.w, 0.0, 1.0);
            float light_visibility = mix(1.0, light_transmittance, shadow_strength);
            float phase_response = cloud_direct_phase(light_dot_eye);
            float powder_term =
                params.shape_options.w > 0.5 ? (1.0 - exp(-3.5 * sample_data.density)) : 1.0;
            float powder_gain = mix(0.78, 1.42, powder_term);
            float body_scatter = (1.0 - light_visibility) *
                                 (1.0 - exp(-sample_data.density * 4.0));
            float rim_phase =
                cloud_rim_phase(light_dot_eye, light_transmittance, sample_data);
            vec3 ambient_source = cloud_cloud_ambient(pos, direction, sample_data) * 0.42 *
                                  params.lighting_strengths.x;
            vec3 direct_source =
                sun_color * light_visibility * phase_response * powder_gain *
                (0.24 + 0.58 * day + 0.30 * sun_elevation) *
                params.lighting_strengths.y;
            vec3 multi_source = sun_color * body_scatter * (0.08 + 0.24 * day) *
                                (0.45 + 0.55 * sample_data.height_fraction) *
                                params.lighting_strengths.y;
            vec3 phase_source = sun_color * rim_phase * (0.70 + 0.65 * day) *
                                params.lighting_strengths.z;
            vec3 source = (ambient_source + direct_source + multi_source + phase_source) *
                          sample_data.density;
            float d_transmittance = exp(sample_data.density * sigma_ds);
            vec3 integral = (source - source * d_transmittance) /
                            max(sample_data.density, 0.0001);
            color += transmittance * integral;
            ambient_sum += transmittance *
                           ((ambient_source * sample_data.density -
                             ambient_source * sample_data.density * d_transmittance) /
                            max(sample_data.density, 0.0001));
            direct_sum += transmittance *
                          (((direct_source + multi_source) * sample_data.density -
                            (direct_source + multi_source) * sample_data.density *
                                d_transmittance) /
                           max(sample_data.density, 0.0001));
            phase_sum += transmittance *
                         ((phase_source * sample_data.density -
                           phase_source * sample_data.density * d_transmittance) /
                          max(sample_data.density, 0.0001));
            transmittance *= d_transmittance;
            density_sum += sample_data.density;
            weighted_distance_sum += sample_distance * sample_data.density;
            distance_weight_sum += sample_data.density;
            last_light = light_transmittance;
        }
        if (transmittance <= 0.01) {
            break;
        }
        pos += step_vec;
        steps_taken += 1.0;
    }

    float alpha = 1.0 - transmittance;
    color = max(color * 1.95 - vec3(0.12 * alpha), vec3(0.0));
    ambient_sum = max(ambient_sum * 1.95, vec3(0.0));
    direct_sum = max(direct_sum * 1.95, vec3(0.0));
    phase_sum = max(phase_sum * 1.95, vec3(0.0));
    if (first_distance > 0.0) {
        float fog = 1.0 - exp(-first_distance * 0.00004 * params.cloud_color_bottom_horizon.w);
        color = mix(color, background * alpha, clamp(fog, 0.0, 1.0));
    }
    float mean_distance = distance_weight_sum > 0.0
                              ? weighted_distance_sum / max(distance_weight_sum, 0.0001)
                              : -1.0;
    return MarchResult(color, transmittance, alpha, density_sum / float(max_steps), last_light,
                       first_distance, mean_distance, steps_taken, ambient_sum, direct_sum,
                       phase_sum);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloud_product);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec2 position = uv * 2.0 - 1.0;
    vec3 origin = params.camera_position_radius.xyz;
    vec3 direction = cloud_view_direction(position);
    vec3 background = cloud_background(direction);
    int debug_view = int(params.ref_options.x + 0.5);

    float start_t = 0.0;
    float end_t = 0.0;
    bool has_segment = cloud_shell_segment(origin, direction, start_t, end_t);
    if (!has_segment) {
        vec3 debug_color = debug_view == CLOUD_DEBUG_BACKGROUND ? background : vec3(0.0);
        imageStore(cloud_product, pixel,
                   vec4(debug_view == CLOUD_DEBUG_FINAL ? vec3(0.0) : debug_color, 1.0));
        imageStore(cloud_metadata, pixel, vec4(0.0));
        return;
    }

    MarchResult result = cloud_march(origin, direction, start_t, end_t, background, pixel);
    vec3 debug_color = result.radiance;
    float debug_alpha = 1.0;

    if (debug_view == CLOUD_DEBUG_WEATHER ||
        debug_view == CLOUD_DEBUG_BASE_DENSITY ||
        debug_view == CLOUD_DEBUG_DETAIL_DENSITY ||
        debug_view == CLOUD_DEBUG_DENSITY) {
        vec3 mid = origin + direction * mix(start_t, end_t, 0.5);
        DensitySample sample_data = cloud_sample_density(mid, true, 0.0);
        if (debug_view == CLOUD_DEBUG_WEATHER) {
            debug_color = vec3(sample_data.weather);
        } else if (debug_view == CLOUD_DEBUG_BASE_DENSITY) {
            debug_color = vec3(sample_data.base_density);
        } else if (debug_view == CLOUD_DEBUG_DETAIL_DENSITY) {
            debug_color = vec3(sample_data.detail_density);
        } else {
            debug_color = vec3(sample_data.density);
        }
    } else if (debug_view == CLOUD_DEBUG_TRANSMITTANCE) {
        debug_color = vec3(result.transmittance);
    } else if (debug_view == CLOUD_DEBUG_LIGHTING) {
        debug_color = result.ambient_light + result.direct_light + result.phase_light;
    } else if (debug_view == CLOUD_DEBUG_AMBIENT_LIGHT) {
        debug_color = result.ambient_light;
    } else if (debug_view == CLOUD_DEBUG_DIRECT_LIGHT) {
        debug_color = result.direct_light;
    } else if (debug_view == CLOUD_DEBUG_PHASE_LIGHT) {
        debug_color = result.phase_light;
    } else if (debug_view == CLOUD_DEBUG_SHADOW) {
        debug_color = vec3(1.0 - result.last_light);
    } else if (debug_view == CLOUD_DEBUG_STEPS) {
        debug_color = vec3(result.steps / max(params.ref_options.y, 1.0));
    } else if (debug_view == CLOUD_DEBUG_BACKGROUND) {
        debug_color = background;
    } else if (debug_view == CLOUD_DEBUG_CLOUD_ALPHA) {
        debug_color = vec3(result.alpha);
    } else if (debug_view == CLOUD_DEBUG_DISTANCE) {
        debug_color = vec3(clamp(result.mean_distance / 500.0, 0.0, 1.0));
    } else if (debug_view == CLOUD_DEBUG_FINAL ||
               debug_view == CLOUD_DEBUG_RAW_FINAL) {
        debug_alpha = result.transmittance;
    }

    imageStore(cloud_product, pixel,
               vec4(max(debug_color, vec3(0.0)), debug_alpha));
    float confidence = result.alpha > 0.001 ? clamp(result.steps / max(params.ref_options.y, 1.0),
                                                    0.0, 1.0)
                                            : 0.0;
    imageStore(cloud_metadata, pixel,
               vec4(max(result.mean_distance, 0.0), result.alpha, confidence,
                    result.avg_density));
}
