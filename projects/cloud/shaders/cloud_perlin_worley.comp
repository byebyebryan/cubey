#version 450
#extension GL_GOOGLE_include_directive : require

// TerrainEngine-OpenGL reference port.
// Fills the base 3D texture with Perlin-Worley and packed Worley FBM channels.

#include "cloud_noise_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba8, set = 0, binding = 0) uniform writeonly image3D out_volume;

vec4 cloud_stackable_base_noise(ivec3 pixel) {
    vec3 coord = vec3(float(pixel.x) / 128.0, float(pixel.y) / 128.0,
                     float(pixel.z) / 128.0);

    float perlin_noise = cloud_perlin_noise_3d(coord, 8.0, 3);

    float perlin_worley_noise = 0.0;
    {
        float cell_count = 4.0;
        float worley0 =
            1.0 - cloud_worley_noise_3d(coord, cell_count * kCloudFrequencyMul[0]);
        float worley1 =
            1.0 - cloud_worley_noise_3d(coord, cell_count * kCloudFrequencyMul[1]);
        float worley2 =
            1.0 - cloud_worley_noise_3d(coord, cell_count * kCloudFrequencyMul[2]);
        float worley_fbm = worley0 * 0.625 + worley1 * 0.25 + worley2 * 0.125;
        perlin_worley_noise = cloud_remap(perlin_noise, 0.0, 1.0, worley_fbm, 1.0);
    }

    float cell_count = 4.0;
    float worley0 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 1.0);
    float worley1 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 2.0);
    float worley2 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 4.0);
    float worley3 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 8.0);
    float worley4 = 1.0 - cloud_worley_noise_3d(coord, cell_count * 16.0);

    float worley_fbm0 = worley1 * 0.625 + worley2 * 0.25 + worley3 * 0.125;
    float worley_fbm1 = worley2 * 0.625 + worley3 * 0.25 + worley4 * 0.125;
    float worley_fbm2 = worley3 * 0.75 + worley4 * 0.25;
    return vec4(perlin_worley_noise * perlin_worley_noise, worley_fbm0, worley_fbm1,
                worley_fbm2);
}

void main() {
    ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(out_volume);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    imageStore(out_volume, pixel, cloud_stackable_base_noise(pixel));
}
