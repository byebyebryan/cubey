#version 450

layout(local_size_x = 8, local_size_y = 8) in;

struct Cell {
    vec4 dye;
    vec4 velocity;
};

struct Injector {
    vec4 position_radius_strength;
    vec4 velocity_carry_propulsion;
    vec4 dye_active;
};

layout(set = 0, binding = 0, std430) readonly buffer SourceField {
    Cell cells[];
} source_field;

layout(set = 0, binding = 1, std430) buffer DestinationField {
    Cell cells[];
} destination_field;

layout(set = 0, binding = 2, std430) readonly buffer ObstacleField {
    float values[];
} obstacle_field;

layout(set = 0, binding = 3, std430) readonly buffer InjectorField {
    Injector injectors[];
} injector_field;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_options;
    vec4 solver_options;
} params;

void apply_source(inout Cell cell, vec2 uv, vec2 center, float radius, float strength, vec3 dye,
                  vec2 force, float source_active, float dt) {
    vec2 to_injection = uv - center;
    float safe_radius = max(radius, 0.0001);
    float splat = exp(-dot(to_injection, to_injection) / (safe_radius * safe_radius));
    float source = splat * strength * source_active * dt;
    cell.dye.rgb += dye * source;
    cell.velocity.xy += force * source;
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    Cell cell = source_field.cells[index];
    if (obstacle_field.values[index] > 0.5) {
        cell.dye = vec4(0.0);
        cell.velocity = vec4(0.0);
        destination_field.cells[index] = cell;
        return;
    }

    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(width, height);
    float dt = params.grid_dt_time.z;
    uint procedural_count = uint(max(params.solver_options.w, 0.0));

    for (uint i = 0; i < procedural_count; ++i) {
        Injector injector = injector_field.injectors[i];
        vec2 injector_velocity = injector.velocity_carry_propulsion.xy;
        float injector_speed = length(injector_velocity);
        vec2 injector_direction =
            injector_speed > 0.00001 ? injector_velocity / injector_speed : vec2(0.0);
        vec2 carry_velocity = injector_velocity * injector.velocity_carry_propulsion.z;
        vec2 propulsion_force = -injector_direction * injector.velocity_carry_propulsion.w;
        apply_source(cell, uv, injector.position_radius_strength.xy,
                     injector.position_radius_strength.z, injector.position_radius_strength.w,
                     max(injector.dye_active.rgb, vec3(0.0)), carry_velocity + propulsion_force,
                     clamp(injector.dye_active.w, 0.0, 1.0), dt);
    }

    cell.dye.a = 1.0;

    destination_field.cells[index] = cell;
}
