#version 450
#extension GL_GOOGLE_include_directive : require

#include "cubey/color_space.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

struct Cell {
    vec4 dye;
    vec4 velocity;
};

layout(set = 0, binding = 0, std430) readonly buffer SourceField {
    Cell cells[];
} source_field;

layout(set = 0, binding = 1, std430) buffer DestinationField {
    Cell cells[];
} destination_field;

layout(set = 0, binding = 2, std430) readonly buffer ObstacleField {
    float values[];
} obstacle_field;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 injection_xy_radius_strength;
    vec4 injection_dye_active;
    vec4 force_decay;
    vec4 solver_options;
} params;

void apply_source(inout Cell cell, vec2 uv, vec2 center, float radius, float strength, vec3 dye,
                  vec2 force, float source_active, float dt) {
    vec2 to_injection = uv - center;
    float safe_radius = max(radius, 0.0001);
    float splat = exp(-dot(to_injection, to_injection) / (safe_radius * safe_radius));
    float source = splat * strength * source_active * dt;
    cell.dye.rgb += dye * source;
    cell.velocity.xy += force * splat * source_active * dt;
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    Cell cell = source_field.cells[index];
    if (obstacle_field.values[index] > 0.5) {
        cell.dye = vec4(0.0);
        cell.velocity = vec4(0.0);
        destination_field.cells[index] = cell;
        return;
    }

    vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(width, height);
    float dt = params.grid_dt_time.z;
    float time = params.grid_dt_time.w;
    float procedural_radius = params.solver_options.y;
    float procedural_strength = params.solver_options.z;
    uint procedural_count = uint(max(params.solver_options.w, 0.0));

    apply_source(cell, uv, params.injection_xy_radius_strength.xy,
                 params.injection_xy_radius_strength.z, params.injection_xy_radius_strength.w,
                 max(params.injection_dye_active.rgb, vec3(0.0)), params.force_decay.xy,
                 clamp(params.injection_dye_active.w, 0.0, 1.0), dt);

    for (uint i = 0; i < procedural_count; ++i) {
        const float tau = 6.28318530718;
        float source_index = float(i);
        float source_count = max(float(procedural_count), 1.0);
        float hue = source_index / source_count;
        float base_angle = hue * tau;
        bool inner_ring = procedural_count > 4U && (i % 2U) == 1U;
        float direction = inner_ring ? -1.0 : 1.0;
        float ring_radius = inner_ring ? 0.18 : 0.29;
        float orbit_speed = inner_ring ? 0.22 : 0.16;
        float angle = base_angle + (direction * time * orbit_speed);
        float radius_breath = 0.018 * sin((time * 0.42) + (base_angle * 2.0));
        vec2 radial = vec2(cos(angle), sin(angle));
        vec2 tangent = direction * vec2(-radial.y, radial.x);
        vec2 center = vec2(0.5) + radial * (ring_radius + radius_breath);
        float force_scale = inner_ring ? 1.70 : 2.05;
        vec2 force = (tangent * force_scale) +
                     (radial * (0.28 * sin((time * 0.54) + base_angle)));
        float radius_scale = inner_ring ? 0.92 : 0.84;
        float strength_scale = inner_ring ? 0.90 : 0.84;
        vec3 dye = cubey_hsv_to_linear(vec3(hue, 1.0, 1.0));
        apply_source(cell, uv, center, procedural_radius * radius_scale,
                     procedural_strength * strength_scale, dye, force, 1.0, dt);
    }

    cell.dye.a = 1.0;

    destination_field.cells[index] = cell;
}
