#version 450

layout(local_size_x = 8, local_size_y = 8) in;

struct Cell {
    vec4 dye;
    vec4 velocity;
};

layout(set = 0, binding = 0, std430) buffer Field {
    Cell cells[];
} field;

layout(set = 0, binding = 1, std430) readonly buffer CurlField {
    float values[];
} curl;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 injection_xy_radius_strength;
    vec4 injection_dye_active;
    vec4 force_decay;
    vec4 solver_options;
} params;

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    Cell cell = field.cells[index];
    if (x == 0 || y == 0 || x + 1 >= width || y + 1 >= height) {
        cell.velocity.xy = vec2(0.0);
        field.cells[index] = cell;
        return;
    }

    ivec2 coord = ivec2(int(x), int(y));
    float center = curl.values[index];
    float left = abs(curl.values[cell_index(coord + ivec2(-1, 0), width, height)]);
    float right = abs(curl.values[cell_index(coord + ivec2(1, 0), width, height)]);
    float down = abs(curl.values[cell_index(coord + ivec2(0, -1), width, height)]);
    float up = abs(curl.values[cell_index(coord + ivec2(0, 1), width, height)]);
    vec2 gradient = vec2(right - left, up - down) * 0.5;
    float gradient_length = length(gradient);
    if (gradient_length > 0.00001) {
        vec2 direction = gradient / gradient_length;
        vec2 force = vec2(direction.y, -direction.x) * center * params.solver_options.x;
        cell.velocity.xy += force * params.grid_dt_time.z;
    }
    cell.velocity.xy = clamp(cell.velocity.xy, vec2(-12.0), vec2(12.0));
    cell.velocity.zw = vec2(0.0);
    field.cells[index] = cell;
}
