#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer DivergenceField {
    float values[];
} divergence;

layout(set = 0, binding = 1, std430) readonly buffer SourcePressureField {
    float values[];
} source_pressure;

layout(set = 0, binding = 2, std430) buffer DestinationPressureField {
    float values[];
} destination_pressure;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 injection_xy_radius_strength;
    vec4 injection_dye_active;
    vec4 force_decay;
} params;

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    if (x == 0 || y == 0 || x + 1 >= width || y + 1 >= height) {
        destination_pressure.values[index] = 0.0;
        return;
    }

    ivec2 coord = ivec2(int(x), int(y));
    float left = source_pressure.values[cell_index(coord + ivec2(-1, 0), width, height)];
    float right = source_pressure.values[cell_index(coord + ivec2(1, 0), width, height)];
    float down = source_pressure.values[cell_index(coord + ivec2(0, -1), width, height)];
    float up = source_pressure.values[cell_index(coord + ivec2(0, 1), width, height)];
    float div = divergence.values[index];
    destination_pressure.values[index] = (left + right + down + up - div) * 0.25;
}
