#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D output_tile;

layout(push_constant) uniform TerrainMaterialTilePushConstants {
    uint seed;
    uint material;
} pc;

const float terrain_tile_tau = 6.28318530718;

float terrain_tile_hash(uint value) {
    value ^= value >> 16U;
    value *= 0x7feb352dU;
    value ^= value >> 15U;
    value *= 0x846ca68bU;
    value ^= value >> 16U;
    return float(value & 0x00ffffffU) / float(0x01000000U);
}

float terrain_tile_lattice(ivec2 cell, int period, uint salt) {
    ivec2 wrapped = ivec2((cell.x % period + period) % period,
                          (cell.y % period + period) % period);
    uint combined = uint(wrapped.x) * 0x9e3779b9U ^ uint(wrapped.y) * 0x85ebca6bU ^
        pc.seed ^ salt * 0xc2b2ae35U;
    return terrain_tile_hash(combined) * 2.0 - 1.0;
}

float terrain_tile_noise(vec2 uv, int cycles, uint salt) {
    vec2 position = uv * float(cycles);
    ivec2 cell = ivec2(floor(position));
    vec2 blend = fract(position);
    blend = blend * blend * (3.0 - 2.0 * blend);
    float a = terrain_tile_lattice(cell, cycles, salt);
    float b = terrain_tile_lattice(cell + ivec2(1, 0), cycles, salt);
    float c = terrain_tile_lattice(cell + ivec2(0, 1), cycles, salt);
    float d = terrain_tile_lattice(cell + ivec2(1, 1), cycles, salt);
    return mix(mix(a, b, blend.x), mix(c, d, blend.x), blend.y);
}

float terrain_tile_relief(vec2 uv) {
    float material = float(pc.material);
    float relief = 0.30 * terrain_tile_noise(uv, 4, 1U + pc.material * 13U);
    relief += 0.24 * terrain_tile_noise(uv, 10, 2U + pc.material * 17U);
    relief += 0.18 * terrain_tile_noise(uv, 32, 3U + pc.material * 19U);
    relief += 0.12 * terrain_tile_noise(uv, 128, 5U + pc.material * 23U);
    relief += 0.08 * terrain_tile_noise(uv, 512, 7U + pc.material * 29U);
    relief += 0.04 * terrain_tile_noise(uv, 1024, 11U + pc.material * 31U);
    if (pc.material == 2U) {
        relief += 0.18 * sin(terrain_tile_tau * (uv.y * 22.0 +
            terrain_tile_noise(uv, 4, 41U) * 0.35));
    } else if (pc.material == 3U) {
        relief *= 0.42;
    } else if (pc.material == 0U) {
        relief *= 0.62;
    }
    return relief * (0.92 + material * 0.08);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(output_tile);
    if (any(greaterThanEqual(texel, extent))) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(extent);
    vec2 step_uv = 1.0 / vec2(extent);
    float center = terrain_tile_relief(uv);
    vec2 gradient = vec2(
        terrain_tile_relief(fract(uv + vec2(step_uv.x, 0.0))) - center,
        terrain_tile_relief(fract(uv + vec2(0.0, step_uv.y))) - center);
    vec2 encoded_normal = clamp(gradient * vec2(extent) * 0.025, -1.0, 1.0) * 0.5 + 0.5;
    float variation = clamp(0.5 +
        terrain_tile_noise(uv, 32, 47U + pc.material) * 0.16 +
        terrain_tile_noise(uv, 128, 53U + pc.material) * 0.09 +
        terrain_tile_noise(uv, 512, 59U + pc.material) * 0.04, 0.0, 1.0);
    const float roughness[4] = float[4](0.94, 0.90, 0.76, 0.86);
    float local_roughness = clamp(roughness[pc.material] + (variation - 0.5) * 0.12, 0.0, 1.0);
    imageStore(output_tile, texel,
        vec4(encoded_normal, variation, local_roughness));
}
