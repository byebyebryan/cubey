#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
} params;

struct Injector {
    vec4 position_radius;
    vec4 velocity_strength;
    vec4 color_active;
};

layout(rgba32f, set = 0, binding = 0) uniform readonly image3D density_in;
layout(rgba32f, set = 0, binding = 1) uniform readonly image3D velocity_in;
layout(rgba32f, set = 0, binding = 2) uniform writeonly image3D density_out;
layout(rgba32f, set = 0, binding = 3) uniform writeonly image3D velocity_out;
layout(set = 0, binding = 4, std430) readonly buffer Fluid3DInjectors {
    Injector injectors[];
};

vec4 load_density(ivec3 coord) {
    ivec3 max_coord = imageSize(density_in) - ivec3(1);
    return imageLoad(density_in, clamp(coord, ivec3(0), max_coord));
}

vec4 load_velocity(ivec3 coord) {
    ivec3 max_coord = imageSize(velocity_in) - ivec3(1);
    return imageLoad(velocity_in, clamp(coord, ivec3(0), max_coord));
}

vec4 sample_density(vec3 uv) {
    vec3 size = vec3(imageSize(density_in));
    vec3 position = clamp(uv, vec3(0.0), vec3(1.0)) * size - vec3(0.5);
    ivec3 base = ivec3(floor(position));
    vec3 fraction = fract(position);
    vec4 c000 = load_density(base);
    vec4 c100 = load_density(base + ivec3(1, 0, 0));
    vec4 c010 = load_density(base + ivec3(0, 1, 0));
    vec4 c110 = load_density(base + ivec3(1, 1, 0));
    vec4 c001 = load_density(base + ivec3(0, 0, 1));
    vec4 c101 = load_density(base + ivec3(1, 0, 1));
    vec4 c011 = load_density(base + ivec3(0, 1, 1));
    vec4 c111 = load_density(base + ivec3(1, 1, 1));
    vec4 z0 = mix(mix(c000, c100, fraction.x), mix(c010, c110, fraction.x), fraction.y);
    vec4 z1 = mix(mix(c001, c101, fraction.x), mix(c011, c111, fraction.x), fraction.y);
    return mix(z0, z1, fraction.z);
}

vec4 sample_velocity(vec3 uv) {
    vec3 size = vec3(imageSize(velocity_in));
    vec3 position = clamp(uv, vec3(0.0), vec3(1.0)) * size - vec3(0.5);
    ivec3 base = ivec3(floor(position));
    vec3 fraction = fract(position);
    vec4 c000 = load_velocity(base);
    vec4 c100 = load_velocity(base + ivec3(1, 0, 0));
    vec4 c010 = load_velocity(base + ivec3(0, 1, 0));
    vec4 c110 = load_velocity(base + ivec3(1, 1, 0));
    vec4 c001 = load_velocity(base + ivec3(0, 0, 1));
    vec4 c101 = load_velocity(base + ivec3(1, 0, 1));
    vec4 c011 = load_velocity(base + ivec3(0, 1, 1));
    vec4 c111 = load_velocity(base + ivec3(1, 1, 1));
    vec4 z0 = mix(mix(c000, c100, fraction.x), mix(c010, c110, fraction.x), fraction.y);
    vec4 z1 = mix(mix(c001, c101, fraction.x), mix(c011, c111, fraction.x), fraction.y);
    return mix(z0, z1, fraction.z);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = ivec3(params.grid_dt_time.xyz);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }

    float dt = params.grid_dt_time.w;
    vec3 uv = (vec3(coord) + vec3(0.5)) / vec3(size);
    vec3 velocity = imageLoad(velocity_in, coord).xyz;
    vec3 previous_uv = uv - velocity * dt;
    vec4 density = sample_density(previous_uv) * pow(params.decay_force.x, dt);
    vec3 advected_velocity = sample_velocity(previous_uv).xyz * pow(params.decay_force.y, dt);

    int injector_count = int(params.options.x + 0.5);
    for (int i = 0; i < injector_count; ++i) {
        Injector injector = injectors[i];
        if (injector.color_active.w <= 0.0) {
            continue;
        }
        vec3 delta = uv - injector.position_radius.xyz;
        float radius = max(injector.position_radius.w, 0.0001);
        float falloff = exp(-dot(delta, delta) / (radius * radius));
        float impulse = injector.velocity_strength.w * dt * falloff;
        density.rgb += injector.color_active.rgb * impulse * 0.55;
        density.a += impulse * 0.22;
        advected_velocity += injector.velocity_strength.xyz * impulse * 0.42;
    }

    float edge_distance = min(min(uv.x, 1.0 - uv.x), min(min(uv.y, 1.0 - uv.y), min(uv.z, 1.0 - uv.z)));
    float wall = smoothstep(0.0, 0.035, edge_distance);
    imageStore(density_out, coord, vec4(clamp(density.rgb, vec3(0.0), vec3(8.0)),
                                        clamp(density.a, 0.0, 8.0)));
    imageStore(velocity_out, coord, vec4(advected_velocity * wall, 0.0));
}
