#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
    vec4 shadow_options;
    vec4 fire_options;
    vec4 shaping_options;
} params;

struct Source {
    vec4 position_radius;
    vec4 velocity_strength;
    vec4 material_amount;
};

layout(rgba16f, set = 0, binding = 0) uniform readonly image3D material_in;
layout(rgba16f, set = 0, binding = 1) uniform readonly image3D velocity_in;
layout(rgba16f, set = 0, binding = 2) uniform writeonly image3D material_out;
layout(rgba16f, set = 0, binding = 3) uniform writeonly image3D velocity_out;
layout(set = 0, binding = 4, std430) readonly buffer Fluid3DSources { Source sources[]; };

vec4 material_at(ivec3 coord) {
    ivec3 max_coord = imageSize(material_in) - ivec3(1);
    return imageLoad(material_in, clamp(coord, ivec3(0), max_coord));
}

float hash31(vec3 value) {
    return fract(sin(dot(value, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

float source_noise(vec3 value) {
    vec3 cell = floor(value);
    vec3 f = fract(value);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = hash31(cell + vec3(0.0, 0.0, 0.0));
    float n100 = hash31(cell + vec3(1.0, 0.0, 0.0));
    float n010 = hash31(cell + vec3(0.0, 1.0, 0.0));
    float n110 = hash31(cell + vec3(1.0, 1.0, 0.0));
    float n001 = hash31(cell + vec3(0.0, 0.0, 1.0));
    float n101 = hash31(cell + vec3(1.0, 0.0, 1.0));
    float n011 = hash31(cell + vec3(0.0, 1.0, 1.0));
    float n111 = hash31(cell + vec3(1.0, 1.0, 1.0));

    float z0 = mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y);
    float z1 = mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y);
    return mix(z0, z1, f.z);
}

vec3 source_turbulence(vec3 uv, float source_index, float time) {
    vec3 coord = uv * 18.0 + vec3(source_index * 3.71, time * 0.65, -time * 0.45);
    return vec3(source_noise(coord), source_noise(coord + vec3(17.0)),
                source_noise(coord + vec3(31.0))) *
               2.0 -
           vec3(1.0);
}

vec3 temperature_gradient(ivec3 coord) {
    return vec3(material_at(coord + ivec3(1, 0, 0)).g -
                    material_at(coord - ivec3(1, 0, 0)).g,
                material_at(coord + ivec3(0, 1, 0)).g -
                    material_at(coord - ivec3(0, 1, 0)).g,
                material_at(coord + ivec3(0, 0, 1)).g -
                    material_at(coord - ivec3(0, 0, 1)).g) *
           0.5;
}

vec3 flame_shredding_force(ivec3 coord, vec3 uv, vec4 material, float time) {
    vec3 gradient = temperature_gradient(coord);
    float gradient_strength = length(gradient);
    if (gradient_strength <= 0.0001) {
        return vec3(0.0);
    }

    vec3 normal = gradient / gradient_strength;
    vec3 noise = source_turbulence(uv * 1.7 + vec3(0.0, time * 0.025, 0.0), 11.0, time);
    vec3 tangent = noise - normal * dot(noise, normal);
    float tangent_strength = length(tangent);
    if (tangent_strength <= 0.0001) {
        return vec3(0.0);
    }

    float flame_signal = smoothstep(0.020, 0.45, material.b);
    float temperature_signal = smoothstep(0.020, 0.70, material.g);
    float edge_signal =
        clamp(gradient_strength * 16.0, 0.0, 1.0) * flame_signal * temperature_signal;
    return tangent / tangent_strength * edge_signal;
}

void apply_sources(vec3 uv, float dt, bool fire_scenario, inout vec4 material,
                   inout vec3 velocity) {
    int source_count = int(params.options.x + 0.5);
    for (int i = 0; i < source_count; ++i) {
        Source source = sources[i];
        vec4 material_amount = max(source.material_amount, vec4(0.0));
        float velocity_strength = max(source.velocity_strength.w, 0.0);
        if (dot(material_amount, vec4(1.0)) <= 0.0 && velocity_strength <= 0.0) {
            continue;
        }

        float fuel_weight = fire_scenario ? smoothstep(0.01, 0.25, material_amount.a) : 0.0;
        float radius = max(source.position_radius.w, 0.0001);
        vec3 warp =
            source_turbulence(uv, float(i), params.options.w) * radius * 0.20 * fuel_weight;
        vec3 delta = (uv + warp) - source.position_radius.xyz;
        float falloff = exp(-dot(delta, delta) / (radius * radius));
        float breakup = mix(
            1.0,
            0.86 +
                0.28 * source_noise(uv * 36.0 + vec3(float(i) * 5.13, params.options.w * 0.90,
                                                     -params.options.w * 0.60)),
            fuel_weight);
        falloff *= breakup;

        float source_scale = dt * falloff;
        material.r += material_amount.r * source_scale * (fire_scenario ? 0.34 : 0.46);
        material.g += material_amount.g * source_scale * (fire_scenario ? 0.48 : 0.34);
        material.b += material_amount.b * source_scale * (fire_scenario ? 0.25 : 0.58);
        material.a += material_amount.a * source_scale * 0.64;
        velocity += source.velocity_strength.xyz * velocity_strength * source_scale * 0.42;
    }
}

void apply_combustion(float dt, inout vec4 material) {
    float ignition_temperature = max(params.fire_options.x, 0.0001);
    float burn_rate = max(params.fire_options.y, 0.0);
    float heat_output = max(params.fire_options.z, 0.0);
    float soot_yield = max(params.fire_options.w, 0.0);
    float flame_cooling = max(params.shaping_options.y, 0.0);

    float fuel = max(material.a, 0.0);
    float temperature = max(material.g, 0.0);
    float ignition_mask =
        smoothstep(ignition_temperature * 0.70, ignition_temperature * 1.35, temperature);
    float fuel_mask = smoothstep(0.010, 0.16, fuel);
    float burn_fraction = 1.0 - exp(-burn_rate * dt);
    float burned = min(fuel, fuel * burn_fraction * ignition_mask * fuel_mask);
    material.a = fuel - burned;
    material.g += burned * heat_output;
    material.b += burned * 4.8;
    material.r += burned * soot_yield;

    float flame_decay = exp(-flame_cooling * dt);
    float spent_flame = material.b * (1.0 - flame_decay);
    material.b *= flame_decay;
    material.r += spent_flame * 0.035;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = ivec3(params.grid_dt_time.xyz);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }

    float dt = params.grid_dt_time.w;
    vec3 uv = (vec3(coord) + vec3(0.5)) / vec3(size);
    vec4 material = imageLoad(material_in, coord);
    vec3 velocity = imageLoad(velocity_in, coord).xyz;
    bool fire_scenario = int(params.shadow_options.w + 0.5) == 2;

    apply_sources(uv, dt, fire_scenario, material, velocity);
    if (fire_scenario) {
        apply_combustion(dt, material);
        float flame_mask = smoothstep(0.020, 0.55, material.b);
        vec3 turbulence = source_turbulence(uv * 1.3, 19.0, params.options.w);
        velocity += turbulence * flame_mask * params.shaping_options.w * dt;
        velocity += flame_shredding_force(coord, uv, material, params.options.w) *
                    params.shaping_options.z * dt;
    }

    float buoyancy_energy = material.r * 0.35 + material.g * 0.80 + material.b * 0.35;
    vec3 buoyancy_force = vec3(0.0, params.shadow_options.z * buoyancy_energy, 0.0);
    velocity += buoyancy_force * dt;

    float edge_distance = min(min(uv.x, 1.0 - uv.x),
                              min(min(uv.y, 1.0 - uv.y), min(uv.z, 1.0 - uv.z)));
    float wall = smoothstep(0.0, 0.040, edge_distance);
    material *= wall;
    velocity *= wall;

    imageStore(material_out, coord, vec4(clamp(material.rgb, vec3(0.0), vec3(8.0)),
                                         clamp(material.a, 0.0, 8.0)));
    imageStore(velocity_out, coord, vec4(clamp(velocity, vec3(-6.0), vec3(6.0)), 0.0));
}
