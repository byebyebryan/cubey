#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
} params;

layout(rgba16f, set = 0, binding = 0) uniform readonly image3D velocity_volume;
layout(r32f, set = 0, binding = 1) uniform writeonly image3D divergence_volume;

vec3 velocity_at(ivec3 coord) {
    ivec3 max_coord = imageSize(velocity_volume) - ivec3(1);
    return imageLoad(velocity_volume, clamp(coord, ivec3(0), max_coord)).xyz;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = ivec3(params.grid_dt_time.xyz);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }

    float divergence = 0.5 * (
        velocity_at(coord + ivec3(1, 0, 0)).x - velocity_at(coord - ivec3(1, 0, 0)).x +
        velocity_at(coord + ivec3(0, 1, 0)).y - velocity_at(coord - ivec3(0, 1, 0)).y +
        velocity_at(coord + ivec3(0, 0, 1)).z - velocity_at(coord - ivec3(0, 0, 1)).z);
    imageStore(divergence_volume, coord, vec4(divergence, 0.0, 0.0, 0.0));
}
