#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) readonly uniform image2D h0_image;
layout(rgba32f, set = 0, binding = 1) writeonly uniform image2D height_dx_spectrum_image;
layout(rgba32f, set = 0, binding = 2) writeonly uniform image2D dz_slope_x_spectrum_image;
layout(rgba32f, set = 0, binding = 3) writeonly uniform image2D slope_z_curvature_spectrum_image;

layout(push_constant) uniform SpectrumParams {
    vec4 ocean_options;
    vec4 cascade_options;
    vec4 wind_options;
    vec4 seed_options;
} params;

const float PI = 3.14159265359;
const float G = 9.81;

vec2 complex_mul(vec2 lhs, vec2 rhs) {
    return vec2((lhs.x * rhs.x) - (lhs.y * rhs.y), (lhs.x * rhs.y) + (lhs.y * rhs.x));
}

int signed_frequency(int value, int size) {
    return value <= size / 2 ? value : value - size;
}

vec2 wave_vector(ivec2 texel, int size, float patch_length) {
    return (2.0 * PI / patch_length) *
           vec2(float(signed_frequency(texel.x, size)), float(signed_frequency(texel.y, size)));
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(height_dx_spectrum_image);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec4 h0 = imageLoad(h0_image, texel);
    vec2 k = wave_vector(texel, size.x, params.cascade_options.x);
    float omega = sqrt(G * length(k));
    float phase_angle = omega * params.ocean_options.y * max(params.wind_options.z, 0.0);
    vec2 phase = vec2(cos(phase_angle), sin(phase_angle));
    vec2 height = complex_mul(h0.xy, phase) + complex_mul(vec2(h0.z, -h0.w), vec2(phase.x, -phase.y));
    float k_len = max(length(k), 0.00001);
    vec2 negative_i_height = vec2(height.y, -height.x);
    vec2 positive_i_height = vec2(-height.y, height.x);
    vec2 horizontal_x = negative_i_height * (k.x / k_len);
    vec2 horizontal_z = negative_i_height * (k.y / k_len);
    vec2 slope_x = positive_i_height * k.x;
    vec2 slope_z = positive_i_height * k.y;
    vec2 curvature = -height * k_len * k_len;
    imageStore(height_dx_spectrum_image, texel, vec4(height, horizontal_x));
    imageStore(dz_slope_x_spectrum_image, texel, vec4(horizontal_z, slope_x));
    imageStore(slope_z_curvature_spectrum_image, texel, vec4(slope_z, curvature));
}
