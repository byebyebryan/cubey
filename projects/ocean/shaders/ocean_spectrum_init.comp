#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) writeonly uniform image2D h0_image;

layout(push_constant) uniform SpectrumParams {
    vec4 ocean_options;
    vec4 cascade_options;
    vec4 wind_options;
    vec4 seed_options;
} params;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(h0_image);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }
    imageStore(h0_image, texel, vec4(0.0));
}
