#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, set = 0, binding = 0) readonly uniform image2D base_normal_foam_image;
layout(rgba32f, set = 0, binding = 1) writeonly uniform image2D detail_normal_foam_image;

layout(push_constant) uniform DetailParams {
    vec4 ocean_options;
    vec4 cascade_options;
    vec4 wind_options;
    vec4 foam_options;
    vec4 foam_shaping_options;
} params;

const float PI = 3.14159265359;
const float G = 9.81;

float hash12(vec2 value) {
    vec3 p = fract(vec3(value.xyx) * vec3(443.8975, 397.2973, 491.1871));
    p += dot(p, p.yzx + 19.19);
    return fract((p.x + p.y) * p.z);
}

float value_noise(vec2 value) {
    vec2 cell = floor(value);
    vec2 local = smoothstep(vec2(0.0), vec2(1.0), fract(value));
    float a = hash12(cell);
    float b = hash12(cell + vec2(1.0, 0.0));
    float c = hash12(cell + vec2(0.0, 1.0));
    float d = hash12(cell + vec2(1.0, 1.0));
    return mix(mix(a, b, local.x), mix(c, d, local.x), local.y);
}

vec2 rotate2(vec2 value, float angle) {
    float s = sin(angle);
    float c = cos(angle);
    return vec2(c * value.x - s * value.y, s * value.x + c * value.y);
}

ivec2 wrap_texel(ivec2 texel, ivec2 size) {
    return ivec2((texel.x + size.x) % size.x, (texel.y + size.y) % size.y);
}

float base_foam_at(ivec2 texel, ivec2 size) {
    return imageLoad(base_normal_foam_image, wrap_texel(texel, size)).w;
}

void add_detail_component(inout float height, inout vec2 slope, inout float crest, vec2 position,
                          vec2 direction, float wavelength, float amplitude, float time,
                          float phase_offset, float crest_sharpness) {
    float k = (2.0 * PI) / max(wavelength, 0.001);
    float omega = sqrt(G * k);
    float phase = dot(position, direction) * k + time * omega + phase_offset;
    float wave = sin(phase);
    float wave2 = sin(phase * 2.0 + phase_offset);
    float wave3 = sin(phase * 3.0 - phase_offset);
    float harmonic2 = 0.22 * crest_sharpness;
    float harmonic3 = 0.07 * crest_sharpness;
    float shaped_wave = wave + max(wave, 0.0) * (wave2 * harmonic2 + wave3 * harmonic3);
    float wave_slope =
        (cos(phase) + cos(phase * 2.0 + phase_offset) * harmonic2 * 2.0 +
         cos(phase * 3.0 - phase_offset) * harmonic3 * 3.0) *
        amplitude * k;
    height += shaped_wave * amplitude;
    slope += direction * wave_slope;
    float pinched_crest = smoothstep(0.78, mix(0.995, 0.90, crest_sharpness), wave);
    crest = max(crest, pinched_crest * amplitude * k * (1.0 + crest_sharpness * 0.45));
}

float wave_packet_envelope(vec2 position, vec2 direction, float wavelength, float time,
                           float band_index) {
    vec2 cross_direction = vec2(-direction.y, direction.x);
    vec2 packet_uv =
        vec2(dot(position, direction) / max(wavelength * 5.8, 0.001) -
                 time * (0.012 + band_index * 0.0015),
             dot(position, cross_direction) / max(wavelength * 2.9, 0.001));
    float broad = value_noise(packet_uv + vec2(band_index * 11.7, band_index * -5.4));
    float secondary =
        value_noise(packet_uv * vec2(0.47, 0.72) + vec2(band_index * 4.1, time * 0.010));
    float pulse = 0.5 + 0.5 * sin(time * (0.16 + band_index * 0.027) + band_index * 1.91);
    float packet = mix(broad, secondary, 0.35);
    return smoothstep(0.26, 0.78, packet) * mix(0.55, 1.15, pulse);
}

void add_detail_packet(inout float height, inout vec2 slope, inout float crest, vec2 position,
                       vec2 wind_direction, float base_wavelength, float time,
                       float spread_radians, float detail_chop, float crest_sharpness,
                       int band) {
    float band_index = float(band);
    float band_ratio = band_index / 7.0;
    float angle_offset = mix(-1.0, 1.0, band_ratio) * spread_radians;
    angle_offset += (hash12(vec2(band_index, 19.31)) - 0.5) * spread_radians * 0.42;
    vec2 direction = rotate2(wind_direction, angle_offset);
    float wavelength = base_wavelength * exp2(mix(1.45, -0.70, band_ratio));
    float amplitude = detail_chop * mix(0.24, 0.035, band_ratio);
    float envelope = wave_packet_envelope(position, direction, wavelength, time, band_index);
    amplitude *= envelope;
    float phase = hash12(vec2(band_index, 41.7)) * 2.0 * PI;

    add_detail_component(height, slope, crest, position, direction, wavelength, amplitude, time,
                         phase, crest_sharpness);
    vec2 opposing_direction =
        rotate2(-direction, (hash12(vec2(band_index, 83.2)) - 0.5) * spread_radians * 0.32);
    add_detail_component(height, slope, crest, position, opposing_direction, wavelength * 1.06,
                         amplitude * mix(0.18, 0.36, band_ratio), -time * 0.82,
                         phase + 1.7, crest_sharpness);
}

float foam_coverage_mask(vec2 position, vec2 wind_direction, float time, float foam_breakup,
                         float foam_coverage) {
    vec2 cross_direction = vec2(-wind_direction.y, wind_direction.x);
    vec2 aligned_uv = vec2(dot(position, wind_direction) * 0.018 - time * 0.014,
                           dot(position, cross_direction) * 0.026);
    float broad = value_noise(aligned_uv);
    float patch_noise = value_noise(position * 0.022 + vec2(time * 0.010, time * -0.007));
    float streak_noise =
        value_noise(vec2(dot(position, wind_direction) * 0.052 - time * 0.030,
                         dot(position, cross_direction) * 0.010));
    float coverage_signal = mix(mix(broad, patch_noise, 0.25), streak_noise, 0.42);
    float coverage = clamp(foam_coverage, 0.0, 1.0);
    float threshold = mix(0.96, 0.54, coverage);
    float mask = smoothstep(threshold, min(threshold + 0.22, 0.99), coverage_signal);
    return mix(1.0, mix(0.12, 1.0, mask), clamp(foam_breakup, 0.0, 1.0));
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(detail_normal_foam_image);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    float resolution = max(params.ocean_options.x, 1.0);
    float time = params.ocean_options.y * max(params.wind_options.z, 0.0);
    float foam_threshold = params.ocean_options.w;
    float patch_length = max(params.cascade_options.x, 0.001);
    float cascade = params.cascade_options.y;
    float detail_chop = max(params.cascade_options.z, 0.0);
    float detail_spread = max(params.cascade_options.w, 0.0);
    float foam_amount = max(params.foam_options.x, 0.0);
    float wind_speed = max(params.foam_options.y, 0.1);
    float detail_geometry = max(params.foam_options.z, 0.0);
    float crest_sharpness = clamp(params.foam_options.w, 0.0, 1.5);
    float foam_coverage = clamp(params.foam_shaping_options.x, 0.0, 1.5);

    vec2 uv = (vec2(texel) + vec2(0.5)) / vec2(size);
    vec2 position = uv * patch_length;
    vec2 wind_direction = params.wind_options.xy;
    wind_direction = length(wind_direction) > 0.001 ? normalize(wind_direction) : vec2(1.0, 0.0);

    float spread_radians = clamp(detail_spread, 0.0, 1.0) * 1.15;
    float cascade_scale = exp2(cascade * 0.30);
    float sea_scale = mix(0.82, 1.34, clamp((wind_speed - 4.0) / 24.0, 0.0, 1.0));
    float base_wavelength = patch_length / resolution * 38.0 * cascade_scale * sea_scale;

    float height = 0.0;
    vec2 slope = vec2(0.0);
    float crest = 0.0;
    for (int band = 0; band < 8; ++band) {
        add_detail_packet(height, slope, crest, position, wind_direction, base_wavelength,
                          time * mix(0.92, 1.28, float(band) / 7.0), spread_radians,
                          detail_chop, crest_sharpness, band);
    }

    vec4 base = imageLoad(base_normal_foam_image, texel);
    float base_foam = (base.w * 4.0 + base_foam_at(texel + ivec2(1, 0), size) +
                       base_foam_at(texel + ivec2(-1, 0), size) +
                       base_foam_at(texel + ivec2(0, 1), size) +
                       base_foam_at(texel + ivec2(0, -1), size)) *
                      0.125;
    float coverage =
        foam_coverage_mask(position, wind_direction, time, params.wind_options.w, foam_coverage);
    float crest_foam = smoothstep(foam_threshold * 0.72, foam_threshold * 1.18, crest);
    float source_gate = smoothstep(0.045, 0.36, base_foam);
    float detail_foam =
        crest_foam * foam_amount * coverage * source_gate * mix(0.10, 0.24, crest_sharpness);
    float foam_source = clamp(max(base_foam, detail_foam), 0.0, 1.0);
    imageStore(detail_normal_foam_image, texel,
               vec4(height * detail_geometry, slope.x, slope.y, foam_source));
}
