#version 450

layout(local_size_x = 8, local_size_y = 8) in;

struct Cell {
    vec4 dye;
    vec4 velocity;
};

layout(set = 0, binding = 0, std430) readonly buffer Field {
    Cell cells[];
} field;

layout(set = 0, binding = 1, std430) buffer DivergenceField {
    float values[];
} divergence;

layout(set = 0, binding = 2, std430) buffer PressureAField {
    float values[];
} pressure_a;

layout(set = 0, binding = 3, std430) buffer PressureBField {
    float values[];
} pressure_b;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_options;
    vec4 solver_options;
    vec4 tuning_options;
} params;

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

float velocity_x(ivec2 coord, uint width, uint height) {
    return field.cells[cell_index(coord, width, height)].velocity.x;
}

float velocity_y(ivec2 coord, uint width, uint height) {
    return field.cells[cell_index(coord, width, height)].velocity.y;
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    pressure_a.values[index] = 0.0;
    pressure_b.values[index] = 0.0;

    ivec2 coord = ivec2(int(x), int(y));
    if (x == 0 || y == 0 || x + 1 >= width || y + 1 >= height) {
        divergence.values[index] = 0.0;
        return;
    }

    float left = velocity_x(coord + ivec2(-1, 0), width, height);
    float right = velocity_x(coord + ivec2(1, 0), width, height);
    float down = velocity_y(coord + ivec2(0, -1), width, height);
    float up = velocity_y(coord + ivec2(0, 1), width, height);
    divergence.values[index] = 0.5 * ((right - left) + (up - down));
}
