#version 450

layout(local_size_x = 8, local_size_y = 8) in;

struct Cell {
    vec4 dye;
    vec4 velocity;
};

layout(set = 0, binding = 0, std430) readonly buffer Field {
    Cell cells[];
} field;

layout(set = 0, binding = 1, std430) buffer CurlField {
    float values[];
} curl;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_options;
    vec4 solver_options;
    vec4 tuning_options;
} params;

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    if (x == 0 || y == 0 || x + 1 >= width || y + 1 >= height) {
        curl.values[index] = 0.0;
        return;
    }

    ivec2 coord = ivec2(int(x), int(y));
    float left_y = field.cells[cell_index(coord + ivec2(-1, 0), width, height)].velocity.y;
    float right_y = field.cells[cell_index(coord + ivec2(1, 0), width, height)].velocity.y;
    float down_x = field.cells[cell_index(coord + ivec2(0, -1), width, height)].velocity.x;
    float up_x = field.cells[cell_index(coord + ivec2(0, 1), width, height)].velocity.x;
    curl.values[index] = 0.5 * ((right_y - left_y) - (up_x - down_x));
}
