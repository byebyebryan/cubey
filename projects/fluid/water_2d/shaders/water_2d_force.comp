#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = WATER2D_BINDING_U_FIELD, std430) buffer UField {
    float values[];
} u_field;
layout(set = 0, binding = WATER2D_BINDING_V_FIELD, std430) buffer VField {
    float values[];
} v_field;
layout(set = 0, binding = WATER2D_BINDING_U_WEIGHT, std430) readonly buffer UWeightField {
    float values[];
} u_weight;
layout(set = 0, binding = WATER2D_BINDING_V_WEIGHT, std430) readonly buffer VWeightField {
    float values[];
} v_weight;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;

WATER2D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

uint u_index(uint x, uint y, uint width) {
    return (y * (width + 1u)) + x;
}

uint v_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

bool solid_cell(int x, int y, uint width, uint height) {
    if (x < 0 || y < 0 || x >= int(width) || y >= int(height)) {
        return true;
    }
    return solid.values[cell_index(uint(x), uint(y), width)] > 0.5;
}

bool liquid_cell(int x, int y, uint width, uint height) {
    if (x < 0 || y < 0 || x >= int(width) || y >= int(height)) {
        return false;
    }
    uint index = cell_index(uint(x), uint(y), width);
    return solid.values[index] < 0.5 && cell_counts.values[index] > 0u;
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    float dt = params.grid_dt_time.z;
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x <= width && y < height) {
        uint index = u_index(x, y, width);
        bool blocked = x == 0u || x == width || solid_cell(int(x) - 1, int(y), width, height) ||
                       solid_cell(int(x), int(y), width, height);
        if (blocked || u_weight.values[index] <= 0.0) {
            u_field.values[index] = 0.0;
        }
    }

    if (x < width && y <= height) {
        uint index = v_index(x, y, width);
        bool blocked = y == 0u || y == height || solid_cell(int(x), int(y) - 1, width, height) ||
                       solid_cell(int(x), int(y), width, height);
        bool adjacent_liquid =
            liquid_cell(int(x), int(y) - 1, width, height) || liquid_cell(int(x), int(y), width, height);
        if (blocked || !adjacent_liquid || v_weight.values[index] <= 0.0) {
            v_field.values[index] = 0.0;
        } else {
            v_field.values[index] = clamp(v_field.values[index] + params.init_options.z * dt,
                                          -3.0, 3.0);
        }
    }
}
