#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer PhiAField {
    float values[];
} phi_a;
layout(set = 0, binding = 6, std430) buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = 7, std430) buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = 8, std430) readonly buffer DivergenceField {
    float values[];
} divergence;
layout(set = 0, binding = 9, std430) readonly buffer SolidField {
    float values[];
} solid;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 init_options;
    vec4 obstacle_options;
    vec4 solve_options;
} params;

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

float read_pressure(uint index) {
    return params.solve_options.y > 0.5 ? pressure_a.values[index] : pressure_b.values[index];
}

void write_pressure(uint index, float value) {
    if (params.solve_options.y > 0.5) {
        pressure_b.values[index] = value;
    } else {
        pressure_a.values[index] = value;
    }
}

float neighbor_pressure_or_boundary(ivec2 coord, uint width, uint height, float center_pressure,
                                    inout float weight) {
    uint index = cell_index(coord, width, height);
    if (solid.values[index] > 0.5) {
        return center_pressure;
    }
    weight += 1.0;
    if (phi_a.values[index] >= 0.0) {
        return 0.0;
    }
    return read_pressure(index);
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = (y * width) + x;
    if (solid.values[index] > 0.5 || phi_a.values[index] >= 0.0) {
        write_pressure(index, 0.0);
        return;
    }

    ivec2 coord = ivec2(int(x), int(y));
    float center_pressure = read_pressure(index);
    float weight = 0.0;
    float sum = 0.0;
    sum += neighbor_pressure_or_boundary(coord + ivec2(-1, 0), width, height, center_pressure,
                                         weight);
    sum += neighbor_pressure_or_boundary(coord + ivec2(1, 0), width, height, center_pressure,
                                         weight);
    sum += neighbor_pressure_or_boundary(coord + ivec2(0, -1), width, height, center_pressure,
                                         weight);
    sum += neighbor_pressure_or_boundary(coord + ivec2(0, 1), width, height, center_pressure,
                                         weight);

    write_pressure(index, (sum - divergence.values[index]) / max(weight, 1.0));
}
