#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER2D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER2D_BINDING_CELL_PARTICLE_INDICES, std430) buffer CellParticleIndices {
    uint values[];
} cell_particle_indices;

WATER2D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint particle_count = uint(params.particle_options.x + 0.5);
    uint max_particles_per_cell = uint(params.particle_options.y + 0.5);
    if (particle_id >= particle_count) {
        return;
    }

    vec2 position = clamp(particle_positions.values[particle_id].xy, vec2(0.0), vec2(0.999999));
    uvec2 cell = uvec2(clamp(ivec2(floor(position * vec2(width, height))), ivec2(0),
                             ivec2(int(width) - 1, int(height) - 1)));
    uint cell_id = cell_index(cell.x, cell.y, width);
    if (solid.values[cell_id] > 0.5) {
        return;
    }

    uint slot = atomicAdd(cell_counts.values[cell_id], 1u);
    if (slot < max_particles_per_cell) {
        cell_particle_indices.values[(cell_id * max_particles_per_cell) + slot] = particle_id;
    }
}
