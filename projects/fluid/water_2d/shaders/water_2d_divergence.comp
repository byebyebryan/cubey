#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = WATER2D_BINDING_U_FIELD, std430) readonly buffer UField {
    float values[];
} u_field;
layout(set = 0, binding = WATER2D_BINDING_V_FIELD, std430) readonly buffer VField {
    float values[];
} v_field;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_A, std430) buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_B, std430) buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = WATER2D_BINDING_DIVERGENCE, std430) buffer DivergenceField {
    float values[];
} divergence;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;

WATER2D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

uint u_index(uint x, uint y, uint width) {
    return (y * (width + 1u)) + x;
}

uint v_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

bool liquid_cell(uint index) {
    return solid.values[index] < 0.5 && cell_counts.values[index] > 0u;
}

void main() {
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= width || y >= height) {
        return;
    }

    uint index = cell_index(x, y, width);
    pressure_a.values[index] = 0.0;
    pressure_b.values[index] = 0.0;
    if (!liquid_cell(index)) {
        divergence.values[index] = 0.0;
        return;
    }

    float left = u_field.values[u_index(x, y, width)];
    float right = u_field.values[u_index(x + 1u, y, width)];
    float bottom = v_field.values[v_index(x, y, width)];
    float top = v_field.values[v_index(x, y + 1u, width)];
    float velocity_divergence =
        ((right - left) * float(width)) + ((top - bottom) * float(height));
    float target_particles = max(1.0, params.particle_options.z);
    float overpack =
        max(0.0, (float(cell_counts.values[index]) - target_particles) / target_particles);
    float volume_source = min(overpack, 5.0) * max(0.0, WATER2D_VOLUME_STRENGTH);
    divergence.values[index] = velocity_divergence - volume_source;
}
