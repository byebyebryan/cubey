#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer PhiAField {
    float values[];
} phi_a;
layout(set = 0, binding = 3, std430) readonly buffer UField {
    float values[];
} u_b;
layout(set = 0, binding = 5, std430) readonly buffer VField {
    float values[];
} v_b;
layout(set = 0, binding = 6, std430) buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = 7, std430) buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = 8, std430) buffer DivergenceField {
    float values[];
} divergence;
layout(set = 0, binding = 9, std430) readonly buffer SolidField {
    float values[];
} solid;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 init_options;
    vec4 obstacle_options;
    vec4 solve_options;
} params;

uint cell_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

uint u_index(uint x, uint y, uint width) {
    return (y * (width + 1u)) + x;
}

uint v_index(uint x, uint y, uint width) {
    return (y * width) + x;
}

void main() {
    uint width = uint(params.grid_dt_time.x);
    uint height = uint(params.grid_dt_time.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = cell_index(x, y, width);
    pressure_a.values[index] = 0.0;
    pressure_b.values[index] = 0.0;

    if (solid.values[index] > 0.5 || phi_a.values[index] >= 0.0) {
        divergence.values[index] = 0.0;
        return;
    }

    float right = u_b.values[u_index(x + 1u, y, width)];
    float left = u_b.values[u_index(x, y, width)];
    float up = v_b.values[v_index(x, y + 1u, width)];
    float down = v_b.values[v_index(x, y, width)];
    divergence.values[index] = (right - left) + (up - down);
}
