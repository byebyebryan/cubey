#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = WATER3D_BINDING_U_FIELD, std430) buffer UField { float values[]; } u_field;
layout(set = 0, binding = WATER3D_BINDING_V_FIELD, std430) buffer VField { float values[]; } v_field;
layout(set = 0, binding = WATER3D_BINDING_W_FIELD, std430) buffer WField { float values[]; } w_field;
layout(set = 0, binding = WATER3D_BINDING_U_WEIGHT, std430) readonly buffer UWeightField { float values[]; } u_weight;
layout(set = 0, binding = WATER3D_BINDING_V_WEIGHT, std430) readonly buffer VWeightField { float values[]; } v_weight;
layout(set = 0, binding = WATER3D_BINDING_W_WEIGHT, std430) readonly buffer WWeightField { float values[]; } w_weight;
layout(set = 0, binding = WATER3D_BINDING_SOLID, std430) readonly buffer SolidField { float values[]; } solid;
layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts { uint values[]; } cell_counts;

WATER3D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * width + x;
}
uint u_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * (width + 1u) + x;
}
uint v_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * (height + 1u)) + y) * width + x;
}
uint w_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * width + x;
}

bool in_bounds(int x, int y, int z, uint width, uint height, uint depth) {
    return x >= 0 && y >= 0 && z >= 0 && x < int(width) && y < int(height) && z < int(depth);
}
bool solid_cell(int x, int y, int z, uint width, uint height, uint depth) {
    if (!in_bounds(x, y, z, width, height, depth)) {
        return true;
    }
    return solid.values[cell_index(uint(x), uint(y), uint(z), width, height)] > 0.5;
}
bool liquid_cell(int x, int y, int z, uint width, uint height, uint depth) {
    if (!in_bounds(x, y, z, width, height, depth)) {
        return false;
    }
    uint index = cell_index(uint(x), uint(y), uint(z), width, height);
    return solid.values[index] < 0.5 && cell_counts.values[index] > 0u;
}

float wave_gate(vec3 position) {
    if (params.wave_options0.x < 0.5) {
        return 0.0;
    }
    vec3 half_size = max(params.wave_options1.xyz, vec3(0.001));
    vec3 delta = abs(position - params.wave_options0.yzw) / half_size;
    if (any(greaterThan(delta, vec3(1.0)))) {
        return 0.0;
    }
    vec3 shaped = 1.0 - smoothstep(vec3(0.65), vec3(1.0), delta);
    return shaped.x * shaped.y * shaped.z;
}

float drain_gate(vec3 position) {
    if (params.drain_options.x < 0.5 || params.drain_flow.x <= 0.0) {
        return 0.0;
    }
    float radius = max(0.001, params.drain_flow.y);
    vec3 delta = position - params.drain_options.yzw;
    delta.y *= 1.35;
    float distance = length(delta);
    return 1.0 - smoothstep(radius * 0.55, radius, distance);
}

vec3 drain_target_velocity(vec3 position) {
    vec3 direction = params.drain_options.yzw - position;
    direction.y *= 0.55;
    float direction_length = length(direction);
    if (direction_length <= 0.0001) {
        return vec3(0.0);
    }
    return direction / direction_length * max(0.0, params.drain_flow.x);
}

float drive_toward(float current_velocity, float target_velocity, float gate, float dt) {
    float blend = clamp(gate * dt * 10.0, 0.0, 1.0);
    return mix(current_velocity, target_velocity, blend);
}

void main() {
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    float dt = WATER3D_DT;
    float velocity_limit = max(0.1, WATER3D_VELOCITY_LIMIT);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (x <= width && y < height && z < depth) {
        uint index = u_index(x, y, z, width, height);
        bool blocked = x == 0u || x == width ||
                       solid_cell(int(x) - 1, int(y), int(z), width, height, depth) ||
                       solid_cell(int(x), int(y), int(z), width, height, depth);
        if (blocked || u_weight.values[index] <= 0.0) {
            u_field.values[index] = 0.0;
        } else {
            vec3 face_position =
                vec3(float(x) / float(width), (float(y) + 0.5) / float(height),
                     (float(z) + 0.5) / float(depth));
            float phase = WATER3D_TIME * max(0.0, params.wave_options2.x) * 6.2831853;
            float wave_target = params.wave_options1.w * sin(phase);
            float driven_velocity =
                drive_toward(u_field.values[index], wave_target, wave_gate(face_position), dt);
            vec3 drain_velocity = drain_target_velocity(face_position);
            driven_velocity =
                drive_toward(driven_velocity, drain_velocity.x, drain_gate(face_position), dt);
            u_field.values[index] = clamp(driven_velocity, -velocity_limit, velocity_limit);
        }
    }
    if (x < width && y <= height && z < depth) {
        uint index = v_index(x, y, z, width, height);
        bool blocked = y == 0u || y == height ||
                       solid_cell(int(x), int(y) - 1, int(z), width, height, depth) ||
                       solid_cell(int(x), int(y), int(z), width, height, depth);
        bool adjacent_liquid = liquid_cell(int(x), int(y) - 1, int(z), width, height, depth) ||
                               liquid_cell(int(x), int(y), int(z), width, height, depth);
        if (blocked || !adjacent_liquid || v_weight.values[index] <= 0.0) {
            v_field.values[index] = 0.0;
        } else {
            vec3 face_position =
                vec3((float(x) + 0.5) / float(width), float(y) / float(height),
                     (float(z) + 0.5) / float(depth));
            float driven_velocity = v_field.values[index] + params.fill_options.w * dt;
            vec3 drain_velocity = drain_target_velocity(face_position);
            driven_velocity =
                drive_toward(driven_velocity, drain_velocity.y, drain_gate(face_position), dt);
            v_field.values[index] = clamp(driven_velocity, -velocity_limit, velocity_limit);
        }
    }
    if (x < width && y < height && z <= depth) {
        uint index = w_index(x, y, z, width, height);
        bool blocked = z == 0u || z == depth ||
                       solid_cell(int(x), int(y), int(z) - 1, width, height, depth) ||
                       solid_cell(int(x), int(y), int(z), width, height, depth);
        if (blocked || w_weight.values[index] <= 0.0) {
            w_field.values[index] = 0.0;
        } else {
            vec3 face_position =
                vec3((float(x) + 0.5) / float(width), (float(y) + 0.5) / float(height),
                     float(z) / float(depth));
            vec3 drain_velocity = drain_target_velocity(face_position);
            w_field.values[index] = clamp(
                drive_toward(w_field.values[index], drain_velocity.z, drain_gate(face_position),
                             dt),
                -velocity_limit, velocity_limit);
        }
    }
}
