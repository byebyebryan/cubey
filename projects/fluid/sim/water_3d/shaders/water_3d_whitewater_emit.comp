#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) readonly buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER3D_BINDING_WHITEWATER_POSITIONS, std430) buffer WhitewaterPositions {
    vec4 values[];
} whitewater_positions;
layout(set = 0, binding = WATER3D_BINDING_WHITEWATER_VELOCITIES, std430) buffer WhitewaterVelocities {
    vec4 values[];
} whitewater_velocities;
layout(set = 0, binding = WATER3D_BINDING_WHITEWATER_STATE, std430) buffer WhitewaterState {
    vec4 values[];
} whitewater_state;
layout(set = 0, binding = WATER3D_BINDING_WHITEWATER_COUNTERS, std430) buffer WhitewaterCounters {
    uint values[];
} whitewater_counters;

WATER3D_SIMULATION_PARAMS;

uint cell_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * width + uint(clamped.x);
}

bool cell_in_bounds(ivec3 coord, uint width, uint height, uint depth) {
    return coord.x >= 0 && coord.y >= 0 && coord.z >= 0 && coord.x < int(width) &&
           coord.y < int(height) && coord.z < int(depth);
}

bool solid_cell(ivec3 coord, uint width, uint height, uint depth) {
    if (!cell_in_bounds(coord, width, height, depth)) {
        return true;
    }
    return solid.values[cell_index(coord, width, height, depth)] > 0.5;
}

uint occupied_count(ivec3 coord, uint width, uint height, uint depth) {
    if (!cell_in_bounds(coord, width, height, depth)) {
        return 0u;
    }
    return cell_counts.values[cell_index(coord, width, height, depth)];
}

uint hash_u32(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float hash01(uint value) {
    return float(hash_u32(value) & 0x00ffffffu) / float(0x01000000u);
}

vec3 hash_direction(uint seed) {
    vec3 value = vec3(hash01(seed + 17u), hash01(seed + 31u), hash01(seed + 47u)) * 2.0 -
                 vec3(1.0);
    value.y = abs(value.y) * 0.65;
    return normalize(value + vec3(0.001, 0.20, 0.003));
}

vec3 free_surface_direction(ivec3 cell, uint width, uint height, uint depth, out float open_faces,
                            out float open_up) {
    vec3 direction = vec3(0.0);
    open_faces = 0.0;
    open_up = 0.0;
    ivec3 offsets[6] = ivec3[](
        ivec3(-1, 0, 0),
        ivec3(1, 0, 0),
        ivec3(0, -1, 0),
        ivec3(0, 1, 0),
        ivec3(0, 0, -1),
        ivec3(0, 0, 1)
    );
    for (int index = 0; index < 6; ++index) {
        ivec3 neighbor = cell + offsets[index];
        if (solid_cell(neighbor, width, height, depth)) {
            continue;
        }
        if (occupied_count(neighbor, width, height, depth) == 0u) {
            vec3 face_direction = vec3(offsets[index]);
            direction += face_direction;
            open_faces += 1.0;
            if (offsets[index].y > 0) {
                open_up = 1.0;
            }
        }
    }
    if (open_faces <= 0.0) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(direction + vec3(0.0, 0.25, 0.0));
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    uint capacity = uint(WATER3D_WHITEWATER_CAPACITY + 0.5);
    uint max_emit = min(uint(WATER3D_WHITEWATER_MAX_EMIT_PER_FRAME + 0.5), capacity);
    if (particle_id >= particle_count || max_emit == 0u || WATER3D_WHITEWATER_INTENSITY <= 0.0 ||
        particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    vec3 position = clamp(particle_positions.values[particle_id].xyz, vec3(0.0), vec3(0.999999));
    vec3 velocity = particle_velocities.values[particle_id].xyz;
    float speed = length(velocity);
    float speed_threshold = max(0.01, WATER3D_WHITEWATER_SPEED_THRESHOLD);
    if (speed < speed_threshold) {
        return;
    }

    ivec3 cell = ivec3(floor(position * vec3(width, height, depth)));
    if (solid_cell(cell, width, height, depth)) {
        return;
    }
    float open_faces = 0.0;
    float open_up = 0.0;
    vec3 surface_direction = free_surface_direction(cell, width, height, depth, open_faces, open_up);
    if (open_faces <= 0.0) {
        return;
    }

    uint frame_seed = uint(WATER3D_TIME * 4096.0);
    uint seed = hash_u32((particle_id * 747796405u) ^ (frame_seed * 2891336453u));
    float excess_speed = max(0.0, speed - speed_threshold);
    float surface_factor = clamp(open_faces / 4.0, 0.0, 1.0);
    float upward_surface = smoothstep(0.18, 0.58, surface_direction.y);
    float side_penalty = mix(0.35, 1.0, upward_surface);
    float probability = clamp((0.035 + excess_speed * 0.12) * surface_factor * side_penalty *
                                  WATER3D_WHITEWATER_INTENSITY,
                              0.0, 0.22);
    if (hash01(seed) > probability) {
        return;
    }

    uint emit_slot = atomicAdd(whitewater_counters.values[0], 1u);
    if (emit_slot >= max_emit) {
        return;
    }
    uint target = (frame_seed + emit_slot) % capacity;

    vec3 random_direction = hash_direction(seed);
    float energy = clamp(excess_speed / max(0.001, speed_threshold * 2.0), 0.0, 1.0);
    float upward_velocity = smoothstep(0.04, 0.28, velocity.y);
    float spray_signal = upward_surface * max(open_up * 0.55, upward_velocity);
    bool spray = speed > speed_threshold * 1.20 && spray_signal > 0.20 &&
                 hash01(seed + 19u) < mix(0.25, 0.70, energy);
    float lifetime = WATER3D_WHITEWATER_LIFETIME * mix(0.65, 1.25, hash01(seed + 73u));
    float radius_scale = mix(0.75, 1.55, hash01(seed + 101u)) * mix(0.85, 1.25, energy);
    vec3 lateral_random = normalize(vec3(random_direction.x, random_direction.y * 0.20,
                                         random_direction.z) +
                                    vec3(0.001, 0.0, 0.003));
    vec3 spawn_offset =
        (surface_direction * 0.40 + lateral_random * 0.60) * WATER3D_WHITEWATER_RADIUS *
        (spray ? mix(1.1, 2.4, energy) : mix(0.6, 1.4, energy));
    vec3 spawn_position = clamp(position + spawn_offset, vec3(0.001), vec3(0.999));
    vec3 spawn_velocity = spray
                              ? velocity * 0.45 + surface_direction * mix(0.08, 0.28, energy) +
                                    lateral_random * mix(0.04, 0.18, energy) +
                                    vec3(0.0, mix(0.03, 0.22, energy), 0.0)
                              : velocity * 0.18 + lateral_random * 0.035;

    whitewater_positions.values[target] = vec4(spawn_position, 1.0);
    whitewater_velocities.values[target] = vec4(spawn_velocity, 0.0);
    whitewater_state.values[target] = vec4(lifetime, spray ? 1.0 : 0.0, radius_scale, energy);
    atomicAdd(whitewater_counters.values[1], 1u);
}
