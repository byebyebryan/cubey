#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;

WATER3D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * width + x;
}

bool collide_axis(inout float position, inout float velocity, float minimum, float maximum,
                  float restitution) {
    if (position < minimum) {
        position = minimum;
        if (velocity < 0.0) {
            velocity = -velocity * restitution;
        }
        return true;
    }
    if (position > maximum) {
        position = maximum;
        if (velocity > 0.0) {
            velocity = -velocity * restitution;
        }
        return true;
    }
    return false;
}

void apply_side_wall_friction(inout vec3 velocity, bool side_wall_collision) {
    if (!side_wall_collision) {
        return;
    }
    velocity *= 0.88;
}

void clamp_velocity(inout vec3 velocity) {
    float velocity_limit = max(0.1, WATER3D_VELOCITY_LIMIT);
    float speed = length(velocity);
    if (speed > velocity_limit) {
        velocity *= velocity_limit / speed;
    }
}

void clear_affine(uint particle_id) {
    uint base = particle_id * 3u;
    particle_affine.values[base + 0u] = vec4(0.0);
    particle_affine.values[base + 1u] = vec4(0.0);
    particle_affine.values[base + 2u] = vec4(0.0);
}

bool inside_drain(vec3 position) {
    if (params.drain_options.x < 0.5) {
        return false;
    }
    vec3 half_size = max(params.drain_extents.xyz, vec3(0.001));
    return all(lessThan(abs(position - params.drain_options.yzw), half_size));
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    if (particle_id >= particle_count || particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    float restitution = clamp(WATER3D_BOUNDARY_RESTITUTION, 0.0, 1.0);
    float damping = clamp(WATER3D_PARTICLE_DAMPING, 0.0, 1.0);
    float particle_state = particle_positions.values[particle_id].w;
    vec3 position = particle_positions.values[particle_id].xyz;
    vec3 velocity = particle_velocities.values[particle_id].xyz;
    position += velocity * WATER3D_DT;

    vec3 margin = vec3(2.25 / float(width), 2.25 / float(height), 2.25 / float(depth));
    bool collided = false;
    bool side_wall_collided = false;
    side_wall_collided =
        collide_axis(position.x, velocity.x, margin.x, 1.0 - margin.x, restitution) ||
        side_wall_collided;
    collided = side_wall_collided || collided;
    collided = collide_axis(position.y, velocity.y, margin.y, 1.0 - margin.y, restitution) ||
               collided;
    side_wall_collided =
        collide_axis(position.z, velocity.z, margin.z, 1.0 - margin.z, restitution) ||
        side_wall_collided;
    collided = side_wall_collided || collided;
    apply_side_wall_friction(velocity, side_wall_collided);
    clamp_velocity(velocity);
    if (inside_drain(position)) {
        particle_positions.values[particle_id] =
            vec4(-10.0, -10.0, -10.0, WATER3D_PARTICLE_STATE_INACTIVE);
        particle_velocities.values[particle_id] = vec4(0.0);
        clear_affine(particle_id);
        return;
    }
    if (collided) {
        if (particle_state == WATER3D_PARTICLE_STATE_RAIN) {
            particle_state = WATER3D_PARTICLE_STATE_LIQUID;
        }
        clear_affine(particle_id);
    }
    if (particle_state == WATER3D_PARTICLE_STATE_RAIN) {
        uvec3 cell =
            uvec3(clamp(ivec3(floor(clamp(position, vec3(0.0), vec3(0.999999)) *
                                  vec3(width, height, depth))),
                        ivec3(0), ivec3(int(width) - 1, int(height) - 1, int(depth) - 1)));
        uint cell_id = cell_index(cell.x, cell.y, cell.z, width, height);
        if (cell_counts.values[cell_id] > max(1u, uint(WATER3D_PARTICLES_PER_CELL + 0.5))) {
            particle_state = WATER3D_PARTICLE_STATE_LIQUID;
        }
    }

    particle_positions.values[particle_id] = vec4(position, particle_state);
    particle_velocities.values[particle_id] = vec4(velocity * damping, 0.0);
}
