#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER3D_BINDING_U_FIELD, std430) readonly buffer UField { float values[]; } u_field;
layout(set = 0, binding = WATER3D_BINDING_U_PREVIOUS, std430) readonly buffer UPreviousField { float values[]; } u_previous;
layout(set = 0, binding = WATER3D_BINDING_V_FIELD, std430) readonly buffer VField { float values[]; } v_field;
layout(set = 0, binding = WATER3D_BINDING_V_PREVIOUS, std430) readonly buffer VPreviousField { float values[]; } v_previous;
layout(set = 0, binding = WATER3D_BINDING_W_FIELD, std430) readonly buffer WField { float values[]; } w_field;
layout(set = 0, binding = WATER3D_BINDING_W_PREVIOUS, std430) readonly buffer WPreviousField { float values[]; } w_previous;

WATER3D_SIMULATION_PARAMS;

uint u_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width)),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * (width + 1u) + uint(clamped.x);
}
uint v_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height)),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * (height + 1u)) + uint(clamped.y)) * width + uint(clamped.x);
}
uint w_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth)));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * width + uint(clamped.x);
}

float lerp8(float c000, float c100, float c010, float c110, float c001, float c101, float c011,
            float c111, vec3 f) {
    float x00 = mix(c000, c100, f.x);
    float x10 = mix(c010, c110, f.x);
    float x01 = mix(c001, c101, f.x);
    float x11 = mix(c011, c111, f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

float sample_u(vec3 uv, uint width, uint height, uint depth, bool previous) {
    vec3 position = vec3(uv.x * float(width), uv.y * float(height) - 0.5,
                         uv.z * float(depth) - 0.5);
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    float c000 = previous ? u_previous.values[u_index(base, width, height, depth)]
                          : u_field.values[u_index(base, width, height, depth)];
    float c100 = previous ? u_previous.values[u_index(base + ivec3(1, 0, 0), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(1, 0, 0), width, height, depth)];
    float c010 = previous ? u_previous.values[u_index(base + ivec3(0, 1, 0), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(0, 1, 0), width, height, depth)];
    float c110 = previous ? u_previous.values[u_index(base + ivec3(1, 1, 0), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(1, 1, 0), width, height, depth)];
    float c001 = previous ? u_previous.values[u_index(base + ivec3(0, 0, 1), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(0, 0, 1), width, height, depth)];
    float c101 = previous ? u_previous.values[u_index(base + ivec3(1, 0, 1), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(1, 0, 1), width, height, depth)];
    float c011 = previous ? u_previous.values[u_index(base + ivec3(0, 1, 1), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(0, 1, 1), width, height, depth)];
    float c111 = previous ? u_previous.values[u_index(base + ivec3(1, 1, 1), width, height, depth)]
                          : u_field.values[u_index(base + ivec3(1, 1, 1), width, height, depth)];
    return lerp8(c000, c100, c010, c110, c001, c101, c011, c111, f);
}

float sample_v(vec3 uv, uint width, uint height, uint depth, bool previous) {
    vec3 position = vec3(uv.x * float(width) - 0.5, uv.y * float(height),
                         uv.z * float(depth) - 0.5);
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    float c000 = previous ? v_previous.values[v_index(base, width, height, depth)]
                          : v_field.values[v_index(base, width, height, depth)];
    float c100 = previous ? v_previous.values[v_index(base + ivec3(1, 0, 0), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(1, 0, 0), width, height, depth)];
    float c010 = previous ? v_previous.values[v_index(base + ivec3(0, 1, 0), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(0, 1, 0), width, height, depth)];
    float c110 = previous ? v_previous.values[v_index(base + ivec3(1, 1, 0), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(1, 1, 0), width, height, depth)];
    float c001 = previous ? v_previous.values[v_index(base + ivec3(0, 0, 1), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(0, 0, 1), width, height, depth)];
    float c101 = previous ? v_previous.values[v_index(base + ivec3(1, 0, 1), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(1, 0, 1), width, height, depth)];
    float c011 = previous ? v_previous.values[v_index(base + ivec3(0, 1, 1), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(0, 1, 1), width, height, depth)];
    float c111 = previous ? v_previous.values[v_index(base + ivec3(1, 1, 1), width, height, depth)]
                          : v_field.values[v_index(base + ivec3(1, 1, 1), width, height, depth)];
    return lerp8(c000, c100, c010, c110, c001, c101, c011, c111, f);
}

float sample_w(vec3 uv, uint width, uint height, uint depth, bool previous) {
    vec3 position = vec3(uv.x * float(width) - 0.5, uv.y * float(height) - 0.5,
                         uv.z * float(depth));
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    float c000 = previous ? w_previous.values[w_index(base, width, height, depth)]
                          : w_field.values[w_index(base, width, height, depth)];
    float c100 = previous ? w_previous.values[w_index(base + ivec3(1, 0, 0), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(1, 0, 0), width, height, depth)];
    float c010 = previous ? w_previous.values[w_index(base + ivec3(0, 1, 0), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(0, 1, 0), width, height, depth)];
    float c110 = previous ? w_previous.values[w_index(base + ivec3(1, 1, 0), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(1, 1, 0), width, height, depth)];
    float c001 = previous ? w_previous.values[w_index(base + ivec3(0, 0, 1), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(0, 0, 1), width, height, depth)];
    float c101 = previous ? w_previous.values[w_index(base + ivec3(1, 0, 1), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(1, 0, 1), width, height, depth)];
    float c011 = previous ? w_previous.values[w_index(base + ivec3(0, 1, 1), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(0, 1, 1), width, height, depth)];
    float c111 = previous ? w_previous.values[w_index(base + ivec3(1, 1, 1), width, height, depth)]
                          : w_field.values[w_index(base + ivec3(1, 1, 1), width, height, depth)];
    return lerp8(c000, c100, c010, c110, c001, c101, c011, c111, f);
}

vec3 sample_velocity(vec3 uv, uint width, uint height, uint depth, bool previous) {
    return vec3(sample_u(uv, width, height, depth, previous),
                sample_v(uv, width, height, depth, previous),
                sample_w(uv, width, height, depth, previous));
}

bool apic_transfer_mode() {
    return uint(WATER3D_TRANSFER_MODE + 0.5) == 1u;
}

void store_affine(uint particle_id, mat3 value) {
    uint base = particle_id * 3u;
    particle_affine.values[base + 0u] = vec4(value[0], 0.0);
    particle_affine.values[base + 1u] = vec4(value[1], 0.0);
    particle_affine.values[base + 2u] = vec4(value[2], 0.0);
}

mat3 affine_from_grid(vec3 position, uint width, uint height, uint depth) {
    vec3 dx = vec3(1.0 / float(width), 0.0, 0.0);
    vec3 dy = vec3(0.0, 1.0 / float(height), 0.0);
    vec3 dz = vec3(0.0, 0.0, 1.0 / float(depth));
    vec3 d_vx =
        (sample_velocity(clamp(position + dx, vec3(0.0), vec3(1.0)), width, height, depth, false) -
         sample_velocity(clamp(position - dx, vec3(0.0), vec3(1.0)), width, height, depth, false)) *
        0.5;
    vec3 d_vy =
        (sample_velocity(clamp(position + dy, vec3(0.0), vec3(1.0)), width, height, depth, false) -
         sample_velocity(clamp(position - dy, vec3(0.0), vec3(1.0)), width, height, depth, false)) *
        0.5;
    vec3 d_vz =
        (sample_velocity(clamp(position + dz, vec3(0.0), vec3(1.0)), width, height, depth, false) -
         sample_velocity(clamp(position - dz, vec3(0.0), vec3(1.0)), width, height, depth, false)) *
        0.5;
    return mat3(d_vx, d_vy, d_vz);
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    if (particle_id >= particle_count || particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    vec3 position = particle_positions.values[particle_id].xyz;
    vec3 old_velocity = particle_velocities.values[particle_id].xyz;
    vec3 current_grid_velocity = sample_velocity(position, width, height, depth, false);
    vec3 velocity = current_grid_velocity;
    if (apic_transfer_mode()) {
        store_affine(particle_id, affine_from_grid(position, width, height, depth));
    } else {
        vec3 previous_grid_velocity = sample_velocity(position, width, height, depth, true);
        vec3 pic_velocity = current_grid_velocity;
        vec3 flip_velocity = old_velocity + (current_grid_velocity - previous_grid_velocity);
        velocity = mix(pic_velocity, flip_velocity, clamp(WATER3D_FLIP_RATIO, 0.0, 1.0));
        store_affine(particle_id, mat3(0.0));
    }
    float speed = length(velocity);
    float velocity_limit = max(0.1, WATER3D_VELOCITY_LIMIT);
    if (speed > velocity_limit) {
        velocity *= velocity_limit / speed;
    }
    particle_velocities.values[particle_id] = vec4(velocity, 0.0);
}
