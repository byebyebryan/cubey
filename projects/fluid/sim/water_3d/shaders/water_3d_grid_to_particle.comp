#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER3D_BINDING_U_FIELD, std430) readonly buffer UField { float values[]; } u_field;
layout(set = 0, binding = WATER3D_BINDING_U_PREVIOUS, std430) readonly buffer UPreviousField { float values[]; } u_previous;
layout(set = 0, binding = WATER3D_BINDING_V_FIELD, std430) readonly buffer VField { float values[]; } v_field;
layout(set = 0, binding = WATER3D_BINDING_V_PREVIOUS, std430) readonly buffer VPreviousField { float values[]; } v_previous;
layout(set = 0, binding = WATER3D_BINDING_W_FIELD, std430) readonly buffer WField { float values[]; } w_field;
layout(set = 0, binding = WATER3D_BINDING_W_PREVIOUS, std430) readonly buffer WPreviousField { float values[]; } w_previous;
layout(set = 0, binding = WATER3D_BINDING_U_WEIGHT, std430) readonly buffer UWeightField { float values[]; } u_weight;
layout(set = 0, binding = WATER3D_BINDING_V_WEIGHT, std430) readonly buffer VWeightField { float values[]; } v_weight;
layout(set = 0, binding = WATER3D_BINDING_W_WEIGHT, std430) readonly buffer WWeightField { float values[]; } w_weight;
layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts { uint values[]; } cell_counts;

WATER3D_SIMULATION_PARAMS;

uint u_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width)),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * (width + 1u) + uint(clamped.x);
}

uint v_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height)),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * (height + 1u)) + uint(clamped.y)) * width + uint(clamped.x);
}

uint w_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth)));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * width + uint(clamped.x);
}

uint cell_index(ivec3 coord, uint width, uint height, uint depth) {
    ivec3 clamped = ivec3(clamp(coord.x, 0, int(width) - 1),
                          clamp(coord.y, 0, int(height) - 1),
                          clamp(coord.z, 0, int(depth) - 1));
    return ((uint(clamped.z) * height) + uint(clamped.y)) * width + uint(clamped.x);
}

bool cell_in_bounds(ivec3 coord, uint width, uint height, uint depth) {
    return coord.x >= 0 && coord.y >= 0 && coord.z >= 0 && coord.x < int(width) &&
           coord.y < int(height) && coord.z < int(depth);
}

float lerp8(float c000, float c100, float c010, float c110, float c001, float c101, float c011,
            float c111, vec3 f) {
    float x00 = mix(c000, c100, f.x);
    float x10 = mix(c010, c110, f.x);
    float x01 = mix(c001, c101, f.x);
    float x11 = mix(c011, c111, f.x);
    return mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
}

float read_u(ivec3 coord, uint width, uint height, uint depth, uint source) {
    uint index = u_index(coord, width, height, depth);
    if (source == 2u) {
        return u_weight.values[index];
    }
    if (source == 1u) {
        return u_previous.values[index];
    }
    return u_field.values[index];
}

float read_v(ivec3 coord, uint width, uint height, uint depth, uint source) {
    uint index = v_index(coord, width, height, depth);
    if (source == 2u) {
        return v_weight.values[index];
    }
    if (source == 1u) {
        return v_previous.values[index];
    }
    return v_field.values[index];
}

float read_w(ivec3 coord, uint width, uint height, uint depth, uint source) {
    uint index = w_index(coord, width, height, depth);
    if (source == 2u) {
        return w_weight.values[index];
    }
    if (source == 1u) {
        return w_previous.values[index];
    }
    return w_field.values[index];
}

float sample_u(vec3 uv, uint width, uint height, uint depth, uint source) {
    vec3 position = vec3(uv.x * float(width), uv.y * float(height) - 0.5,
                         uv.z * float(depth) - 0.5);
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    return lerp8(read_u(base, width, height, depth, source),
                 read_u(base + ivec3(1, 0, 0), width, height, depth, source),
                 read_u(base + ivec3(0, 1, 0), width, height, depth, source),
                 read_u(base + ivec3(1, 1, 0), width, height, depth, source),
                 read_u(base + ivec3(0, 0, 1), width, height, depth, source),
                 read_u(base + ivec3(1, 0, 1), width, height, depth, source),
                 read_u(base + ivec3(0, 1, 1), width, height, depth, source),
                 read_u(base + ivec3(1, 1, 1), width, height, depth, source), f);
}

float sample_v(vec3 uv, uint width, uint height, uint depth, uint source) {
    vec3 position = vec3(uv.x * float(width) - 0.5, uv.y * float(height),
                         uv.z * float(depth) - 0.5);
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    return lerp8(read_v(base, width, height, depth, source),
                 read_v(base + ivec3(1, 0, 0), width, height, depth, source),
                 read_v(base + ivec3(0, 1, 0), width, height, depth, source),
                 read_v(base + ivec3(1, 1, 0), width, height, depth, source),
                 read_v(base + ivec3(0, 0, 1), width, height, depth, source),
                 read_v(base + ivec3(1, 0, 1), width, height, depth, source),
                 read_v(base + ivec3(0, 1, 1), width, height, depth, source),
                 read_v(base + ivec3(1, 1, 1), width, height, depth, source), f);
}

float sample_w(vec3 uv, uint width, uint height, uint depth, uint source) {
    vec3 position = vec3(uv.x * float(width) - 0.5, uv.y * float(height) - 0.5,
                         uv.z * float(depth));
    ivec3 base = ivec3(floor(position));
    vec3 f = fract(position);
    return lerp8(read_w(base, width, height, depth, source),
                 read_w(base + ivec3(1, 0, 0), width, height, depth, source),
                 read_w(base + ivec3(0, 1, 0), width, height, depth, source),
                 read_w(base + ivec3(1, 1, 0), width, height, depth, source),
                 read_w(base + ivec3(0, 0, 1), width, height, depth, source),
                 read_w(base + ivec3(1, 0, 1), width, height, depth, source),
                 read_w(base + ivec3(0, 1, 1), width, height, depth, source),
                 read_w(base + ivec3(1, 1, 1), width, height, depth, source), f);
}

vec3 sample_velocity(vec3 uv, uint width, uint height, uint depth, uint source) {
    return vec3(sample_u(uv, width, height, depth, source),
                sample_v(uv, width, height, depth, source),
                sample_w(uv, width, height, depth, source));
}

bool apic_transfer_mode() {
    return uint(WATER3D_TRANSFER_MODE + 0.5) == 1u;
}

void store_affine(uint particle_id, mat3 value) {
    uint base = particle_id * 3u;
    particle_affine.values[base + 0u] = vec4(value[0], 0.0);
    particle_affine.values[base + 1u] = vec4(value[1], 0.0);
    particle_affine.values[base + 2u] = vec4(value[2], 0.0);
}

mat3 affine_from_grid(vec3 position, uint width, uint height, uint depth) {
    vec3 dx = vec3(1.0 / float(width), 0.0, 0.0);
    vec3 dy = vec3(0.0, 1.0 / float(height), 0.0);
    vec3 dz = vec3(0.0, 0.0, 1.0 / float(depth));
    vec3 d_vx =
        (sample_velocity(clamp(position + dx, vec3(0.0), vec3(1.0)), width, height, depth, 0u) -
         sample_velocity(clamp(position - dx, vec3(0.0), vec3(1.0)), width, height, depth, 0u)) *
        0.5;
    vec3 d_vy =
        (sample_velocity(clamp(position + dy, vec3(0.0), vec3(1.0)), width, height, depth, 0u) -
         sample_velocity(clamp(position - dy, vec3(0.0), vec3(1.0)), width, height, depth, 0u)) *
        0.5;
    vec3 d_vz =
        (sample_velocity(clamp(position + dz, vec3(0.0), vec3(1.0)), width, height, depth, 0u) -
         sample_velocity(clamp(position - dz, vec3(0.0), vec3(1.0)), width, height, depth, 0u)) *
        0.5;
    return mat3(d_vx, d_vy, d_vz);
}

float min_component(vec3 value) {
    return min(value.x, min(value.y, value.z));
}

float sparse_droplet_blend(ivec3 center, uint width, uint height, uint depth) {
    uint occupied_cells = 0u;
    uint nearby_particles = 0u;
    uint max_particles_per_cell = uint(WATER3D_MAX_PARTICLES_PER_CELL + 0.5);
    for (int oz = -1; oz <= 1; ++oz) {
        for (int oy = -1; oy <= 1; ++oy) {
            for (int ox = -1; ox <= 1; ++ox) {
                ivec3 cell = center + ivec3(ox, oy, oz);
                if (!cell_in_bounds(cell, width, height, depth)) {
                    continue;
                }
                uint count = min(cell_counts.values[cell_index(cell, width, height, depth)],
                                 max_particles_per_cell);
                if (count > 0u) {
                    occupied_cells += 1u;
                    nearby_particles += count;
                }
            }
        }
    }

    float target_particles = max(1.0, WATER3D_PARTICLES_PER_CELL);
    float particle_sparsity =
        1.0 - smoothstep(target_particles * 6.0, target_particles * 18.0,
                         float(nearby_particles));
    float cell_sparsity = 1.0 - smoothstep(4.0, 12.0, float(occupied_cells));
    return clamp(min(particle_sparsity, cell_sparsity), 0.0, 1.0);
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    if (particle_id >= particle_count || particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    vec3 position = particle_positions.values[particle_id].xyz;
    vec3 old_velocity = particle_velocities.values[particle_id].xyz;
    vec3 current_grid_velocity = sample_velocity(position, width, height, depth, 0u);
    vec3 confidence = clamp(sample_velocity(position, width, height, depth, 2u), vec3(0.0),
                            vec3(1.0));
    vec3 confidence_blend = smoothstep(vec3(0.05), vec3(0.35), confidence);
    vec3 fallback_velocity = old_velocity + vec3(0.0, params.fill_options.w * WATER3D_DT, 0.0);
    ivec3 cell = ivec3(clamp(ivec3(floor(position * vec3(width, height, depth))), ivec3(0),
                             ivec3(int(width) - 1, int(height) - 1, int(depth) - 1)));
    float droplet_blend = sparse_droplet_blend(cell, width, height, depth);
    vec3 velocity = current_grid_velocity;

    if (apic_transfer_mode()) {
        velocity = mix(fallback_velocity, current_grid_velocity, confidence_blend);
        store_affine(particle_id,
                     affine_from_grid(position, width, height, depth) *
                         min_component(confidence_blend) * (1.0 - droplet_blend));
    } else {
        vec3 previous_grid_velocity = sample_velocity(position, width, height, depth, 1u);
        vec3 pic_velocity = current_grid_velocity;
        vec3 flip_velocity = old_velocity + (current_grid_velocity - previous_grid_velocity);
        vec3 transfer_velocity =
            mix(pic_velocity, flip_velocity, clamp(WATER3D_FLIP_RATIO, 0.0, 1.0));
        velocity = mix(fallback_velocity, transfer_velocity, confidence_blend);
        store_affine(particle_id, mat3(0.0));
    }
    velocity = mix(velocity, fallback_velocity, droplet_blend);

    float speed = length(velocity);
    float velocity_limit = max(0.1, WATER3D_VELOCITY_LIMIT);
    if (speed > velocity_limit) {
        velocity *= velocity_limit / speed;
    }
    particle_velocities.values[particle_id] = vec4(velocity, 0.0);
}
