#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER3D_BINDING_CELL_PARTICLE_INDICES, std430) buffer CellParticleIndices {
    uint values[];
} cell_particle_indices;

WATER3D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * width + x;
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    uint max_particles_per_cell = uint(WATER3D_MAX_PARTICLES_PER_CELL + 0.5);
    if (particle_id >= particle_count || particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    vec3 position = clamp(particle_positions.values[particle_id].xyz, vec3(0.0), vec3(0.999999));
    uvec3 cell = uvec3(clamp(ivec3(floor(position * vec3(width, height, depth))), ivec3(0),
                             ivec3(int(width) - 1, int(height) - 1, int(depth) - 1)));
    uint cell_id = cell_index(cell.x, cell.y, cell.z, width, height);
    if (solid.values[cell_id] > 0.5) {
        return;
    }

    uint slot = atomicAdd(cell_counts.values[cell_id], 1u);
    if (slot < max_particles_per_cell) {
        cell_particle_indices.values[(cell_id * max_particles_per_cell) + slot] = particle_id;
    }
}
