#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_CELL_COUNTS, std430) buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER3D_BINDING_ACTIVE_WORK_COUNTS, std430) buffer ActiveWorkCounts {
    uint values[];
} active_work_counts;
layout(set = 0, binding = WATER3D_BINDING_ACTIVE_FACE_FLAGS, std430) buffer ActiveFaceFlags {
    uint values[];
} active_face_flags;
layout(set = 0, binding = WATER3D_BINDING_ACTIVE_FACE_DISPATCH_ARGS, std430) buffer ActiveFaceDispatchArgs {
    uint values[];
} active_face_dispatch_args;
layout(set = 0, binding = WATER3D_BINDING_CELL_OFFSETS, std430) buffer CellOffsets {
    uint values[];
} cell_offsets;
layout(set = 0, binding = WATER3D_BINDING_CELL_WRITE_COUNTS, std430) buffer CellWriteCounts {
    uint values[];
} cell_write_counts;

WATER3D_SIMULATION_PARAMS;

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint cell_count = width * height * depth;
    uint total_face_count = ((width + 1u) * height * depth) +
                            (width * (height + 1u) * depth) +
                            (width * height * (depth + 1u));

    if (id < cell_count) {
        cell_counts.values[id] = 0u;
        cell_offsets.values[id] = 0u;
        cell_write_counts.values[id] = 0u;
    }
    if (id < total_face_count) {
        active_face_flags.values[id] = 0u;
    }
    if (id < 4u) {
        active_work_counts.values[id] = 0u;
    }
    if (id < 3u) {
        active_face_dispatch_args.values[id] = 1u;
    }
}
