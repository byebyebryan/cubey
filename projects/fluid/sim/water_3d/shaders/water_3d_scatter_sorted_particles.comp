#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER3D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS_SOURCE, std430) readonly buffer ParticlePositionsSource {
    vec4 values[];
} particle_positions_source;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES_SOURCE, std430) readonly buffer ParticleVelocitiesSource {
    vec4 values[];
} particle_velocities_source;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE_SOURCE, std430) readonly buffer ParticleAffineSource {
    vec4 values[];
} particle_affine_source;
layout(set = 0, binding = WATER3D_BINDING_CELL_OFFSETS, std430) readonly buffer CellOffsets {
    uint values[];
} cell_offsets;
layout(set = 0, binding = WATER3D_BINDING_CELL_WRITE_COUNTS, std430) buffer CellWriteCounts {
    uint values[];
} cell_write_counts;

WATER3D_SIMULATION_PARAMS;

uint cell_index(uint x, uint y, uint z, uint width, uint height) {
    return ((z * height) + y) * width + x;
}

void main() {
    uint source_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER3D_GRID_WIDTH + 0.5);
    uint height = uint(WATER3D_GRID_HEIGHT + 0.5);
    uint depth = uint(WATER3D_GRID_DEPTH + 0.5);
    uint particle_count =
        min(uint(WATER3D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER3D_PARTICLE_CAPACITY + 0.5));
    if (source_id >= particle_count) {
        return;
    }

    vec4 source_position = particle_positions_source.values[source_id];
    if (source_position.w < 0.5) {
        return;
    }

    vec3 position = clamp(source_position.xyz, vec3(0.0), vec3(0.999999));
    uvec3 cell = uvec3(clamp(ivec3(floor(position * vec3(width, height, depth))), ivec3(0),
                             ivec3(int(width) - 1, int(height) - 1, int(depth) - 1)));
    uint cell_id = cell_index(cell.x, cell.y, cell.z, width, height);
    if (solid.values[cell_id] > 0.5) {
        return;
    }

    uint slot = atomicAdd(cell_write_counts.values[cell_id], 1u);
    uint target_id = cell_offsets.values[cell_id] + slot;
    if (target_id >= particle_count) {
        return;
    }

    particle_positions.values[target_id] = source_position;
    particle_velocities.values[target_id] = particle_velocities_source.values[source_id];

    uint source_affine = source_id * 3u;
    uint target_affine = target_id * 3u;
    particle_affine.values[target_affine + 0u] = particle_affine_source.values[source_affine + 0u];
    particle_affine.values[target_affine + 1u] = particle_affine_source.values[source_affine + 1u];
    particle_affine.values[target_affine + 2u] = particle_affine_source.values[source_affine + 2u];
}
