#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_3d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER3D_BINDING_PARTICLE_POSITIONS, std430) buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER3D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;

WATER3D_SIMULATION_PARAMS;

const uint WATER3D_EMITTER_HOSE = 0u;
const uint WATER3D_EMITTER_RAIN = 1u;
const float PI = 3.14159265358979323846;

float hash11(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return float(value & 0x00ffffffu) / float(0x01000000u);
}

vec3 perpendicular(vec3 direction) {
    vec3 axis = abs(direction.y) < 0.92 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    return normalize(cross(axis, direction));
}

vec3 cone_direction(vec3 base_direction, float spread_radians, uint seed) {
    vec3 base = normalize(base_direction);
    vec3 tangent = perpendicular(base);
    vec3 bitangent = normalize(cross(base, tangent));
    float theta = hash11(seed + 19u) * PI * 2.0;
    float angle = (hash11(seed + 31u) - 0.5) * max(0.0, spread_radians);
    return normalize(base + (tangent * cos(theta) + bitangent * sin(theta)) * tan(angle));
}

vec3 random_ball_offset(float radius, uint seed) {
    float radial = pow(hash11(seed + 43u), 1.0 / 3.0) * radius;
    float z = hash11(seed + 59u) * 2.0 - 1.0;
    float theta = hash11(seed + 71u) * PI * 2.0;
    float r = sqrt(max(0.0, 1.0 - z * z));
    return vec3(cos(theta) * r, z, sin(theta) * r) * radial;
}

void clear_affine(uint particle_id) {
    uint base = particle_id * 3u;
    particle_affine.values[base + 0u] = vec4(0.0);
    particle_affine.values[base + 1u] = vec4(0.0);
    particle_affine.values[base + 2u] = vec4(0.0);
}

void emit_particle(uint particle_id, vec3 position, vec3 velocity, float particle_state) {
    particle_positions.values[particle_id] =
        vec4(clamp(position, vec3(0.01), vec3(0.99)), particle_state);
    particle_velocities.values[particle_id] = vec4(velocity, 0.0);
    clear_affine(particle_id);
}

void emit_hose(uint particle_id, uint seed) {
    if (params.hose_options0.x < 0.5) {
        return;
    }
    vec3 position = params.hose_options0.yzw + random_ball_offset(params.hose_options2.x, seed);
    vec3 direction = cone_direction(params.hose_options1.xyz, params.hose_options2.z, seed);
    float speed_jitter = mix(0.86, 1.14, hash11(seed + 83u));
    emit_particle(particle_id, position, direction * params.hose_options1.w * speed_jitter,
                  WATER3D_PARTICLE_STATE_LIQUID);
}

void emit_rain(uint particle_id, uint seed) {
    if (params.rain_options0.x < 0.5) {
        return;
    }
    vec3 random_unit = vec3(hash11(seed + 97u), hash11(seed + 109u), hash11(seed + 127u));
    vec3 offset = (random_unit * 2.0 - 1.0) * params.rain_options1.xyz;
    vec3 position = params.rain_options0.yzw + offset + random_ball_offset(params.rain_options2.x, seed);
    vec3 direction = cone_direction(vec3(0.0, -1.0, 0.0), params.rain_options2.z, seed);
    float speed_jitter = mix(0.88, 1.12, hash11(seed + 149u));
    emit_particle(particle_id, position, direction * params.rain_options1.w * speed_jitter,
                  WATER3D_PARTICLE_STATE_RAIN);
}

void main() {
    uint emit_id = gl_GlobalInvocationID.x;
    uint emit_count = uint(WATER3D_EMIT_COUNT + 0.5);
    uint pool_capacity = uint(WATER3D_EMITTER_POOL_CAPACITY + 0.5);
    if (emit_id >= emit_count || pool_capacity == 0u) {
        return;
    }

    uint cursor = uint(WATER3D_EMIT_CURSOR + 0.5);
    uint pool_start = uint(WATER3D_EMITTER_POOL_START + 0.5);
    uint particle_id = pool_start + ((cursor + emit_id) % pool_capacity);
    uint emitter_kind = uint(WATER3D_EMITTER_KIND + 0.5);
    uint seed = particle_id * 1664525u + uint(WATER3D_EMITTER_SEED + 0.5) * 1013904223u +
                emit_id * 22695477u + uint(WATER3D_TIME * 977.0);

    if (emitter_kind == WATER3D_EMITTER_RAIN) {
        emit_rain(particle_id, seed);
        return;
    }
    emit_hose(particle_id, seed);
}
