#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
    vec4 shadow_options;
    vec4 fire_options;
    vec4 shaping_options;
    vec4 obstacle_options;
} params;

layout(r32f, set = 0, binding = 0) uniform readonly image3D divergence_volume;
layout(r32f, set = 0, binding = 1) uniform readonly image3D pressure_in;
layout(r32f, set = 0, binding = 2) uniform writeonly image3D pressure_out;

bool inside_obstacle_coord(ivec3 coord) {
    float radius = max(params.obstacle_options.y, 0.0);
    if (radius <= 0.0) {
        return false;
    }
    vec3 size = vec3(imageSize(pressure_in));
    vec3 uv = (vec3(clamp(coord, ivec3(0), imageSize(pressure_in) - ivec3(1))) + vec3(0.5)) /
              size;
    vec3 center = vec3(0.5, params.obstacle_options.x, 0.5);
    return length(uv - center) <= radius;
}

float pressure_at(ivec3 coord) {
    ivec3 max_coord = imageSize(pressure_in) - ivec3(1);
    return imageLoad(pressure_in, clamp(coord, ivec3(0), max_coord)).x;
}

float pressure_neighbor_or_center(ivec3 coord, float center) {
    if (inside_obstacle_coord(coord)) {
        return center;
    }
    return pressure_at(coord);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = ivec3(params.grid_dt_time.xyz);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }
    if (inside_obstacle_coord(coord)) {
        imageStore(pressure_out, coord, vec4(0.0));
        return;
    }

    float center = pressure_at(coord);
    float divergence = imageLoad(divergence_volume, coord).x;
    float neighbor_sum =
        pressure_neighbor_or_center(coord + ivec3(1, 0, 0), center) +
        pressure_neighbor_or_center(coord - ivec3(1, 0, 0), center) +
        pressure_neighbor_or_center(coord + ivec3(0, 1, 0), center) +
        pressure_neighbor_or_center(coord - ivec3(0, 1, 0), center) +
        pressure_neighbor_or_center(coord + ivec3(0, 0, 1), center) +
        pressure_neighbor_or_center(coord - ivec3(0, 0, 1), center);
    float pressure = (neighbor_sum - divergence) / 6.0;
    imageStore(pressure_out, coord, vec4(pressure, 0.0, 0.0, 0.0));
}
