#version 450
#extension GL_GOOGLE_include_directive : require

#include "cubey/environment_lighting.glsl"
#include "fluid_ray_box.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
    vec4 shadow_options;
    vec4 fire_options;
    vec4 shaping_options;
    vec4 obstacle_options;
} params;

layout(set = 0, binding = 0) uniform sampler3D density_volume;
layout(r32f, set = 0, binding = 1) uniform writeonly image3D shadow_volume;
layout(set = 1, binding = 0) uniform EnvironmentLightingBlock {
    CubeyEnvironmentLighting environment_lighting;
};

float rand_float(vec3 value) {
    return fract(sin(dot(value, vec3(12.9898, 78.233, 56.8346))) * 43758.5453);
}

float volume_edge_fade(vec3 position) {
    float edge_distance = min(min(position.x, 1.0 - position.x),
                              min(min(position.y, 1.0 - position.y),
                                  min(position.z, 1.0 - position.z)));
    return smoothstep(0.0, 0.045, edge_distance);
}

float raw_smoke_density(vec4 density) {
    return max(density.r, 0.0);
}

bool inside_obstacle(vec3 uv) {
    float radius = max(params.obstacle_options.y, 0.0);
    if (radius <= 0.0) {
        return false;
    }
    vec3 center = vec3(0.5, params.obstacle_options.x, 0.5);
    return length(uv - center) <= radius;
}

float soot_density_at(vec3 uv) {
    if (inside_obstacle(clamp(uv, vec3(0.0), vec3(1.0)))) {
        return 40.0;
    }
    float density = raw_smoke_density(texture(density_volume, clamp(uv, vec3(0.0), vec3(1.0))));
    return density * smoothstep(0.002, 0.025, density) * volume_edge_fade(uv);
}

float light_transmittance(vec3 uv) {
    vec3 light_direction = cubey_env_primary_light_direction(environment_lighting);
    float distance_to_exit = ray_box_exit_distance(uv, light_direction);
    if (distance_to_exit <= 0.0) {
        return 1.0;
    }

    float step_count = max(params.shadow_options.y, 1.0);
    float step_length = distance_to_exit / step_count;
    float jitter = rand_float(uv) * step_length;
    float optical_depth = 0.0;
    float absorption = max(params.shadow_options.x, 0.0);

    for (int i = 0; i < 256; ++i) {
        if (i >= int(step_count + 0.5)) {
            break;
        }
        float traveled = jitter + (float(i) + 0.5) * step_length;
        if (traveled >= distance_to_exit) {
            break;
        }
        vec3 sample_position = uv + light_direction * traveled;
        optical_depth += soot_density_at(sample_position) * step_length;
        if (optical_depth * absorption > 7.0) {
            return 0.0;
        }
    }
    return exp(-optical_depth * absorption);
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = imageSize(shadow_volume);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }

    vec3 uv = (vec3(coord) + vec3(0.5)) / vec3(size);
    imageStore(shadow_volume, coord, vec4(light_transmittance(uv)));
}
