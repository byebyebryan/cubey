#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "pyro_3d_simulation.glsl"

layout(rgba16f, set = 0, binding = 0) uniform readonly image3D density_source;
layout(set = 0, binding = 1) uniform sampler3D velocity_source;
layout(rgba16f, set = 0, binding = 2) uniform readonly image3D material_to_sample;
layout(set = 0, binding = 3) uniform sampler3D velocity_predicted;
layout(rgba16f, set = 0, binding = 4) uniform writeonly image3D density_out;
layout(rgba16f, set = 0, binding = 5) uniform writeonly image3D velocity_out;

#include "pyro_3d_transport.glsl"

vec4 load_density_source(ivec3 coord) {
    ivec3 max_coord = imageSize(density_source) - ivec3(1);
    return imageLoad(density_source, clamp(coord, ivec3(0), max_coord));
}

vec3 load_velocity_source(ivec3 coord) {
    ivec3 max_coord = textureSize(velocity_source, 0) - ivec3(1);
    return texelFetch(velocity_source, clamp(coord, ivec3(0), max_coord), 0).xyz;
}

// Limit each field using the source neighborhood at its own departure point and extent.
void density_source_bounds(vec3 uv, out vec4 lower, out vec4 upper) {
    vec3 position = clamp(uv, vec3(0.0), vec3(1.0)) * vec3(imageSize(density_source)) - vec3(0.5);
    ivec3 base = ivec3(floor(position));
    lower = upper = load_density_source(base);
    for (int z = 0; z <= 1; ++z) {
        for (int y = 0; y <= 1; ++y) {
            for (int x = 0; x <= 1; ++x) {
                vec4 value = load_density_source(base + ivec3(x, y, z));
                lower = min(lower, value);
                upper = max(upper, value);
            }
        }
    }
}

void velocity_source_bounds(vec3 uv, out vec3 lower, out vec3 upper) {
    vec3 position = clamp(uv, vec3(0.0), vec3(1.0)) * vec3(textureSize(velocity_source, 0)) - vec3(0.5);
    ivec3 base = ivec3(floor(position));
    lower = upper = load_velocity_source(base);
    for (int z = 0; z <= 1; ++z) {
        for (int y = 0; y <= 1; ++y) {
            for (int x = 0; x <= 1; ++x) {
                vec3 value = load_velocity_source(base + ivec3(x, y, z));
                lower = min(lower, value);
                upper = max(upper, value);
            }
        }
    }
}

vec4 source_density_average(ivec3 coord) {
    vec4 result = vec4(0.0);
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                result += load_density_source(coord + ivec3(x, y, z));
            }
        }
    }
    return result / 27.0;
}

vec3 source_velocity_average(ivec3 coord) {
    vec3 result = vec3(0.0);
    for (int z = -1; z <= 1; ++z) {
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                result += load_velocity_source(coord + ivec3(x, y, z));
            }
        }
    }
    return result / 27.0;
}

vec4 material_decay(float decay_scale) {
    return vec4(pow(params.decay_force.x, decay_scale),
                pow(params.decay_force.x, decay_scale * 2.20),
                pow(params.decay_force.x, decay_scale * 9.00),
                pow(params.decay_force.x, decay_scale));
}

float residual_cleanup(vec4 density, vec3 velocity) {
    float dye_energy = max(max(density.r, density.g * 0.6), density.b);
    float velocity_energy = length(velocity) * 0.08;
    return (1.0 - smoothstep(0.020, 0.180, max(dye_energy, velocity_energy))) * 0.12;
}

float wall_weight(vec3 pos) {
    float edge_distance = min(min(pos.x, 1.0 - pos.x), min(pyro_wall_y(pos.y), min(pos.z, 1.0 - pos.z)));
    return smoothstep(0.0, 0.040, edge_distance);
}

vec4 correct_density(ivec3 coord, vec3 uv, float dt, float velocity_decay) {
    vec3 original_velocity = textureLod(velocity_source, uv, 0.0).xyz;
    vec3 predicted_velocity = textureLod(velocity_predicted, uv, 0.0).xyz;
    vec3 previous_uv = uv - original_velocity * dt / pyro_domain_size();
    vec3 next_uv = uv + predicted_velocity * dt / pyro_domain_size();
    vec4 original = imageLoad(density_source, coord);
    vec4 predicted = imageLoad(material_to_sample, coord);
    vec4 reversed = sample_density(next_uv);
    vec4 lower, upper;
    density_source_bounds(previous_uv, lower, upper);
    vec4 limited = clamp(predicted + (original - reversed) * 0.5, lower, upper);
    vec4 density_decay = material_decay(dt * 60.0);
    float spent_flame = max(limited.b * (1.0 - density_decay.z), 0.0);
    vec4 density = limited * density_decay;
    density.r += spent_flame * 0.22;

    // The predicted cross-grid field is available to every invocation in this pass.
    float cleanup = residual_cleanup(density, predicted_velocity * velocity_decay);
    density = mix(density, source_density_average(coord), cleanup);
    vec3 pos = uv * pyro_domain_size();
    if (inside_obstacle(pos)) {
        return vec4(0.0);
    }
    density *= wall_weight(pos);
    density.rgb *= mix(0.88, 1.0,
                       smoothstep(0.018, 0.120, max(max(density.r, density.g), density.b)));
    return clamp(density, vec4(0.0), vec4(8.0));
}

vec3 correct_velocity(ivec3 coord, vec3 uv, float dt, float velocity_decay) {
    vec3 original = texelFetch(velocity_source, coord, 0).xyz;
    vec3 predicted = texelFetch(velocity_predicted, coord, 0).xyz;
    vec3 previous_uv = uv - original * dt / pyro_domain_size();
    vec3 next_uv = uv + predicted * dt / pyro_domain_size();
    vec3 reversed = textureLod(velocity_predicted, next_uv, 0.0).xyz;
    vec3 lower, upper;
    velocity_source_bounds(previous_uv, lower, upper);
    vec3 velocity = clamp(predicted + (original - reversed) * 0.5, lower, upper) * velocity_decay;

    // At a flow center, the fine trilinear sample is the 2x2x2 volume average.
    vec4 density = sample_density(uv) * material_decay(dt * 60.0);
    // Keep the cleanup diffusion calibrated to the original 128-wide flow grid.
    float flow_scale = float(textureSize(velocity_source, 0).x) / 128.0;
    float cleanup = residual_cleanup(density, velocity) * min(flow_scale * flow_scale, 1.0);
    velocity = mix(velocity, source_velocity_average(coord), cleanup);
    vec3 pos = uv * pyro_domain_size();
    if (inside_obstacle(pos)) {
        return vec3(0.0);
    }
    return clamp(velocity * wall_weight(pos), vec3(-6.0), vec3(6.0));
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 fine_size = imageSize(density_out);
    ivec3 flow_size = imageSize(velocity_out);
    float dt = params.grid_dt_time.w;
    float velocity_decay = pow(params.decay_force.y, dt * 60.0);
    if (all(lessThan(coord, fine_size))) {
        vec3 uv = (vec3(coord) + vec3(0.5)) / vec3(fine_size);
        imageStore(density_out, coord, correct_density(coord, uv, dt, velocity_decay));
    }
    if (all(lessThan(coord, flow_size))) {
        vec3 uv = (vec3(coord) + vec3(0.5)) / vec3(flow_size);
        imageStore(velocity_out, coord, vec4(correct_velocity(coord, uv, dt, velocity_decay), 0.0));
    }
}
