#version 450

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_time;
    vec4 decay_force;
    vec4 options;
    vec4 shadow_options;
    vec4 fire_options;
    vec4 shaping_options;
    vec4 obstacle_options;
} params;

layout(rgba16f, set = 0, binding = 0) uniform readonly image3D velocity_volume;
layout(rgba16f, set = 0, binding = 1) uniform readonly image3D material_volume;
layout(r32f, set = 0, binding = 2) uniform writeonly image3D divergence_volume;

bool inside_obstacle_coord(ivec3 coord) {
    float radius = max(params.obstacle_options.y, 0.0);
    if (radius <= 0.0) {
        return false;
    }
    vec3 size = vec3(imageSize(velocity_volume));
    vec3 uv = (vec3(clamp(coord, ivec3(0), imageSize(velocity_volume) - ivec3(1))) + vec3(0.5)) /
              size;
    vec3 center = vec3(0.5, params.obstacle_options.x, 0.5);
    return length(uv - center) <= radius;
}

vec3 velocity_at(ivec3 coord) {
    if (inside_obstacle_coord(coord)) {
        return vec3(0.0);
    }
    ivec3 max_coord = imageSize(velocity_volume) - ivec3(1);
    return imageLoad(velocity_volume, clamp(coord, ivec3(0), max_coord)).xyz;
}

vec4 material_at(ivec3 coord) {
    ivec3 max_coord = imageSize(material_volume) - ivec3(1);
    return imageLoad(material_volume, clamp(coord, ivec3(0), max_coord));
}

float pyro_expansion(ivec3 coord) {
    int pyro_mode = int(params.shadow_options.w + 0.5);
    if (pyro_mode != 0 && pyro_mode != 1) {
        return 0.0;
    }
    vec4 material = material_at(coord);
    float flame = smoothstep(0.040, 0.55, material.b);
    float temperature = smoothstep(params.fire_options.x * 1.4, params.fire_options.x * 4.0,
                                   material.g);
    float fuel = pyro_mode == 0 ? smoothstep(0.010, 0.18, material.a) : 1.0;
    float mode_scale = pyro_mode == 1 ? 0.135 : 0.080;
    return params.shaping_options.x * flame * temperature * max(fuel, 0.18) * mode_scale;
}

void main() {
    ivec3 coord = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 size = ivec3(params.grid_dt_time.xyz);
    if (any(greaterThanEqual(coord, size))) {
        return;
    }
    if (inside_obstacle_coord(coord)) {
        imageStore(divergence_volume, coord, vec4(0.0));
        return;
    }

    float divergence = 0.5 * (
        velocity_at(coord + ivec3(1, 0, 0)).x - velocity_at(coord - ivec3(1, 0, 0)).x +
        velocity_at(coord + ivec3(0, 1, 0)).y - velocity_at(coord - ivec3(0, 1, 0)).y +
        velocity_at(coord + ivec3(0, 0, 1)).z - velocity_at(coord - ivec3(0, 0, 1)).z);
    divergence -= pyro_expansion(coord);
    imageStore(divergence_volume, coord, vec4(divergence, 0.0, 0.0, 0.0));
}
