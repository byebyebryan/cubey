#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER2D_BINDING_PARTICLE_POSITIONS, std430) readonly buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER2D_BINDING_U_FIELD, std430) readonly buffer UField {
    float values[];
} u_field;
layout(set = 0, binding = WATER2D_BINDING_U_PREVIOUS, std430) readonly buffer UPreviousField {
    float values[];
} u_previous;
layout(set = 0, binding = WATER2D_BINDING_V_FIELD, std430) readonly buffer VField {
    float values[];
} v_field;
layout(set = 0, binding = WATER2D_BINDING_V_PREVIOUS, std430) readonly buffer VPreviousField {
    float values[];
} v_previous;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER2D_BINDING_CELL_PARTICLE_INDICES, std430) readonly buffer CellParticleIndices {
    uint values[];
} cell_particle_indices;

WATER2D_SIMULATION_PARAMS;

uint u_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = ivec2(clamp(coord.x, 0, int(width)), clamp(coord.y, 0, int(height) - 1));
    return (uint(clamped.y) * (width + 1u)) + uint(clamped.x);
}

uint v_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = ivec2(clamp(coord.x, 0, int(width) - 1), clamp(coord.y, 0, int(height)));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

uint cell_index(ivec2 coord, uint width, uint height) {
    ivec2 clamped = clamp(coord, ivec2(0), ivec2(int(width) - 1, int(height) - 1));
    return (uint(clamped.y) * width) + uint(clamped.x);
}

float sample_u(vec2 uv, uint width, uint height, bool previous) {
    vec2 position = vec2(uv.x * float(width), uv.y * float(height) - 0.5);
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);
    float a = previous ? u_previous.values[u_index(base, width, height)]
                       : u_field.values[u_index(base, width, height)];
    float b = previous ? u_previous.values[u_index(base + ivec2(1, 0), width, height)]
                       : u_field.values[u_index(base + ivec2(1, 0), width, height)];
    float c = previous ? u_previous.values[u_index(base + ivec2(0, 1), width, height)]
                       : u_field.values[u_index(base + ivec2(0, 1), width, height)];
    float d = previous ? u_previous.values[u_index(base + ivec2(1, 1), width, height)]
                       : u_field.values[u_index(base + ivec2(1, 1), width, height)];
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float sample_v(vec2 uv, uint width, uint height, bool previous) {
    vec2 position = vec2(uv.x * float(width) - 0.5, uv.y * float(height));
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);
    float a = previous ? v_previous.values[v_index(base, width, height)]
                       : v_field.values[v_index(base, width, height)];
    float b = previous ? v_previous.values[v_index(base + ivec2(1, 0), width, height)]
                       : v_field.values[v_index(base + ivec2(1, 0), width, height)];
    float c = previous ? v_previous.values[v_index(base + ivec2(0, 1), width, height)]
                       : v_field.values[v_index(base + ivec2(0, 1), width, height)];
    float d = previous ? v_previous.values[v_index(base + ivec2(1, 1), width, height)]
                       : v_field.values[v_index(base + ivec2(1, 1), width, height)];
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

vec2 sample_velocity(vec2 uv, uint width, uint height, bool previous) {
    return vec2(sample_u(uv, width, height, previous), sample_v(uv, width, height, previous));
}

float kernel(float value) {
    return max(0.0, 1.0 - abs(value));
}

bool apic_transfer_mode() {
    return uint(WATER2D_TRANSFER_MODE + 0.5) == 1u;
}

vec4 pack_affine(mat2 value) {
    return vec4(value[0], value[1]);
}

mat2 safe_inverse_moment(mat2 moment) {
    float determinant = (moment[0][0] * moment[1][1]) - (moment[1][0] * moment[0][1]);
    if (abs(determinant) <= 0.000001) {
        return mat2(0.0);
    }
    float inv_det = 1.0 / determinant;
    return mat2(vec2(moment[1][1], -moment[0][1]), vec2(-moment[1][0], moment[0][0])) * inv_det;
}

mat2 affine_from_grid(vec2 position, vec2 particle_velocity, uint width, uint height) {
    vec2 particle_grid = position * vec2(width, height);
    ivec2 base = ivec2(floor(particle_grid - vec2(0.5)));
    mat2 velocity_moment = mat2(0.0);
    mat2 distance_moment = mat2(0.0);

    for (int oy = -1; oy <= 2; ++oy) {
        for (int ox = -1; ox <= 2; ++ox) {
            ivec2 cell = base + ivec2(ox, oy);
            if (cell.x < 0 || cell.y < 0 || cell.x >= int(width) || cell.y >= int(height)) {
                continue;
            }

            vec2 sample_grid = vec2(cell) + vec2(0.5);
            vec2 delta = sample_grid - particle_grid;
            float weight = kernel(delta.x) * kernel(delta.y);
            if (weight <= 0.0) {
                continue;
            }

            vec2 sample_uv = sample_grid / vec2(width, height);
            vec2 velocity = sample_velocity(sample_uv, width, height, false) - particle_velocity;
            velocity_moment += mat2(velocity * delta.x, velocity * delta.y) * weight;
            distance_moment +=
                mat2(vec2(delta.x * delta.x, delta.y * delta.x),
                     vec2(delta.x * delta.y, delta.y * delta.y)) *
                weight;
        }
    }

    return velocity_moment * safe_inverse_moment(distance_moment);
}

float hash11(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return float(value & 0x00ffffffu) / float(0x01000000u);
}

vec2 separation_velocity(uint particle_id, vec2 position, uint width, uint height,
                         uint max_particles_per_cell) {
    float radius = max(0.05, params.solve_options.x);
    float strength = clamp(params.solve_options.w, 0.0, 2.0);
    if (strength <= 0.0001) {
        return vec2(0.0);
    }

    vec2 grid_position = position * vec2(width, height);
    ivec2 center = ivec2(floor(grid_position));
    uint target_particles_per_cell = max(1u, uint(params.particle_options.z + 0.5));
    uint center_count = cell_counts.values[cell_index(center, width, height)];
    if (center_count <= target_particles_per_cell) {
        return vec2(0.0);
    }

    float overpack = clamp((float(center_count) - float(target_particles_per_cell)) /
                               float(target_particles_per_cell),
                           0.0, 1.0);
    int support = clamp(int(ceil(radius)) + 1, 1, 3);
    float radius_squared = radius * radius;
    vec2 correction = vec2(0.0);

    for (int oy = -3; oy <= 3; ++oy) {
        if (abs(oy) > support) {
            continue;
        }
        for (int ox = -3; ox <= 3; ++ox) {
            if (abs(ox) > support) {
                continue;
            }
            ivec2 cell = center + ivec2(ox, oy);
            if (cell.x < 0 || cell.y < 0 || cell.x >= int(width) || cell.y >= int(height)) {
                continue;
            }

            uint cell_id = cell_index(cell, width, height);
            uint count = min(cell_counts.values[cell_id], max_particles_per_cell);
            for (uint slot = 0u; slot < count; ++slot) {
                uint other_id =
                    cell_particle_indices.values[(cell_id * max_particles_per_cell) + slot];
                if (other_id == WATER2D_EMPTY_PARTICLE || other_id == particle_id ||
                    particle_positions.values[other_id].w < 0.5) {
                    continue;
                }

                vec2 other_grid = particle_positions.values[other_id].xy * vec2(width, height);
                vec2 delta = grid_position - other_grid;
                float distance_squared = dot(delta, delta);
                if (distance_squared >= radius_squared) {
                    continue;
                }

                if (distance_squared <= 0.000001) {
                    float angle = hash11((particle_id * 1664525u) ^ (other_id * 1013904223u)) *
                                  6.2831853;
                    delta = vec2(cos(angle), sin(angle)) * 0.001;
                    distance_squared = dot(delta, delta);
                }

                float distance = sqrt(distance_squared);
                correction += (delta / distance) * (radius - distance);
            }
        }
    }

    float correction_length = length(correction);
    float max_correction = radius * 0.55;
    if (correction_length > max_correction) {
        correction *= max_correction / correction_length;
    }

    vec2 correction_uv = correction * vec2(1.0 / float(width), 1.0 / float(height));
    return (correction_uv * strength * overpack) / max(WATER2D_DT, 0.00001);
}

bool isolated_liquid_neighborhood(ivec2 center, uint width, uint height) {
    uint occupied = 0u;
    for (int oy = -1; oy <= 1; ++oy) {
        for (int ox = -1; ox <= 1; ++ox) {
            ivec2 cell = center + ivec2(ox, oy);
            if (cell.x < 0 || cell.y < 0 || cell.x >= int(width) || cell.y >= int(height)) {
                continue;
            }
            if (cell_counts.values[cell_index(cell, width, height)] > 0u) {
                occupied += 1u;
            }
        }
    }
    return occupied <= 2u;
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint particle_count =
        min(uint(WATER2D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER2D_PARTICLE_CAPACITY + 0.5));
    if (particle_id >= particle_count) {
        return;
    }

    vec2 position = particle_positions.values[particle_id].xy;
    if (particle_positions.values[particle_id].w < 0.5) {
        return;
    }
    vec2 old_velocity = particle_velocities.values[particle_id].xy;
    vec2 current_grid_velocity = sample_velocity(position, width, height, false);
    vec2 velocity = current_grid_velocity;
    if (apic_transfer_mode()) {
        particle_affine.values[particle_id] =
            pack_affine(affine_from_grid(position, current_grid_velocity, width, height));
    } else {
        vec2 previous_grid_velocity = sample_velocity(position, width, height, true);
        vec2 pic_velocity = current_grid_velocity;
        vec2 flip_velocity = old_velocity + (current_grid_velocity - previous_grid_velocity);
        velocity = mix(pic_velocity, flip_velocity, clamp(params.particle_options.w, 0.0, 1.0));
        particle_affine.values[particle_id] = vec4(0.0);
    }
    uint particles_per_cell = max(1u, uint(params.particle_options.z + 0.5));
    uint max_particles_per_cell = uint(params.particle_options.y + 0.5);
    velocity += separation_velocity(particle_id, position, width, height, max_particles_per_cell);
    uint sparse_threshold = max(1u, particles_per_cell / 2u);
    ivec2 cell = ivec2(floor(position * vec2(width, height)));
    bool sparse_drop = cell_counts.values[cell_index(cell, width, height)] <= sparse_threshold &&
                       isolated_liquid_neighborhood(cell, width, height);
    if (sparse_drop && old_velocity.y <= 0.10) {
        float ballistic_y = old_velocity.y + params.init_options.z * WATER2D_DT;
        velocity.y = min(velocity.y, ballistic_y);
    }
    float speed = length(velocity);
    float velocity_limit = max(0.1, params.solve_options.y);
    if (speed > velocity_limit) {
        velocity *= velocity_limit / speed;
    }
    particle_velocities.values[particle_id] = vec4(velocity, 0.0, 0.0);
}
