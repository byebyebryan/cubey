#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"
#include "water_2d_grid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = WATER2D_BINDING_PRESSURE_A, std430) buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_B, std430) buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = WATER2D_BINDING_DIVERGENCE, std430) readonly buffer DivergenceField {
    float values[];
} divergence;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;

WATER2D_SIMULATION_PARAMS;

bool solid_cell(int x, int y, uint width, uint height) {
    if (!in_bounds(x, y, width, height)) {
        return true;
    }
    return solid.values[cell_index(uint(x), uint(y), width)] > 0.5;
}

bool liquid_cell(int x, int y, uint width, uint height) {
    if (!in_bounds(x, y, width, height)) {
        return false;
    }
    uint index = cell_index(uint(x), uint(y), width);
    return solid.values[index] < 0.5 && cell_counts.values[index] > 0u;
}

float read_pressure(int x, int y, uint width, uint height, bool read_b) {
    if (!liquid_cell(x, y, width, height)) {
        return 0.0;
    }
    uint index = cell_index(uint(x), uint(y), width);
    return read_b ? pressure_b.values[index] : pressure_a.values[index];
}

void main() {
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }

    uint index = cell_index(x, y, width);
    bool read_b = WATER2D_PRESSURE_READ_B > 0.5;
    bool center_liquid = liquid_cell(int(x), int(y), width, height);
    if (!center_liquid) {
        if (read_b) {
            pressure_a.values[index] = 0.0;
        } else {
            pressure_b.values[index] = 0.0;
        }
        return;
    }

    float x_weight = float(width) * float(width);
    float y_weight = float(height) * float(height);
    float sum = 0.0;
    float diagonal = 0.0;
    ivec2 center = ivec2(int(x), int(y));
    if (!solid_cell(center.x - 1, center.y, width, height)) {
        diagonal += x_weight;
        sum += read_pressure(center.x - 1, center.y, width, height, read_b) * x_weight;
    }
    if (!solid_cell(center.x + 1, center.y, width, height)) {
        diagonal += x_weight;
        sum += read_pressure(center.x + 1, center.y, width, height, read_b) * x_weight;
    }
    if (!solid_cell(center.x, center.y - 1, width, height)) {
        diagonal += y_weight;
        sum += read_pressure(center.x, center.y - 1, width, height, read_b) * y_weight;
    }
    if (!solid_cell(center.x, center.y + 1, width, height)) {
        diagonal += y_weight;
        sum += read_pressure(center.x, center.y + 1, width, height, read_b) * y_weight;
    }

    float value = diagonal > 0.0 ? (sum - divergence.values[index]) / diagonal : 0.0;
    if (read_b) {
        pressure_a.values[index] = value;
    } else {
        pressure_b.values[index] = value;
    }
}
