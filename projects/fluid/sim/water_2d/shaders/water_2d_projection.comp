#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"
#include "water_2d_grid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = WATER2D_BINDING_U_FIELD, std430) buffer UField {
    float values[];
} u_field;
layout(set = 0, binding = WATER2D_BINDING_V_FIELD, std430) buffer VField {
    float values[];
} v_field;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_A, std430) readonly buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_B, std430) readonly buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) readonly buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) readonly buffer CellCounts {
    uint values[];
} cell_counts;

WATER2D_SIMULATION_PARAMS;

bool solid_cell(int x, int y, uint width, uint height) {
    if (!in_bounds(x, y, width, height)) {
        return true;
    }
    return solid.values[cell_index(uint(x), uint(y), width)] > 0.5;
}

bool liquid_cell(int x, int y, uint width, uint height) {
    if (!in_bounds(x, y, width, height)) {
        return false;
    }
    uint index = cell_index(uint(x), uint(y), width);
    return solid.values[index] < 0.5 && cell_counts.values[index] > 0u;
}

float read_pressure(int x, int y, uint width, uint height, bool read_b) {
    if (!liquid_cell(x, y, width, height)) {
        return 0.0;
    }
    uint index = cell_index(uint(x), uint(y), width);
    return read_b ? pressure_b.values[index] : pressure_a.values[index];
}

void main() {
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    bool read_b = WATER2D_PRESSURE_READ_B > 0.5;
    float velocity_limit = max(0.1, params.solve_options.y);

    if (x <= width && y < height) {
        uint index = u_index(x, y, width);
        bool blocked = x == 0u || x == width || solid_cell(int(x) - 1, int(y), width, height) ||
                       solid_cell(int(x), int(y), width, height);
        bool face_has_liquid = liquid_cell(int(x) - 1, int(y), width, height) ||
                               liquid_cell(int(x), int(y), width, height);
        if (blocked || !face_has_liquid) {
            u_field.values[index] = 0.0;
        } else {
            float left = read_pressure(int(x) - 1, int(y), width, height, read_b);
            float right = read_pressure(int(x), int(y), width, height, read_b);
            u_field.values[index] =
                clamp(u_field.values[index] - ((right - left) * float(width)), -velocity_limit,
                      velocity_limit);
        }
    }

    if (x < width && y <= height) {
        uint index = v_index(x, y, width);
        bool blocked = y == 0u || y == height || solid_cell(int(x), int(y) - 1, width, height) ||
                       solid_cell(int(x), int(y), width, height);
        bool face_has_liquid = liquid_cell(int(x), int(y) - 1, width, height) ||
                               liquid_cell(int(x), int(y), width, height);
        if (blocked || !face_has_liquid) {
            v_field.values[index] = 0.0;
        } else {
            float bottom = read_pressure(int(x), int(y) - 1, width, height, read_b);
            float top = read_pressure(int(x), int(y), width, height, read_b);
            v_field.values[index] =
                clamp(v_field.values[index] - ((top - bottom) * float(height)), -velocity_limit,
                      velocity_limit);
        }
    }
}
