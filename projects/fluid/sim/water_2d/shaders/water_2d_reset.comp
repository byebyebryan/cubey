#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"
#include "water_2d_grid.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER2D_BINDING_PARTICLE_POSITIONS, std430) buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;
layout(set = 0, binding = WATER2D_BINDING_U_FIELD, std430) buffer UField {
    float values[];
} u_field;
layout(set = 0, binding = WATER2D_BINDING_U_PREVIOUS, std430) buffer UPreviousField {
    float values[];
} u_previous;
layout(set = 0, binding = WATER2D_BINDING_V_FIELD, std430) buffer VField {
    float values[];
} v_field;
layout(set = 0, binding = WATER2D_BINDING_V_PREVIOUS, std430) buffer VPreviousField {
    float values[];
} v_previous;
layout(set = 0, binding = WATER2D_BINDING_U_WEIGHT, std430) buffer UWeightField {
    float values[];
} u_weight;
layout(set = 0, binding = WATER2D_BINDING_V_WEIGHT, std430) buffer VWeightField {
    float values[];
} v_weight;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_A, std430) buffer PressureAField {
    float values[];
} pressure_a;
layout(set = 0, binding = WATER2D_BINDING_PRESSURE_B, std430) buffer PressureBField {
    float values[];
} pressure_b;
layout(set = 0, binding = WATER2D_BINDING_DIVERGENCE, std430) buffer DivergenceField {
    float values[];
} divergence;
layout(set = 0, binding = WATER2D_BINDING_SOLID, std430) buffer SolidField {
    float values[];
} solid;
layout(set = 0, binding = WATER2D_BINDING_CELL_COUNTS, std430) buffer CellCounts {
    uint values[];
} cell_counts;
layout(set = 0, binding = WATER2D_BINDING_CELL_PARTICLE_INDICES, std430) buffer CellParticleIndices {
    uint values[];
} cell_particle_indices;

WATER2D_SIMULATION_PARAMS;

const uint kWater2DWallCells = 2u;
const uint kWater2DSpawnRelocationAttempts = 8u;

float hash11(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return float(value & 0x00ffffffu) / float(0x01000000u);
}

bool obstacle_cell(vec2 uv, float width, float height) {
    uint shape = uint(params.obstacle_options.w + 0.5);
    if (shape == 0u) {
        return false;
    }
    if (shape == 1u) {
        vec2 obstacle_delta = (uv - params.obstacle_options.xy) * vec2(width / height, 1.0);
        return dot(obstacle_delta, obstacle_delta) <
               params.obstacle_options.z * params.obstacle_options.z;
    }
    vec2 half_size = max(params.obstacle_extents.xy, vec2(0.001));
    vec2 box_delta = abs(uv - params.obstacle_options.xy);
    return box_delta.x < half_size.x && box_delta.y < half_size.y;
}

vec2 spawn_position(uint cell, uint sub_particle, uint fill_cols, uint fill_rows,
                    uint particles_per_cell, uint start_x, uint start_y, vec2 jitter,
                    uint width, uint height) {
    uint cx = cell % fill_cols;
    uint cy = (cell / fill_cols) % fill_rows;
    uint strata = uint(ceil(sqrt(float(particles_per_cell))));
    uint sx = sub_particle % strata;
    uint sy = (sub_particle / strata) % strata;
    vec2 strata_offset = (vec2(sx, sy) + vec2(0.32, 0.68)) / float(strata);
    vec2 cell_position = vec2(start_x + cx, start_y + cy) +
                         clamp(strata_offset + jitter, vec2(0.10), vec2(0.90));
    return cell_position / vec2(width, height);
}

bool relocate_spawn_outside_obstacle(inout vec2 position, uint id, uint logical_cell,
                                     uint sub_particle, uint fill_cols, uint fill_rows,
                                     uint particles_per_cell, uint start_x, uint start_y,
                                     vec2 jitter, uint width, uint height) {
    if (!obstacle_cell(position, float(width), float(height))) {
        return true;
    }
    uint fill_cell_count = max(1u, fill_cols * fill_rows);
    uint stride = 17u + (id % 29u);
    for (uint attempt = 0u; attempt < kWater2DSpawnRelocationAttempts; ++attempt) {
        uint candidate_cell = (logical_cell + ((attempt + 1u) * stride)) % fill_cell_count;
        vec2 candidate = spawn_position(candidate_cell, sub_particle, fill_cols, fill_rows,
                                        particles_per_cell, start_x, start_y, jitter, width,
                                        height);
        if (!obstacle_cell(candidate, float(width), float(height))) {
            position = candidate;
            return true;
        }
    }
    return false;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint active_particle_count = uint(WATER2D_ACTIVE_PARTICLE_COUNT + 0.5);
    uint particle_capacity = uint(WATER2D_PARTICLE_CAPACITY + 0.5);
    uint max_particles_per_cell = uint(params.particle_options.y + 0.5);
    uint particles_per_cell = max(1u, uint(params.particle_options.z + 0.5));
    uint scenario = uint(params.init_options.w + 0.5);
    uint cell_count = width * height;
    uint u_count = (width + 1u) * height;
    uint v_count = width * (height + 1u);
    uint bin_count = cell_count * max_particles_per_cell;

    if (id < active_particle_count) {
        uint fill_cols = clamp(uint(floor(params.init_options.y * float(width))), 1u,
                               max(1u, width - (kWater2DWallCells * 2u)));
        uint fill_rows = clamp(uint(floor(params.init_options.x * float(height))), 1u,
                               max(1u, height - (kWater2DWallCells * 2u)));
        uint logical_cell = id / particles_per_cell;
        uint sub_particle = id % particles_per_cell;
        uint cx = logical_cell % fill_cols;
        uint cy = (logical_cell / fill_cols) % fill_rows;
        uint strata = uint(ceil(sqrt(float(particles_per_cell))));
        vec2 jitter =
            (vec2(hash11(id * 2u + 17u), hash11(id * 2u + 31u)) - vec2(0.5)) *
            (0.22 / float(strata));
        uint start_x =
            scenario == 2u ? max(kWater2DWallCells, (width - fill_cols) / 2u) :
                             kWater2DWallCells;
        uint start_y = kWater2DWallCells;
        vec2 position = spawn_position(logical_cell, sub_particle, fill_cols, fill_rows,
                                       particles_per_cell, start_x, start_y, jitter, width,
                                       height);
        bool spawn_active = relocate_spawn_outside_obstacle(position, id, logical_cell,
                                                           sub_particle, fill_cols, fill_rows,
                                                           particles_per_cell, start_x, start_y,
                                                           jitter, width, height);
        float release_edge = smoothstep(float(fill_cols) * 0.68, float(fill_cols) * 0.98,
                                        float(cx));
        vec2 velocity = vec2(0.10 * release_edge, 0.0);
        if (scenario == 1u) {
            float vertical_variation =
                sin((float(cy) / max(1.0, float(fill_rows))) * 6.28318 + hash11(id) * 0.4);
            velocity = vec2(0.42 + 0.32 * release_edge, 0.06 * vertical_variation);
        } else if (scenario == 2u) {
            float wave = sin((float(cx) / max(1.0, float(fill_cols))) * 6.28318);
            velocity = vec2(0.44 * wave, 0.08 * cos(wave * 2.2));
        }
        particle_positions.values[id] =
            spawn_active ? vec4(position, 0.0, 1.0) : vec4(-10.0, -10.0, 0.0, 0.0);
        particle_velocities.values[id] = spawn_active ? vec4(velocity, 0.0, 0.0) : vec4(0.0);
        particle_affine.values[id] = vec4(0.0);
    } else if (id < particle_capacity) {
        particle_positions.values[id] = vec4(-10.0, -10.0, 0.0, 0.0);
        particle_velocities.values[id] = vec4(0.0);
        particle_affine.values[id] = vec4(0.0);
    }

    if (id < cell_count) {
        uint x = id % width;
        uint y = id / width;
        vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(width, height);
        bool border = x < kWater2DWallCells || y < kWater2DWallCells ||
                      x + (kWater2DWallCells + 1u) > width ||
                      y + (kWater2DWallCells + 1u) > height;
        float solid_value = (border || obstacle_cell(uv, float(width), float(height))) ? 1.0 : 0.0;
        pressure_a.values[id] = 0.0;
        pressure_b.values[id] = 0.0;
        divergence.values[id] = 0.0;
        solid.values[id] = solid_value;
        cell_counts.values[id] = 0u;
    }

    if (id < u_count) {
        u_field.values[id] = 0.0;
        u_previous.values[id] = 0.0;
        u_weight.values[id] = 0.0;
    }
    if (id < v_count) {
        v_field.values[id] = 0.0;
        v_previous.values[id] = 0.0;
        v_weight.values[id] = 0.0;
    }
    if (id < bin_count) {
        cell_particle_indices.values[id] = WATER2D_EMPTY_PARTICLE;
    }
}
