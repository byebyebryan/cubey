#version 450
#extension GL_GOOGLE_include_directive : require

#include "water_2d_contract.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = WATER2D_BINDING_PARTICLE_POSITIONS, std430) buffer ParticlePositions {
    vec4 values[];
} particle_positions;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_VELOCITIES, std430) buffer ParticleVelocities {
    vec4 values[];
} particle_velocities;
layout(set = 0, binding = WATER2D_BINDING_PARTICLE_AFFINE, std430) buffer ParticleAffine {
    vec4 values[];
} particle_affine;

WATER2D_SIMULATION_PARAMS;

bool collide_axis(inout float position, inout float velocity, float minimum, float maximum,
                  float restitution) {
    if (position < minimum) {
        position = minimum;
        if (velocity < 0.0) {
            velocity = -velocity * restitution;
        }
        return true;
    }
    if (position > maximum) {
        position = maximum;
        if (velocity > 0.0) {
            velocity = -velocity * restitution;
        }
        return true;
    }
    return false;
}

bool collide_circle_obstacle(inout vec2 position, inout vec2 velocity, float width, float height,
                             float restitution, float friction) {
    float aspect = width / height;
    vec2 scaled_delta = (position - params.obstacle_options.xy) * vec2(aspect, 1.0);
    float distance = length(scaled_delta);
    float radius = params.obstacle_options.z;
    if (distance >= radius) {
        return false;
    }

    vec2 scaled_normal = distance > 0.00001 ? scaled_delta / distance : vec2(0.0, 1.0);
    position = params.obstacle_options.xy + vec2(scaled_normal.x / aspect, scaled_normal.y) *
                                              (radius + 0.0025);
    vec2 normal = normalize(vec2(scaled_normal.x * aspect, scaled_normal.y));
    float inward = dot(velocity, normal);
    if (inward < 0.0) {
        velocity -= normal * inward * (1.0 + restitution);
    }
    velocity *= friction;
    return true;
}

bool collide_box_obstacle(inout vec2 position, inout vec2 velocity, float restitution,
                          float friction) {
    vec2 half_size = max(params.obstacle_extents.xy, vec2(0.001));
    vec2 delta = position - params.obstacle_options.xy;
    vec2 overlap = half_size - abs(delta);
    if (overlap.x <= 0.0 || overlap.y <= 0.0) {
        return false;
    }

    if (overlap.x < overlap.y) {
        float side = delta.x < 0.0 ? -1.0 : 1.0;
        position.x = params.obstacle_options.x + side * (half_size.x + 0.0025);
        if (velocity.x * side < 0.0) {
            velocity.x = -velocity.x * restitution;
        }
    } else {
        float side = delta.y < 0.0 ? -1.0 : 1.0;
        position.y = params.obstacle_options.y + side * (half_size.y + 0.0025);
        if (velocity.y * side < 0.0) {
            velocity.y = -velocity.y * restitution;
        }
    }
    velocity *= friction;
    return true;
}

bool collide_obstacle(inout vec2 position, inout vec2 velocity, float width, float height) {
    uint shape = uint(params.obstacle_options.w + 0.5);
    float restitution = clamp(params.obstacle_extents.z, 0.0, 1.0);
    float friction = clamp(params.obstacle_extents.w, 0.0, 1.0);
    if (shape == 1u) {
        return collide_circle_obstacle(position, velocity, width, height, restitution, friction);
    } else if (shape == 2u) {
        return collide_box_obstacle(position, velocity, restitution, friction);
    }
    return false;
}

void clamp_velocity(inout vec2 velocity) {
    float velocity_limit = max(0.1, params.solve_options.y);
    float speed = length(velocity);
    if (speed > velocity_limit) {
        velocity *= velocity_limit / speed;
    }
}

bool inside_drain(vec2 position) {
    if (params.drain_options.x < 0.5) {
        return false;
    }
    vec2 half_size = max(params.drain_extents.xy, vec2(0.001));
    return all(lessThan(abs(position - params.drain_options.yz), half_size));
}

void main() {
    uint particle_id = gl_GlobalInvocationID.x;
    uint width = uint(WATER2D_GRID_WIDTH);
    uint height = uint(WATER2D_GRID_HEIGHT);
    uint particle_count =
        min(uint(WATER2D_PARTICLE_SCAN_COUNT + 0.5), uint(WATER2D_PARTICLE_CAPACITY + 0.5));
    if (particle_id >= particle_count) {
        return;
    }
    if (particle_positions.values[particle_id].w < 0.5) {
        return;
    }

    float dt = WATER2D_DT;
    float restitution = clamp(params.obstacle_extents.z, 0.0, 1.0);
    float damping = clamp(params.solve_options.z, 0.0, 1.0);
    vec2 position = particle_positions.values[particle_id].xy;
    vec2 velocity = particle_velocities.values[particle_id].xy;
    position += velocity * dt;

    vec2 margin = vec2(2.25 / float(width), 2.25 / float(height));
    bool collided = false;
    collided = collide_axis(position.x, velocity.x, margin.x, 1.0 - margin.x, restitution) ||
               collided;
    collided = collide_axis(position.y, velocity.y, margin.y, 1.0 - margin.y, restitution) ||
               collided;
    collided = collide_obstacle(position, velocity, float(width), float(height)) || collided;
    clamp_velocity(velocity);
    if (inside_drain(position)) {
        particle_positions.values[particle_id] = vec4(-10.0, -10.0, 0.0, 0.0);
        particle_velocities.values[particle_id] = vec4(0.0);
        particle_affine.values[particle_id] = vec4(0.0);
        return;
    }
    if (collided) {
        particle_affine.values[particle_id] = vec4(0.0);
    }

    particle_positions.values[particle_id] = vec4(position, 0.0, 1.0);
    particle_velocities.values[particle_id] = vec4(velocity * damping, 0.0, 0.0);
}
