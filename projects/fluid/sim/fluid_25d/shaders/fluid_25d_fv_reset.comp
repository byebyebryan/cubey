#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer InitialDepthField {
    float values[];
}
initial_depth;
layout(set = 0, binding = 1, std430) buffer DepthAField {
    float values[];
}
depth_a;
layout(set = 0, binding = 2, std430) buffer DepthBField {
    float values[];
}
depth_b;
layout(set = 0, binding = 3, std430) buffer MomentumAField {
    vec4 values[];
}
momentum_a;
layout(set = 0, binding = 4, std430) buffer MomentumBField {
    vec4 values[];
}
momentum_b;
layout(set = 0, binding = 5, std430) buffer VelocityField {
    vec4 values[];
}
velocity;
layout(set = 0, binding = 6, std430) buffer LedgerField {
    vec4 values[];
}
ledger;
layout(set = 0, binding = 7, std430) buffer StatusField {
    uint flags;
    uint max_x_speed_bits;
    uint max_y_speed_bits;
    uint reserved;
}
status;
layout(set = 0, binding = 8, std430) buffer TracerQAField {
    float values[];
}
tracer_q_a;
layout(set = 0, binding = 9, std430) buffer TracerQBField {
    float values[];
}
tracer_q_b;
layout(set = 0, binding = 10, std430) buffer TracerLedgerField {
    vec4 values[];
}
tracer_ledger;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_cell;
    vec4 physics;
}
params;

void main() {
    uint width = uint(params.grid_dt_cell.x);
    uint height = uint(params.grid_dt_cell.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }
    uint index = y * width + x;
    float depth = initial_depth.values[index];
    depth_a.values[index] = depth;
    depth_b.values[index] = depth;
    momentum_a.values[index] = vec4(0.0);
    momentum_b.values[index] = vec4(0.0);
    velocity.values[index] = vec4(0.0, 0.0, depth > params.physics.z ? 1.0 : 0.0, 0.0);
    ledger.values[index] = vec4(0.0);
    tracer_q_a.values[index] = 0.0;
    tracer_q_b.values[index] = 0.0;
    tracer_ledger.values[index] = vec4(0.0);
    if (index == 0u) {
        status.flags = 0u;
        status.max_x_speed_bits = 0u;
        status.max_y_speed_bits = 0u;
        status.reserved = 0u;
    }
}
