#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_25d_daylight.glsl"
#include "cubey/atmosphere/sky_background_direction.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Input { vec4 coefficients[10]; } input_light;
layout(set=0,binding=1,std430) writeonly buffer Output { vec4 values[18]; } output_light;
void main() {
    vec3 normals[8]=vec3[8](vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),
        vec3(0,0,1),vec3(0,0,-1),normalize(vec3(1,2,3)),normalize(vec3(-3,1,-2)));
    for(int n=0;n<8;++n) {
        vec3 value=vec3(0);
        for(int i=0;i<9;++i) value+=input_light.coefficients[i].rgb*fluid25d_sh_basis(i,normals[n]);
        output_light.values[n]=vec4(value,0);
    }
    vec3 rays[6]=vec3[6](normalize(vec3(1,0.4,0)),normalize(vec3(1,-0.4,0)),
        vec3(0,1,0),vec3(0,-1,0),normalize(vec3(1,0.00001,0)),normalize(vec3(1,-0.00001,0)));
    for(int i=0;i<6;++i)
        output_light.values[8+i]=vec4(sky_background_sample_direction(rays[i],vec3(0,1,0),vec3(0)),0);
    output_light.values[14]=vec4(fluid25d_receiver_plane_gradient(vec3(0.2,0.1,0.005),
        vec3(-0.1,0.3,-0.01)),0,0);
    output_light.values[15]=vec4(fluid25d_receiver_plane_gradient(vec3(1,1,1),vec3(2,2,2)),0,0);
    for(int k=0;k<2;++k) {
        float sum=0, fraction=k==0 ? 0.0 : 0.37;
        for(int i=-1;i<=2;++i) sum+=fluid25d_shadow_tent(float(i)-fraction);
        output_light.values[16+k]=vec4(sum,0,0,0);
    }
}
