    }
    for (uint i=0; i<64; ++i) {
        uint pair=i%32u;
        float offset=float(pair/4u)/8.0;
        vec2 p=vec2(6.0+float(pair%4u)+offset,7.05-float(pair%4u)-offset);
        if (pair>=28u) p=vec2(pair%2u==0u ? -0.5 : 15.5,
