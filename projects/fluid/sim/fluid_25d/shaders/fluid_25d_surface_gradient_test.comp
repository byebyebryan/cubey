#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_25d_surface_gradient.glsl"
#include "fluid_25d_water_detail.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) writeonly buffer Result { vec4 values[]; } result;
const vec3 normals[16] = vec3[16](
    vec3(0,1,0),vec3(1,0,0),vec3(-1,0,0),vec3(0,0,1),vec3(0,0,-1),vec3(0,-1,0),
    vec3(0.3,1,0.6),vec3(-0.3,1,-0.6),
    vec3(0.70711,0.70710,0),vec3(0.70709,0.70710,0),
    vec3(1.00001,1,1),vec3(0.99999,1,1),
    vec3(0.99,0.01,0),vec3(-0.99,0.01,0),vec3(0.01,0.01,0.99),vec3(0.01,0.01,-0.99));
void main() {
    for (uint mode=0; mode<5; ++mode) {
        for (uint i=0; i<16; ++i) {
            vec3 n = normalize(normals[i]);
            vec3 weights = pow(abs(n),vec3(4)); weights /= dot(weights,vec3(1));
            vec2 x = normalize(vec3(-0.3,0.1,1)).xy*0.5+0.5;
            vec2 y = normalize(vec3(-0.2,-0.3,1)).xy*0.5+0.5;
            vec2 z = normalize(vec3(-0.2,0.1,1)).xy*0.5+0.5;
            if (mode==2) { x=vec2(0.5); y=x; z=x; }
            if (mode==4) { x=vec2(0); y=x; z=x; }
            vec3 gradient = fluid25d_triplanar_surface_gradient(n,weights,
                fluid25d_normal_derivative(x),fluid25d_normal_derivative(y),fluid25d_normal_derivative(z));
            float strength = mode==1 ? 0.0 : mode==4 ? 2.0 : 0.12;
            strength *= fluid25d_detail_fade(mode==3 ? 72.0 : 18.0);
            result.values[mode*16+i] = vec4(fluid25d_resolve_surface_normal(n,gradient,strength),dot(n,gradient));
        }
    }
    result.values[80] = vec4(fluid25d_wet_surface_normal(10.0,vec4(10),bvec4(true),2.0,0.4),0);
    result.values[81] = vec4(fluid25d_wet_surface_normal(10.0,vec4(300,10,10,300),
                                            bvec4(false,true,true,false),2.0,0.4),0);
    result.values[82] = vec4(fluid25d_wet_surface_normal(10.0,vec4(8,12,7,13),
                                            bvec4(true),2.0,0.4),0);
    result.values[83] = vec4(fluid25d_wet_surface_normal(10.0,vec4(8,400,7,400),
                                            bvec4(true,false,true,false),2.0,0.4),0);
    result.values[84] = vec4(fluid25d_wet_surface_normal(10.0,vec4(400,12,7,400),
                                            bvec4(false,true,true,false),2.0,0.4),0);
    result.values[85] = vec4(fluid25d_wet_surface_normal(10.0,vec4(400),bvec4(false),2.0,0.4),0);
    for (uint i=0; i<16; ++i) {
        float footprint = float(i%4)*16.0;
        float clock = i<8 ? 0.0 : 1024.0;
        float strength = i%8<4 ? 0.12 : 0.0;
        result.values[86+i] = vec4(fluid25d_ripple_detail(vec2(0),clock,footprint,48.0,strength,vec3(0)),0);
    }
}
