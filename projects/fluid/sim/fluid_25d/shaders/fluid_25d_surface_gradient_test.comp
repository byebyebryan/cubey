    const float wet_depths[16]=float[16](-0.01,0.0,0.001,0.002,0.003,0.006,0.012,
        0.02,0.03,0.04,0.049,0.05,0.06,0.2,1.0,52.0);
    for (uint i=0; i<16; ++i)
        result.values[1030u+i]=vec4(fluid25d_terrain_wet_weight(wet_depths[i],0.002),0,0,0);
}
