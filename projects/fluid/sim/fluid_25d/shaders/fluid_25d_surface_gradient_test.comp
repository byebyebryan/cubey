            vec2(weight,1.0-weight),patchiness[i/20u],vec3(0.005)),0,0,0);
    }
    for (uint i=0; i<16; ++i) {
        vec2 p=vec2(float(i)*37.0-280.0,float(i)*53.0-430.0);
        vec3 a=fluid25d_stream_foam_domain(p);
        vec3 b=fluid25d_stream_foam_domain(p+vec2(64,0));
        vec3 c=fluid25d_stream_foam_domain(p+vec2(0,64));
        result.values[598u+i]=vec4(a.z,b.z,length(b.xy-a.xy-vec2(0.96,-0.28)),
                                                  length(c.xy-a.xy-vec2(0.28,0.96)));
        float weight=float(i%5u)/4.0;
        vec2 envelope=vec2(float(i%4u)/3.0,float(i/4u)/3.0);
        result.values[614u+i]=vec4(fluid25d_stream_foam_shape(vec2(0.8,0.8),
            vec2(weight,1.0-weight),1.0,vec3(0.005),envelope),0,0,0);
    }
    for (uint i=0; i<16; ++i) {
        float angle=float(i)*0.37;
        vec2 dx=vec2(cos(angle),sin(angle))*float(i%4u+1u);
        vec2 dy=vec2(-sin(angle),cos(angle))*0.7;
        if (i==15u) dy=dx*2.0;
        vec2 target=vec2(0.2,-0.3);
        result.values[630u+i]=vec4(fluid25d_bank_gradient(dx,dy,dot(dx,target),dot(dy,target)),0,0);
        float peak=float(i%4u)*0.08;
        vec2 gradient=i<8u || i>=12u ? vec2(0.001,0) : vec2(0);
        result.values[646u+i]=vec4(fluid25d_bank_support(peak,gradient,30),0,0,0);
    }
    for (uint i=0; i<64; ++i) {
        uint mode=i%8u;
        vec4 controls=mode==0u ? vec4(0,0,48,12) : vec4(3,1,48,12);
        float local_depth=mode==2u ? 0.0 : mode==3u ? 0.03 : mode==4u ? 10.0 : 0.3;
        vec2 gradient=mode==1u || mode==5u ? vec2(0) : mode==3u ? vec2(0.001,0) : vec2(0.2,0);
        result.values[662u+i]=vec4(fluid25d_bank_inset(vec2(17.3,-29.2),local_depth,gradient,
            vec2(2,0),float(i/8u)*0.5,mode==6u ? 128.0 : 0.5,30.0,0.002,controls),0,0);
    }
    for (uint i=0; i<16; ++i) {
        vec2 p=vec2(float(i)*37.0-280.0,float(i)*53.0-430.0);
        float a=fluid25d_bank_moving_noise(p,vec2(3,-2),0.0,48.0);
        float b=fluid25d_bank_moving_noise(p,vec2(3,-2),1024.0,48.0);
        float c=fluid25d_bank_moving_noise(p,vec2(3,-2),7.999,48.0);
        float d=fluid25d_bank_moving_noise(p,vec2(3,-2),8.001,48.0);
        result.values[726u+i]=vec4(a,b,c,d);
        vec2 first=fluid25d_bank_inset(p,0.3,vec2(0.2,0),vec2(0),0,
                                      0.5,30,0.002,vec4(3,1,48,12));
        vec2 second=fluid25d_bank_inset(p,0.3,vec2(0.2,0),vec2(0),float(i),
                                       0.5,30,0.002,vec4(3,1,48,12));
        result.values[742u+i]=vec4(first,second);
    }
    for (uint i=0; i<32; ++i) {
        vec2 p=vec2(float(i)*17.0-240.0,float(i)*23.0-370.0);
