        float h=i<16u ? 0.03 : 0.3;
        vec2 gradient=i<8u ? vec2(0) : i<16u ? vec2(0.001,0) : vec2(0.2,0);
        vec2 bold=fluid25d_bank_inset(p,h,gradient,vec2(2,0),0,0.5,30,0.002,controls);
        vec2 later=fluid25d_bank_inset(p,h,gradient,vec2(2,0),4,0.5,30,0.002,controls);
        result.values[758u+i]=vec4(bold,later);
    }
    for (uint i=0; i<128; ++i) {
        // Pairs straddle native grid lines, refined half-cell lines, and mesh
        // diagonals. Sample the production cubic helper, not a test surrogate.
        uint pair=(i%64u)/2u;
        vec2 p=vec2(6.0+float(pair%4u),9.0-float(pair%4u)+0.25);
        if (pair>=8u && pair<16u) p=p.yx;
        if (pair>=16u && pair<24u) p=vec2(7.5,7.75);
        if (pair>=24u) p=vec2(7.75,7.75);
        float epsilon=(i%2u==0u ? -1.0 : 1.0)*(i<64u ? 0.0001 : 0.00001);
        p+=pair>=8u && pair<16u ? vec2(0,epsilon) : vec2(epsilon,0);
