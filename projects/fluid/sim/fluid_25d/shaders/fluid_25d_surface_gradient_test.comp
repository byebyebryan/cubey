        float h=fluid25d_terrain_wet_depth(p,uvec2(16),i>=32u);
        float wet=fluid25d_terrain_wet_weight(h,0.002);
        result.values[918u+i]=vec4(h,wet,mix(1.0,0.86,wet),mix(0.94,0.78,wet));
    }
    for (uint i=0; i<48; ++i) {
        uint pair=(i%24u)/2u;
        vec2 p=vec2(6.0+float(pair%4u),7.05-float(pair%4u));
        if (pair>=4u && pair<8u) p=p.yx;
        if (pair>=8u) p=pair<10u ? vec2(6.5,6.55) : vec2(6.525);
        float epsilon=(i%2u==0u ? -1.0 : 1.0)*(i<24u ? 0.001 : 0.0001);
        p+=pair>=4u && pair<8u ? vec2(0,epsilon) : vec2(epsilon,0);
        float h=fluid25d_terrain_wet_depth(p,uvec2(16),true);
        float wet=fluid25d_terrain_wet_weight(h,0.002);
        result.values[982u+i]=vec4(h,wet,mix(1.0,0.86,wet),mix(0.94,0.78,wet));
