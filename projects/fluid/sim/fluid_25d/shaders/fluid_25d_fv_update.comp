#version 450
#extension GL_GOOGLE_include_directive : require
#include "fluid_25d_mass_audit.glsl"
#include "fluid_25d_conserved_arithmetic.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer TerrainField {
    float values[];
}
terrain;
layout(set = 0, binding = 1, std430) readonly buffer SourceRateField {
    float values[];
}
source_rate;
layout(set = 0, binding = 2, std430) readonly buffer SinkRateField {
    float values[];
}
sink_rate;
layout(set = 0, binding = 3, std430) readonly buffer BoundaryMaskField {
    uint values[];
}
boundary_mask;
layout(set = 0, binding = 4, std430) readonly buffer DepthField {
    float values[];
}
depth;
layout(set = 0, binding = 5, std430) readonly buffer MomentumField {
    vec4 values[];
}
momentum;
// Candidate h/hu/hv are the inactive ping-pong buffers. They are not
// published until the following commit dispatch observes a clean global
// status word.
layout(set = 0, binding = 6, std430) buffer CandidateDepthField {
    float values[];
}
candidate_depth;
layout(set = 0, binding = 7, std430) buffer CandidateMomentumField {
    vec4 values[];
}
candidate_momentum;
layout(set = 0, binding = 8, std430) buffer CandidateVelocityField {
    vec4 values[];
}
candidate_velocity;
layout(set = 0, binding = 9, std430) readonly buffer CumulativeLedgerField {
    vec4 values[];
}
cumulative_ledger;
layout(set = 0, binding = 10, std430) buffer CandidateLedgerDeltaField {
    vec4 values[];
}
candidate_ledger_delta;
layout(set = 0, binding = 11, std430) buffer StatusField {
    uint flags;
    uint max_x_speed_bits;
    uint max_y_speed_bits;
    uint reserved;
}
status;
layout(set = 0, binding = 12, std430) readonly buffer TracerQField {
    float values[];
}
tracer_q;
layout(set = 0, binding = 13, std430) buffer CandidateTracerQField {
    float values[];
}
candidate_tracer_q;
layout(set = 0, binding = 14, std430) readonly buffer CumulativeTracerLedgerField {
    vec4 values[];
}
cumulative_tracer_ledger;
layout(set = 0, binding = 15, std430) buffer CandidateTracerLedgerDeltaField {
    vec4 values[];
}
candidate_tracer_ledger_delta;
layout(set = 0, binding = 16, std430) buffer CandidateMassAuditField {
    MassAudit values[];
}
candidate_mass_audit;
layout(set = 0, binding = 17, std430) readonly buffer ConservationResidualField {
    ConservationResidual values[];
}
conservation_residual;
layout(set = 0, binding = 18, std430) buffer CandidateConservationResidualField {
    ConservationResidual values[];
}
candidate_conservation_residual;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_cell;
    vec4 physics;
    // x is the outer-fixed-step source concentration; hydraulic forcing
    // remains physics.w and every solver substep uses this same pulse value.
    vec4 dye;
}
params;

const uint LEFT = 0u;
const uint RIGHT = 1u;
const uint DOWN = 2u;
const uint UP = 3u;
const uint CFL_REJECTED = 1u << 0u;
const uint INVALID_STATE = 1u << 1u;
const uint CLOSED_BOUNDARY_MASS = 1u << 2u;
const uint OPEN_BOUNDARY_INFLOW = 1u << 3u;
const float DEPTH_ROUNDING_RESIDUE = 1.0e-7;

struct State {
    float h;
    vec2 q;
};
struct SourceSinkState {
    State state;
    float source_added_h;
    float removed_h;
    float tracer_q;
    float source_added_tracer_q;
    float removed_tracer_q;
    float sourced_h;
    float sourced_tracer_q;
    float h_tail;
    float tracer_tail;
};
struct FaceFlux {
    State homogeneous;
    State left_pressure_correction;
    State right_pressure_correction;
};

bool finite_float(float value) {
    return !isnan(value) && !isinf(value);
}
bool finite_state(State value) {
    return finite_float(value.h) && value.h >= 0.0 && finite_float(value.q.x) &&
           finite_float(value.q.y);
}
bool finite_flux(State value) {
    return finite_float(value.h) && finite_float(value.q.x) && finite_float(value.q.y);
}
bool finite_nonnegative_ledger(vec4 value) {
    return finite_float(value.x) && finite_float(value.y) && finite_float(value.z) &&
           finite_float(value.w) && value.x >= 0.0 && value.y >= 0.0 && value.z >= 0.0 &&
           value.w == 0.0;
}
bool finite_tracer_q(float q, float h) {
    return finite_float(q) && q >= -DEPTH_ROUNDING_RESIDUE && finite_float(h) && h >= 0.0 &&
           q <= h + DEPTH_ROUNDING_RESIDUE;
}
float tracer_concentration(float q, float h) {
    return h > 0.0 ? clamp(q / h, 0.0, 1.0) : 0.0;
}
uint cell_index(uint x, uint y, uint width) {
    return y * width + x;
}
State add_state(State left, State right) {
    return State(left.h + right.h, left.q + right.q);
}
float normal_velocity(State value, vec2 normal) {
    return value.h == 0.0 ? 0.0 : dot(value.q, normal) / value.h;
}
State physical_flux(State value, vec2 normal, float gravity) {
    float normal_speed = normal_velocity(value, normal);
    float pressure = 0.5 * gravity * value.h * value.h;
    return State(value.h * normal_speed, value.q * normal_speed + pressure * normal);
}
FaceFlux hydrostatic_rusanov_flux(State left, State right, float left_bed, float right_bed,
                                  vec2 normal, float gravity) {
    // Difference-first reconstruction avoids cancelling a shallow film
    // against a large absolute terrain elevation in float arithmetic.
    float left_h_star = max(0.0, left.h - max(0.0, right_bed - left_bed));
    float right_h_star = max(0.0, right.h - max(0.0, left_bed - right_bed));
    vec2 tangent = vec2(-normal.y, normal.x);
    float left_vn = normal_velocity(left, normal);
    float left_vt = normal_velocity(left, tangent);
    float right_vn = normal_velocity(right, normal);
    float right_vt = normal_velocity(right, tangent);
    State left_star = State(left_h_star, left_h_star * (left_vn * normal + left_vt * tangent));
    State right_star = State(right_h_star, right_h_star * (right_vn * normal + right_vt * tangent));
    State left_flux = physical_flux(left_star, normal, gravity);
    State right_flux = physical_flux(right_star, normal, gravity);
    float left_wave = abs(normal_velocity(left_star, normal)) + sqrt(gravity * left_star.h);
    float right_wave = abs(normal_velocity(right_star, normal)) + sqrt(gravity * right_star.h);
    float wave = max(left_wave, right_wave);
    FaceFlux result;
    result.homogeneous =
        State(0.5 * (left_flux.h + right_flux.h) - 0.5 * wave * (right_star.h - left_star.h),
              0.5 * (left_flux.q + right_flux.q) - 0.5 * wave * (right_star.q - left_star.q));
    float left_pressure = 0.5 * gravity * (left.h * left.h - left_h_star * left_h_star);
    float right_pressure = 0.5 * gravity * (right.h * right.h - right_h_star * right_h_star);
    result.left_pressure_correction = State(0.0, left_pressure * normal);
    result.right_pressure_correction = State(0.0, right_pressure * normal);
    return result;
}
SourceSinkState source_sink_state(uint index, float dt) {
    float old_h = depth.values[index];
    vec2 old_q = momentum.values[index].xy;
    float source_added_h = source_rate.values[index] * params.physics.w * dt;
    vec2 sourced_h_pair = conserved_add(
        vec2(old_h, conservation_residual.values[index].state.x), vec2(source_added_h, 0.0));
    float sourced_h = sourced_h_pair.x;
    float requested_sink_h = sink_rate.values[index] * dt;
    vec2 remaining_h_pair = conserved_add(sourced_h_pair, vec2(-requested_sink_h, 0.0));
    vec2 h_pair = conserved_nonnegative(remaining_h_pair);
    vec2 removed_h_pair = conserved_add(sourced_h_pair, -h_pair);
    float removed_h = max(0.0, removed_h_pair.x);
    float h = h_pair.x;
    float old_tracer_q = tracer_q.values[index];
    float source_added_tracer_q = source_added_h * params.dye.x;
    vec2 sourced_tracer_pair = conserved_add(
        vec2(old_tracer_q, conservation_residual.values[index].state.y),
        vec2(source_added_tracer_q, 0.0));
    float sourced_tracer_q = sourced_tracer_pair.x;
    // No removed water means no sink transfer. In particular, avoid an h/h
    // GPU division turning a mathematically unit fraction into phantom tracer
    // loss in a zero-sink scene. Actual sinks retain the proportional rule.
    float updated_tracer_q = sourced_tracer_q;
    float removed_tracer_q = 0.0;
    vec2 retained_tracer_pair = sourced_tracer_pair;
    if (removed_h > 0.0) {
        float retained_fraction = h / sourced_h;
        retained_tracer_pair = conserved_scale(sourced_tracer_pair, clamp(retained_fraction, 0.0, 1.0));
        updated_tracer_q = max(0.0, retained_tracer_pair.x);
        removed_tracer_q = max(0.0, conserved_add(sourced_tracer_pair, -retained_tracer_pair).x);
    }
    vec2 q = old_q;
    if (sourced_h > 0.0) {
        q *= h / sourced_h;
    } else {
        q = vec2(0.0);
    }
    if (h <= params.physics.z) {
        q = vec2(0.0);
    }
    return SourceSinkState(State(h, q), source_added_h, removed_h, updated_tracer_q,
                           source_added_tracer_q,
                           removed_tracer_q, sourced_h, sourced_tracer_q,
                           h_pair.y, retained_tracer_pair.y);
}

void main() {
    uint width = uint(params.grid_dt_cell.x);
    uint height = uint(params.grid_dt_cell.y);
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }
    uint index = cell_index(x, y, width);
    // Every candidate invocation writes a complete default transaction. An
    // invalid path leaves a source-state/zero-ledger candidate that commit
    // will ignore once the global sticky flag is observed.
    candidate_depth.values[index] = depth.values[index];
    candidate_momentum.values[index] = momentum.values[index];
    candidate_velocity.values[index] = vec4(0.0);
    candidate_ledger_delta.values[index] = vec4(0.0);
    candidate_tracer_q.values[index] = tracer_q.values[index];
    candidate_tracer_ledger_delta.values[index] = vec4(0.0);
    candidate_conservation_residual.values[index] = conservation_residual.values[index];
    if (params.dye.y > 0.5) {
        candidate_mass_audit.values[index] = audit_zero();
    }
    if (status.flags != 0u) {
        return;
    }

    float dt = params.grid_dt_cell.z;
    float cell_size = params.grid_dt_cell.w;
    float gravity = params.physics.x;
    float minimum_wet_depth = params.physics.z;
    SourceSinkState center_source_sink = source_sink_state(index, dt);
    State center = center_source_sink.state;
    if (!finite_float(center_source_sink.h_tail) || !finite_float(center_source_sink.tracer_tail)) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }
    if (!finite_state(center) || !finite_tracer_q(tracer_q.values[index], depth.values[index]) ||
        !finite_tracer_q(center_source_sink.tracer_q, center.h) ||
        !finite_float(center_source_sink.source_added_tracer_q) ||
        center_source_sink.source_added_tracer_q < -DEPTH_ROUNDING_RESIDUE ||
        !finite_float(center_source_sink.removed_tracer_q) ||
        center_source_sink.removed_tracer_q < -DEPTH_ROUNDING_RESIDUE) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }

    State delta = State(0.0, vec2(0.0));
    float tracer_delta = 0.0;
    float boundary_outflow_volume = 0.0;
    vec2 water_flux_sum = vec2(0.0);
    vec2 tracer_flux_sum = vec2(0.0);
    vec2 audit_water_internal = vec2(0.0);
    vec2 audit_water_boundary = vec2(0.0);
    vec2 audit_tracer_internal = vec2(0.0);
    vec2 audit_tracer_boundary = vec2(0.0);
    for (uint face = LEFT; face <= UP; ++face) {
        bool has_neighbor = (face == LEFT && x > 0u) || (face == RIGHT && x + 1u < width) ||
                            (face == DOWN && y > 0u) || (face == UP && y + 1u < height);
        vec2 normal = face == LEFT    ? vec2(-1.0, 0.0)
                      : face == RIGHT ? vec2(1.0, 0.0)
                      : face == DOWN  ? vec2(0.0, -1.0)
                                      : vec2(0.0, 1.0);
        State exterior;
        float exterior_tracer_q = 0.0;
        bool open_outflow = false;
        if (has_neighbor) {
            uint neighbor_x = x;
            uint neighbor_y = y;
            if (face == LEFT) {
                neighbor_x -= 1u;
            } else if (face == RIGHT) {
                neighbor_x += 1u;
            } else if (face == DOWN) {
                neighbor_y -= 1u;
            } else {
                neighbor_y += 1u;
            }
            SourceSinkState neighbor_source_sink =
                source_sink_state(cell_index(neighbor_x, neighbor_y, width), dt);
            exterior = neighbor_source_sink.state;
            exterior_tracer_q = neighbor_source_sink.tracer_q;
        } else {
            open_outflow = (boundary_mask.values[index] & (1u << face)) != 0u;
            if (open_outflow) {
                exterior = State(0.0, vec2(0.0));
            } else {
                float outward_velocity = normal_velocity(center, normal);
                exterior = State(center.h, center.q - 2.0 * center.h * outward_velocity * normal);
            }
        }
        if (!finite_state(exterior) || !finite_tracer_q(exterior_tracer_q, exterior.h)) {
            atomicOr(status.flags, INVALID_STATE);
            return;
        }
        FaceFlux face_flux = hydrostatic_rusanov_flux(
            center, exterior, terrain.values[index],
            has_neighbor ? terrain.values[cell_index(face == LEFT    ? x - 1u
                                                     : face == RIGHT ? x + 1u
                                                                     : x,
                                                     face == DOWN ? y - 1u
                                                     : face == UP ? y + 1u
                                                                  : y,
                                                     width)]
                         : terrain.values[index],
            normal, gravity);
        State outward = add_state(face_flux.homogeneous, face_flux.left_pressure_correction);
        // Internal Rusanov mass flux is signed relative to the current cell;
        // a negative outward flux is valid incoming transport. Only finiteness
        // is an invariant here.
        if (!finite_flux(outward)) {
            atomicOr(status.flags, INVALID_STATE);
            return;
        }
        if (!has_neighbor) {
            if (!open_outflow) {
                if (abs(outward.h) > DEPTH_ROUNDING_RESIDUE) {
                    atomicOr(status.flags, CLOSED_BOUNDARY_MASS);
                }
                outward.h = 0.0;
            } else {
                if (outward.h < -DEPTH_ROUNDING_RESIDUE) {
                    atomicOr(status.flags, OPEN_BOUNDARY_INFLOW);
                }
                outward.h = max(0.0, outward.h);
                boundary_outflow_volume += outward.h * cell_size * dt;
            }
        }
        float tracer_outward_flux = 0.0;
        if (has_neighbor) {
            const float center_concentration = tracer_concentration(center_source_sink.tracer_q,
                                                                     center.h);
            const float exterior_concentration = tracer_concentration(exterior_tracer_q, exterior.h);
            const float homogeneous_mass_flux = face_flux.homogeneous.h;
            tracer_outward_flux = homogeneous_mass_flux >= 0.0
                                      ? homogeneous_mass_flux * center_concentration
                                      : homogeneous_mass_flux * exterior_concentration;
        } else if (open_outflow) {
            tracer_outward_flux =
                outward.h * tracer_concentration(center_source_sink.tracer_q, center.h);
        }
        if (!finite_float(tracer_outward_flux)) {
            atomicOr(status.flags, INVALID_STATE);
            return;
        }
        delta.h -= outward.h;
        delta.q -= outward.q;
        tracer_delta -= tracer_outward_flux;
        water_flux_sum = conserved_add(water_flux_sum, vec2(-outward.h, 0.0));
        tracer_flux_sum = conserved_add(tracer_flux_sum, vec2(-tracer_outward_flux, 0.0));
        if (params.dye.y > 0.5) {
            // Record the actual signed face fluxes before divergence/update
            // rounding. Independent cells' internal faces should cancel.
            vec2 water_face = vec2(audit_observe(outward.h), 0.0);
            vec2 tracer_face = vec2(audit_observe(tracer_outward_flux), 0.0);
            if (has_neighbor) {
                audit_water_internal = audit_add(audit_water_internal, -water_face);
                audit_tracer_internal = audit_add(audit_tracer_internal, -tracer_face);
            } else {
                audit_water_boundary = audit_add(audit_water_boundary, water_face);
                audit_tracer_boundary = audit_add(audit_tracer_boundary, tracer_face);
            }
        }
    }

    float transport_scale = dt / cell_size;
    vec2 updated_h_pair = conserved_add(vec2(center.h, center_source_sink.h_tail),
                                        conserved_scale(water_flux_sum, transport_scale));
    float updated_h = updated_h_pair.x;
    vec2 updated_q = (center.q + transport_scale * delta.q) * exp(-params.physics.y * dt);
    if (!finite_float(updated_h) || !finite_float(updated_h_pair.y) ||
        updated_h < -DEPTH_ROUNDING_RESIDUE ||
        !finite_float(updated_q.x) || !finite_float(updated_q.y)) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }
    float preclamp_h = updated_h;
    updated_h = max(0.0, updated_h);
    updated_h_pair = conserved_nonnegative(updated_h_pair);
    vec2 updated_tracer_pair = conserved_add(
        vec2(center_source_sink.tracer_q, center_source_sink.tracer_tail),
        conserved_scale(tracer_flux_sum, transport_scale));
    float updated_tracer_q = updated_tracer_pair.x;
    if (!finite_tracer_q(updated_tracer_q, updated_h) || !finite_float(updated_tracer_pair.y)) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }
    float preclamp_tracer_q = updated_tracer_q;
    updated_tracer_q = clamp(updated_tracer_q, 0.0, updated_h);
    if (updated_tracer_pair.x < 0.0 ||
        (updated_tracer_pair.x == 0.0 && updated_tracer_pair.y < 0.0)) {
        updated_tracer_pair = vec2(0.0);
    }
    if (updated_tracer_pair.x > updated_h_pair.x ||
        (updated_tracer_pair.x == updated_h_pair.x && updated_tracer_pair.y > updated_h_pair.y)) {
        updated_tracer_pair = updated_h_pair;
    }
    updated_tracer_q = updated_tracer_pair.x;
    if (updated_h <= minimum_wet_depth) {
        updated_q = vec2(0.0);
    }
    vec2 derived_velocity = updated_h > minimum_wet_depth ? updated_q / updated_h : vec2(0.0);
    if (!finite_float(derived_velocity.x) || !finite_float(derived_velocity.y)) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }
    float cell_area = cell_size * cell_size;
    vec4 ledger_delta = vec4(center_source_sink.source_added_h * cell_area,
                             center_source_sink.removed_h * cell_area,
                             boundary_outflow_volume, 0.0);
    vec4 prospective_ledger = cumulative_ledger.values[index] + ledger_delta;
    vec4 tracer_ledger_delta = vec4(center_source_sink.source_added_tracer_q * cell_area,
                                    center_source_sink.removed_tracer_q * cell_area,
                                    boundary_outflow_volume *
                                        tracer_concentration(center_source_sink.tracer_q, center.h),
                                    0.0);
    vec4 prospective_tracer_ledger =
        cumulative_tracer_ledger.values[index] + tracer_ledger_delta;
    ConservationResidual next_residual = conservation_residual.values[index];
    next_residual.state = vec4(updated_h_pair.y, updated_tracer_pair.y, 0.0, 0.0);
    for (uint component = 0u; component < 3u; ++component) {
        vec2 water_ledger_pair = conserved_add(
            vec2(cumulative_ledger.values[index][component], next_residual.water_ledger[component]),
            vec2(ledger_delta[component], 0.0));
        vec2 tracer_ledger_pair = conserved_add(
            vec2(cumulative_tracer_ledger.values[index][component], next_residual.tracer_ledger[component]),
            vec2(tracer_ledger_delta[component], 0.0));
        prospective_ledger[component] = water_ledger_pair.x;
        prospective_tracer_ledger[component] = tracer_ledger_pair.x;
        next_residual.water_ledger[component] = water_ledger_pair.y;
        next_residual.tracer_ledger[component] = tracer_ledger_pair.y;
        if (!finite_float(water_ledger_pair.y) || !finite_float(tracer_ledger_pair.y)) {
            atomicOr(status.flags, INVALID_STATE);
            return;
        }
    }
    // Commit must not find a late validation error after some cells publish:
    // check both the delta and the prospective cumulative value here.
    if (!finite_nonnegative_ledger(ledger_delta) ||
        !finite_nonnegative_ledger(prospective_ledger) ||
        !finite_nonnegative_ledger(tracer_ledger_delta) ||
        !finite_nonnegative_ledger(prospective_tracer_ledger)) {
        atomicOr(status.flags, INVALID_STATE);
        return;
    }
    candidate_depth.values[index] = updated_h;
    candidate_momentum.values[index] = vec4(updated_q, 0.0, 0.0);
    candidate_tracer_q.values[index] = updated_tracer_q;
    candidate_velocity.values[index] =
        vec4(derived_velocity, updated_h > minimum_wet_depth ? 1.0 : 0.0, 0.0);
    candidate_ledger_delta.values[index] = ledger_delta;
    candidate_tracer_ledger_delta.values[index] = tracer_ledger_delta;
    candidate_conservation_residual.values[index] = next_residual;
    if (params.dye.y > 0.5) {
        MassAudit a = audit_zero();
        float area = audit_observe(cell_area);
        float scale = audit_observe(transport_scale);
        vec2 water_internal = audit_scale(audit_water_internal, scale);
        vec2 water_boundary = audit_scale(audit_water_boundary, scale);
        vec2 tracer_internal = audit_scale(audit_tracer_internal, scale);
        vec2 tracer_boundary = audit_scale(audit_tracer_boundary, scale);
        for (uint component = 0u; component < 3u; ++component) {
            audit_set_water(a, component, vec2(audit_observe(ledger_delta[component]), 0.0));
            audit_set_tracer(a, component,
                             vec2(audit_observe(tracer_ledger_delta[component]), 0.0));
        }
        audit_set_water(a, 3u, audit_scale(audit_difference(
            audit_observe(center_source_sink.sourced_h), audit_observe(depth.values[index])), area));
        audit_set_water(a, 4u, audit_scale(audit_difference(
            audit_observe(center_source_sink.sourced_h), audit_observe(center.h)), area));
        audit_set_tracer(a, 3u, audit_scale(audit_difference(
            audit_observe(center_source_sink.sourced_tracer_q), audit_observe(tracer_q.values[index])), area));
        audit_set_tracer(a, 4u, audit_scale(audit_difference(
            audit_observe(center_source_sink.sourced_tracer_q), audit_observe(center_source_sink.tracer_q)), area));
        audit_set_water(a, 5u, audit_scale(water_internal, area));
        audit_set_water(a, 6u, audit_scale(water_boundary, area));
        audit_set_tracer(a, 5u, audit_scale(tracer_internal, area));
        audit_set_tracer(a, 6u, audit_scale(tracer_boundary, area));
        vec2 water_rounding = audit_add(audit_difference(audit_observe(preclamp_h),
                                                        audit_observe(center.h)),
                                       audit_add(-water_internal, water_boundary));
        vec2 tracer_rounding = audit_add(audit_difference(audit_observe(preclamp_tracer_q),
                                                         audit_observe(center_source_sink.tracer_q)),
                                        audit_add(-tracer_internal, tracer_boundary));
        audit_set_water(a, 7u, audit_scale(water_rounding, area));
        audit_set_tracer(a, 7u, audit_scale(tracer_rounding, area));
        audit_set_water(a, 8u, audit_scale(audit_difference(audit_observe(updated_h),
                                                          audit_observe(preclamp_h)), area));
        audit_set_tracer(a, 8u, audit_scale(audit_difference(audit_observe(updated_tracer_q),
                                                           audit_observe(preclamp_tracer_q)), area));
        audit_set_water(a, 9u, vec2(1.0, 0.0));
        audit_set_tracer(a, 9u, vec2(1.0, 0.0));
        candidate_mass_audit.values[index] = a;
    }
}
