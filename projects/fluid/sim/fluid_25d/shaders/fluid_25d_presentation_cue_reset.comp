#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) buffer PresentationCueAField {
    float values[];
} cue_a;
layout(set = 0, binding = 1, std430) buffer PresentationCueBField {
    float values[];
} cue_b;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_cell;
    vec4 physics;
} params;

uint cue_hash(uint x, uint y, uint salt) {
    uint value = x * 0x8da6b343u ^ y * 0xd8163841u ^ salt;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float cue_random(uint x, uint y, uint salt) {
    return float(cue_hash(x, y, salt) & 0x00ffffffu) / 16777215.0;
}

float smooth_unit(float value) {
    float clamped = clamp(value, 0.0, 1.0);
    return clamped * clamped * (3.0 - 2.0 * clamped);
}

float cue_lattice(vec2 coordinate, float cell_span, uint salt) {
    vec2 scaled = coordinate / cell_span;
    uvec2 lower = uvec2(floor(scaled));
    vec2 fraction = vec2(smooth_unit(fract(scaled).x), smooth_unit(fract(scaled).y));
    float lower_value = mix(cue_random(lower.x, lower.y, salt),
                            cue_random(lower.x + 1u, lower.y, salt), fraction.x);
    float upper_value = mix(cue_random(lower.x, lower.y + 1u, salt),
                            cue_random(lower.x + 1u, lower.y + 1u, salt), fraction.x);
    return mix(lower_value, upper_value, fraction.y);
}

float cue_seed(uvec2 coordinate) {
    vec2 position = vec2(coordinate);
    float primary = cue_lattice(position, 23.0, 0x68bc21ebu);
    float secondary = cue_lattice(position, 11.0, 0x02e5be93u);
    return clamp(0.5 + (primary - 0.5) * 0.70 + (secondary - 0.5) * 0.24, 0.0, 1.0);
}

void main() {
    uint width = uint(params.grid_dt_cell.x);
    uint height = uint(params.grid_dt_cell.y);
    uvec2 coordinate = gl_GlobalInvocationID.xy;
    if (coordinate.x >= width || coordinate.y >= height) {
        return;
    }
    uint index = coordinate.y * width + coordinate.x;
    float seed = cue_seed(coordinate);
    cue_a.values[index] = seed;
    cue_b.values[index] = seed;
}
