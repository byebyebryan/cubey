#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer NativeVelocity { vec4 values[]; } native_velocity;
layout(set=0,binding=1,std430) buffer VisualVelocity { vec4 values[]; } visual_velocity;
layout(push_constant) uniform Params { vec4 count_blend_reset; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i>=uint(params.count_blend_reset.x)) return;
    if (params.count_blend_reset.z>0.5) visual_velocity.values[i]=native_velocity.values[i];
    else if (params.count_blend_reset.y>0.0)
        visual_velocity.values[i]=mix(visual_velocity.values[i],native_velocity.values[i],params.count_blend_reset.y);
}
