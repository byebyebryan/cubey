#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct QuiverState {
    vec4 anchor_xy_reserved;
    vec4 direction_xy_strength_opacity;
};

layout(set = 0, binding = 0, std430) readonly buffer DepthField {
    float values[];
} depth;
layout(set = 0, binding = 1, std430) readonly buffer VelocityField {
    vec4 values[];
} velocity;
layout(set = 0, binding = 2, std430) readonly buffer PresentationStatusField {
    uvec4 values[];
} status;
layout(set = 0, binding = 3, std430) buffer QuiverField {
    QuiverState values[];
} quiver;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_cell;
    vec4 physics;
} params;

const uint kNeighborhoodRadius = 1u;
const float kMinimumSpeedMPerS = 0.025;
const float kDirectionSmoothingSeconds = 1.5;
const float kStrengthSmoothingSeconds = 1.5;
const float kOpacitySmoothingSeconds = 0.75;
const float kDirectionEpsilon = 1.0e-5;

bool finite_float(float value) {
    return !isnan(value) && !isinf(value);
}

bool finite_vec2(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

bool sample_average_velocity(uvec2 anchor, uint width, uint height, out vec2 average_flow) {
    vec2 sum = vec2(0.0);
    uint samples = 0u;
    for (int offset_y = -int(kNeighborhoodRadius); offset_y <= int(kNeighborhoodRadius);
         ++offset_y) {
        for (int offset_x = -int(kNeighborhoodRadius); offset_x <= int(kNeighborhoodRadius);
             ++offset_x) {
            ivec2 coordinate = ivec2(anchor) + ivec2(offset_x, offset_y);
            if (coordinate.x < 0 || coordinate.y < 0 || coordinate.x >= int(width) ||
                coordinate.y >= int(height)) {
                continue;
            }
            uint field_index = uint(coordinate.y) * width + uint(coordinate.x);
            float water_depth = depth.values[field_index];
            vec4 velocity_sample = velocity.values[field_index];
            vec2 flow = velocity_sample.xy;
            if (!finite_float(water_depth) || !finite_vec2(flow) ||
                !finite_float(velocity_sample.z) || water_depth <= params.physics.z ||
                velocity_sample.z < 0.5) {
                continue;
            }
            sum += flow;
            ++samples;
        }
    }
    if (samples == 0u) {
        average_flow = vec2(0.0);
        return false;
    }
    average_flow = sum / float(samples);
    return finite_vec2(average_flow);
}

float smoothing_blend(float delta_seconds, float smoothing_seconds) {
    return delta_seconds <= 0.0 || smoothing_seconds <= 0.0
               ? 0.0
               : 1.0 - exp(-delta_seconds / smoothing_seconds);
}

vec2 smoothed_direction(vec2 stored_direction, vec2 target_direction, float blend) {
    float stored_length = length(stored_direction);
    if (!finite_vec2(stored_direction) || stored_length < kDirectionEpsilon) {
        return target_direction;
    }
    vec2 mixed = mix(stored_direction / stored_length, target_direction, blend);
    float mixed_length = length(mixed);
    return !finite_vec2(mixed) || mixed_length < kDirectionEpsilon ? target_direction
                                                                     : mixed / mixed_length;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(quiver.values.length())) {
        return;
    }
    // A finite-volume rejected/sticky step is a strict no-write boundary for
    // quiver direction, strength, opacity, and anchors.
    if (status.values[0].x != 0u) {
        return;
    }

    uint width = uint(params.grid_dt_cell.x);
    uint height = uint(params.grid_dt_cell.y);
    float delta_seconds = params.grid_dt_cell.z;
    QuiverState state = quiver.values[index];
    vec2 anchor = state.anchor_xy_reserved.xy;
    if (!finite_vec2(anchor) || anchor.x < 0.0 || anchor.y < 0.0 ||
        anchor.x > float(width - 1u) || anchor.y > float(height - 1u)) {
        state.direction_xy_strength_opacity = vec4(0.0);
        quiver.values[index] = state;
        return;
    }

    uvec2 sample_coordinate = uvec2(floor(anchor + vec2(0.5)));
    vec2 average_flow;
    if (!sample_average_velocity(sample_coordinate, width, height, average_flow)) {
        // Dry/nonfinite published data never keeps a glyph alive over empty
        // terrain. The fixed anchor itself remains untouched.
        state.direction_xy_strength_opacity = vec4(0.0);
        quiver.values[index] = state;
        return;
    }

    float speed = length(average_flow);
    if (!finite_float(speed) || speed < kMinimumSpeedMPerS || speed < kDirectionEpsilon) {
        // Calm but valid water fades gently in simulation time. A reset of a
        // lake-at-rest field starts at exactly zero, so it remains absent.
        float fade = smoothing_blend(delta_seconds, kOpacitySmoothingSeconds);
        state.direction_xy_strength_opacity.z = mix(
            max(0.0, state.direction_xy_strength_opacity.z), 0.0,
            smoothing_blend(delta_seconds, kStrengthSmoothingSeconds));
        state.direction_xy_strength_opacity.w = mix(
            clamp(state.direction_xy_strength_opacity.w, 0.0, 1.0), 0.0, fade);
        quiver.values[index] = state;
        return;
    }

    vec2 target_direction = average_flow / speed;
    state.direction_xy_strength_opacity.xy = smoothed_direction(
        state.direction_xy_strength_opacity.xy, target_direction,
        smoothing_blend(delta_seconds, kDirectionSmoothingSeconds));
    state.direction_xy_strength_opacity.z = mix(
        max(0.0, state.direction_xy_strength_opacity.z), speed,
        smoothing_blend(delta_seconds, kStrengthSmoothingSeconds));
    state.direction_xy_strength_opacity.w = mix(
        clamp(state.direction_xy_strength_opacity.w, 0.0, 1.0), 1.0,
        smoothing_blend(delta_seconds, kOpacitySmoothingSeconds));
    quiver.values[index] = state;
}
