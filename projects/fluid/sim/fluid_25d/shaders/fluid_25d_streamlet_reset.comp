#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct StreamletState {
    // cell.xy, signed age, deterministic generation
    vec4 cell_age_generation;
    // smoothed heading.xy, opacity, retirement seconds remaining
    vec4 direction_opacity_retire_seconds;
};

layout(set = 0, binding = 0, std430) buffer StreamletField {
    StreamletState values[];
} streamlets;
layout(set = 0, binding = 1, std430) readonly buffer PresentationStatusField {
    uvec4 values[];
} status;
layout(set = 0, binding = 2, std430) readonly buffer DepthField {
    float values[];
} depth;
layout(set = 0, binding = 3, std430) readonly buffer VelocityField {
    vec4 values[];
} velocity;

layout(push_constant) uniform SimulationParams {
    vec4 grid_dt_cell;
    vec4 physics;
} params;

// Keep this activation contract synchronized with fluid_25d_presentation.h
// and the advection shader. It sits above the retained initial-sheet maximum.
const float kActivationSpeedMPerS = 0.025;

uint streamlet_hash(uint x, uint y, uint salt) {
    uint value = x * 0x8da6b343u ^ y * 0xd8163841u ^ salt;
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float streamlet_random(uint index, uint generation, uint salt) {
    return float(streamlet_hash(index, generation, salt) & 0x00ffffffu) / 16777215.0;
}

float streamlet_cooldown_seconds(uint index, uint generation) {
    return params.grid_dt_cell.z *
           (8.0 + streamlet_random(index, generation, 0x510e527fu) * 10.0);
}

bool finite_vec2(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

uvec2 sample_coordinate(vec2 cell, uint width, uint height) {
    vec2 bounded = clamp(cell, vec2(0.0), vec2(float(width - 1u), float(height - 1u)));
    return uvec2(floor(bounded + vec2(0.5)));
}

bool can_activate(uvec2 coordinate, uint width) {
    uint field_index = coordinate.y * width + coordinate.x;
    float water_depth = depth.values[field_index];
    vec2 flow = velocity.values[field_index].xy;
    return !isnan(water_depth) && !isinf(water_depth) && finite_vec2(flow) &&
           water_depth > params.physics.z && length(flow) >= kActivationSpeedMPerS;
}

StreamletState streamlet_initial_state(uint index, uint generation, uint width, uint height) {
    // Keep seeds inside the cell-centre domain so an immediate respawn neither
    // sits on an outflow edge nor needs host-side placement data.
    vec2 interior_extent = vec2(max(0.0, float(width) - 2.0),
                                max(0.0, float(height) - 2.0));
    vec2 cell = vec2(0.5) + vec2(streamlet_random(index, generation, 0x7f4a7c15u),
                                  streamlet_random(index, generation, 0x6a09e667u)) *
                                  interior_extent;
    // A reset is immediately legible even while paused: it samples the
    // current parity-selected fields, admitting only decisively active flow.
    // Later lifecycle entries fade in from zero so they never pulse together.
    float lifetime = params.physics.w *
                     (0.75 + streamlet_random(index, generation, 0x3c6ef372u) * 0.50);
    StreamletState state;
    state.cell_age_generation = vec4(
        cell, -streamlet_cooldown_seconds(index, generation), float(generation));
    state.direction_opacity_retire_seconds = vec4(0.0);
    uvec2 coordinate = sample_coordinate(cell, width, height);
    if (can_activate(coordinate, width)) {
        vec2 direction = normalize(velocity.values[coordinate.y * width + coordinate.x].xy);
        state.cell_age_generation.z =
            streamlet_random(index, generation, 0xa54ff53au) * lifetime;
        state.direction_opacity_retire_seconds = vec4(direction, 1.0, 0.0);
    }
    return state;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uint(streamlets.values.length())) {
        return;
    }
    // Match advection's strict fail-closed boundary. In particular, entering
    // Flow Inspection after a sticky finite-volume failure cannot rewrite
    // presentation state until an explicit solver reset clears the status.
    if (status.values[0].x != 0u) {
        return;
    }
    streamlets.values[index] = streamlet_initial_state(index, 0u, uint(params.grid_dt_cell.x),
                                                        uint(params.grid_dt_cell.y));
}
