    )

    target_include_directories(
        ${target}
        PRIVATE
            "${CMAKE_SOURCE_DIR}/projects/fluid/fluid_25d"
            "${shared_source_root}"
    )
    target_link_libraries(${target} PRIVATE cubey_fluid25d_terrain_surface)

endfunction()
