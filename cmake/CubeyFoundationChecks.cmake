include_guard(GLOBAL)

# Compile each configured library's public headers in isolation, with that
# target's real public usage requirements. Keep this out of ordinary builds;
# CTest and explicit foundation reviews invoke the aggregate target.
function(cubey_add_public_header_checks)
    file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/include/cubey/*.h")
    set(modules)
    foreach(header IN LISTS headers)
        file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}/include" "${header}")
        string(REGEX REPLACE "^cubey/([^/]+)/.*" "\\1" module "${relative}")
        if (module STREQUAL "procedural")
            set(module core)
        endif()
        if (NOT TARGET cubey::${module})
            continue() # Optional host headers follow the configured host target.
        endif()
        set(unit "${CMAKE_CURRENT_BINARY_DIR}/header_checks/${relative}.cpp")
        file(GENERATE OUTPUT "${unit}" CONTENT "#include <${relative}>\n")
        list(APPEND units_${module} "${unit}")
        list(APPEND modules "${module}")
    endforeach()
    list(REMOVE_DUPLICATES modules)
    add_custom_target(cubey_header_checks)
    foreach(module IN LISTS modules)
        add_library(cubey_${module}_header_checks OBJECT EXCLUDE_FROM_ALL ${units_${module}})
        target_link_libraries(cubey_${module}_header_checks PRIVATE cubey::${module} cubey_project_warnings)
        add_dependencies(cubey_header_checks cubey_${module}_header_checks)
    endforeach()
    add_test(NAME foundation_public_headers
        COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_BINARY_DIR}" --target cubey_header_checks --parallel 2)
    set_tests_properties(foundation_public_headers PROPERTIES LABELS "build;policy" TIMEOUT 300)
endfunction()

function(cubey_collect_directory_targets directory result)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(imported DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
    list(APPEND targets ${imported})
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        cubey_collect_directory_targets("${child}" child_targets)
        list(APPEND targets ${child_targets})
    endforeach()
    list(REMOVE_DUPLICATES targets)
    set(${result} ${targets} PARENT_SCOPE)
endfunction()

function(cubey_foundation_json_string value result)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Let CMake evaluate link expressions in each configured target/configuration.
# Keep raw lists in separate files so library paths and flags need no JSON
# reinterpretation. Architectural policy and transparent-wrapper traversal
# belong to the checker, independently of the exported target identities.
function(cubey_write_foundation_target_graph output)
    get_filename_component(output "${output}" ABSOLUTE)
    get_filename_component(output_directory "${output}" DIRECTORY)
    get_filename_component(output_name "${output}" NAME)
    cubey_collect_directory_targets("${PROJECT_SOURCE_DIR}" collected)
    set(targets)
    set(unresolved_targets)
    foreach(target IN LISTS collected)
        if(TARGET "${target}") # Directory-local imported targets may be invisible here.
            list(APPEND targets "${target}")
        else()
            # Preserve their identity: the checker must not mistake an opaque
            # imported target for a plain system-library name on a checked path.
            list(APPEND unresolved_targets "\"${target}\"")
        endif()
    endforeach()
    set(aliases)
    set(modules)
    set(external_targets)
    set(index 0)
    list(LENGTH targets target_count)
    while(index LESS target_count)
        list(GET targets ${index} target)
        get_target_property(kind "${target}" TYPE)
        get_target_property(imported "${target}" IMPORTED)
        if(NOT imported AND kind MATCHES "^(STATIC|SHARED|MODULE)_LIBRARY$")
            get_target_property(source_directory "${target}" SOURCE_DIR)
            get_directory_property(source_project DIRECTORY "${source_directory}" DEFINITION PROJECT_NAME)
            if(NOT source_project STREQUAL PROJECT_NAME)
                # Compiled foreign libraries are terminal dependencies. Their
                # private platform imports are not Cubey layer edges. Keep
                # inspecting interface/object wrappers, including imports.
                list(APPEND external_targets "\"${target}\"")
            endif()
        endif()
        if(target MATCHES "^cubey_(.+)$")
            set(module "${CMAKE_MATCH_1}")
            if(TARGET cubey::${module})
                get_target_property(owner cubey::${module} ALIASED_TARGET)
                if(owner STREQUAL target)
                    list(APPEND modules "\"${target}\": \"${module}\"")
                endif()
            endif()
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links "${target}" ${property})
            # Single ':' separates generator-expression operators; only '::'
            # belongs to namespaced target identities.
            string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.+-]*(::[A-Za-z_][A-Za-z0-9_.+-]*)*" names "${links}")
            foreach(name IN LISTS names)
                if(NOT TARGET "${name}")
                    continue()
                endif()
                get_target_property(actual "${name}" ALIASED_TARGET)
                if(actual)
                    list(APPEND aliases "\"${name}\": \"${actual}\"")
                else()
                    set(actual "${name}")
                endif()
                if(NOT actual IN_LIST targets)
                    list(APPEND targets "${actual}")
                endif()
            endforeach()
        endforeach()
        math(EXPR index "${index} + 1")
        list(LENGTH targets target_count)
    endwhile()
    list(REMOVE_DUPLICATES aliases)
    list(JOIN aliases ",\n" aliases)
    list(JOIN modules ",\n" modules)
    list(JOIN unresolved_targets ", " unresolved_targets)
    list(JOIN external_targets ", " external_targets)

    get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if(multi_config)
        set(configurations "${CMAKE_CONFIGURATION_TYPES}")
    else()
        set(configurations "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT configurations)
        set(configurations "__default__")
    endif()
    set(config_entries)
    foreach(configuration IN LISTS configurations)
        if(configuration STREQUAL "__default__")
            set(condition "$<STREQUAL:$<CONFIG>,>")
        else()
            set(condition "$<CONFIG:${configuration}>")
        endif()
        string(SHA256 config_id "${configuration}")
        set(entries)
        foreach(target IN LISTS targets)
            string(SHA256 target_id "${target}")
            set(relative "${output_name}.links/${config_id}/${target_id}.txt")
            file(GENERATE OUTPUT "${output_directory}/${relative}"
                CONTENT "$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},LINK_LIBRARIES>>\n$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},INTERFACE_LINK_LIBRARIES>>\n"
                CONDITION "${condition}" TARGET "${target}")
            cubey_foundation_json_string("${relative}" relative_json)
            list(APPEND entries "\"${target}\": ${relative_json}")
        endforeach()
        list(JOIN entries ",\n" entries)
        cubey_foundation_json_string("${configuration}" configuration_json)
        list(APPEND config_entries "${configuration_json}: {${entries}}")
    endforeach()
    list(JOIN config_entries ",\n" config_entries)
    file(GENERATE OUTPUT "${output}" CONTENT
        "{\n\"version\": 2,\n\"modules\": {${modules}},\n\"aliases\": {${aliases}},\n\"unresolved_targets\": [${unresolved_targets}],\n\"external_targets\": [${external_targets}],\n\"configurations\": {${config_entries}}\n}\n")
endfunction()
