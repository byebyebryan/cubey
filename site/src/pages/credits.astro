---
import Layout from '../layouts/Layout.astro';
import {media} from '../data/catalog';
import {url} from '../lib/urls';
const path='/credits/';
---
<Layout title="Media and credits" path={path}>
  <section class="page-title"><span class="eyebrow">Media and credits</span><h1>Made here.<br/> With credit.</h1><p class="intro">Native Cubey captures, imported example assets and their authors.</p></section>
  <section class="section about"><h2>The visual work.</h2><div class="body-copy"><p>The images and films on this site are captured from the native Cubey applications. The original code and original Cubey media use the MIT license. Imported models retain their own notices, listed with the relevant captures below.</p><p>Images are resized and encoded for the site without changing the scene. Recorded playback remains distinct from an interactive browser renderer.</p><div class="source-strip"><a href="https://github.com/byebyebryan/cubey/blob/main/LICENSE">Cubey license ↗</a><a href={url('/metadata/media.json',path)}>Selected media identities ↗</a></div></div></section>
  <section class="section"><div class="section-head"><h2>Selected assets.</h2></div><div class="table-scroll"><table class="credits-table"><thead><tr><th>Capture</th><th>Author / source</th><th>License</th></tr></thead><tbody>{media.assets.map(a=><tr id={a.id}><td><a href={url(a.file,path)}>{a.caption}</a></td><td>{a.credit.author||'Bryan'}{a.credit.source&&<><br/><a href={a.credit.source}>Asset source / notice ↗</a></>}</td><td><a href={a.credit.url}>{a.credit.label} ↗</a></td></tr>)}</tbody></table></div></section>
</Layout>
