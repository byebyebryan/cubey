---
const base=import.meta.env.BASE_URL;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><meta name="color-scheme" content="dark"/><title>Page not found — Cubey</title><style is:inline>body{margin:0;min-height:100svh;display:grid;place-items:center;background:#111715;color:#eff1e8;font:16px/1.6 system-ui,sans-serif}main{width:min(760px,calc(100% - 40px));padding:40px 0}h1{font-size:clamp(40px,7vw,70px);font-weight:500;letter-spacing:-.045em;line-height:1.12;margin:24px 0}p{color:#abb6ac}a{color:#b8cf8b;text-underline-offset:5px}a:focus-visible{outline:3px solid #bddb90;outline-offset:5px}.brand{font-size:28px;color:#eff1e8;text-decoration:none;font-weight:650}.eyebrow{font-size:12px;letter-spacing:.12em;margin-top:40px}</style></head><body><main><a class="brand" data-home href="./">Cubey</a><p class="eyebrow">404</p><h1>This path ends here.</h1><p>There is more to explore in the workshop.</p><a data-home href="./">Back to Cubey ↗</a></main><script is:inline define:vars={{base}}>const home=location.pathname.endsWith('/404.html')?new URL('./',location.href):new URL(base,location.origin);for(const link of document.querySelectorAll('[data-home]'))link.href=home.href;</script></body></html>
