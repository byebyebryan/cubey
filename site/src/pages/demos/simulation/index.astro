---
import Layout from '../../../layouts/Layout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import Card from '../../../components/Card.astro';
import {familyEntries} from '../../../data/catalog';
const path='/demos/simulation/';
---
<Layout title="Simulation" description="Splashes, flames, swirling dye and expanding plumes, in two and three dimensions." path={path}><PageTitle subject="Simulation" title="Water. Smoke. Fire." intro="Splashes, flames, swirling dye and expanding plumes, in two and three dimensions." path={path}/><section class="section"><div class="grid cards">{familyEntries('simulation').map(e=><Card entry={e} path={path}/>)}</div></section></Layout>
