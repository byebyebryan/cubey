---
import Layout from '../../layouts/Layout.astro';
import Preview from '../../components/Preview.astro';
import Card from '../../components/Card.astro';
import {subjects,bands,familyEntries,primarySimulationEntries,entryPath,byId} from '../../data/catalog';
import {url} from '../../lib/urls';
const path='/demos/';
const covers:Record<string,string>={terrain:'terrain-water',ocean:'ocean-surface',atmosphere:'clouds',materials:'mesh-materials',sdf:'robot',gltf:'gltf-motion'};
---
<Layout title="Demos" description="Ray tracing, fluids, landscapes, materials and forms. Watch a film or explore the scenes behind it." path={path}><section class="page-title"><span class="eyebrow">Explore the workshop</span><h1>Follow an interest.</h1><p class="intro">Ray tracing, fluids, landscapes, materials and forms. Watch here, or open a subject to look closer.</p></section>
  <nav class="subject-strip" aria-label="Explore subjects">
    {subjects.map(subject => <a href={url(`/demos/${subject.id}/`, path)}>{subject.title}</a>)}
  </nav>
  {bands.map(band =>
    <section class="section" id={band.id === 'simulation' ? 'simulation-lineup' : undefined}>
      <div class="section-head"><h2>{band.title}</h2>{band.id === 'simulation' && <a href={url('/demos/simulation/',path)}>Explore simulation ↗</a>}</div>
      {band.id === 'raytracing'
        ? <div class="directory-feature"><div class="feature-panel"><Preview entry="stanford-dragon" title="Ray tracing" path={path} eager hover={false}/></div><div class="feature-copy"><span class="eyebrow">Hardware ray tracing</span><h3>A dragon in glass.</h3><p>Reflection and refraction follow the dragon's shape under the shared clear sky. Compare fixed-quality RT, progressive sampled RT and a forward-rendered approximation in the same scene.</p><div class="cues"><span class="cue">Vulkan RT</span><span class="cue">Scene reflections</span><span class="cue">Glass boundaries</span></div><a class="primary-link" href={url('/demos/raytracing/',path)}>Explore ray tracing ↗</a></div></div>
        : band.id === 'simulation'
          ? <>
              <div class="grid cards two">
                {primarySimulationEntries.map(e => <Card entry={e} path={path}/>)}
              </div>
              <p class="note">For a closer look at dye transport and free-surface flow, see <a href={url('/demos/simulation/#fluid-studies',path)}>2D Fluid Studies ↗</a>.</p>
            </>
          : <div class="grid cards">{band.subjects.map(id=>{const subject=subjects.find(s=>s.id===id)!;const items=familyEntries(id);return <article class="area-card"><Preview entry={covers[id]} path={path}/><p class="preview-caption">{byId[covers[id]].title}</p><a class="area-cover" href={url(`/demos/${id}/`,path)}><h3>{subject.title} ↗</h3></a><p>{subject.subtitle}</p><div class="scene-links">{items.map(e=><a href={url(entryPath(e),path)}>{e.title}</a>)}</div></article>;})}</div>}
    </section>
  )}
</Layout>

<style>
  .directory-feature .feature-copy h3{font-size:clamp(28px,3vw,40px);margin:12px 0 18px}
  .directory-feature .primary-link{display:inline-block}
</style>
