---
import Layout from '../../layouts/Layout.astro';
import Preview from '../../components/Preview.astro';
import Card from '../../components/Card.astro';
import {subjects,bands,familyEntries,entryPath,byId} from '../../data/catalog';
import {url} from '../../lib/urls';
const path='/demos/';
const covers:Record<string,string>={terrain:'terrain-water',ocean:'ocean-surface',atmosphere:'clouds',materials:'mesh-materials',sdf:'robot',gltf:'gltf-motion'};
---
<Layout title="Demos" description="Fluids, landscapes, materials and forms. Watch a film or explore the scenes behind it." path={path}><section class="page-title"><span class="eyebrow">Explore the workshop</span><h1>Follow an interest.</h1><p class="intro">Fluids, landscapes, materials and forms. Watch here, or open a subject to look closer.</p></section>
  {bands.map(band=><section class="section"><div class="section-head"><h2>{band.title}</h2>{band.id==='simulation'&&<a href={url('/demos/simulation/',path)}>Explore simulation ↗</a>}</div>
    {band.id==='simulation'?<div class="grid cards">{familyEntries('simulation').map(e=><Card entry={e} path={path}/>)}</div>:<div class="grid cards">{band.subjects.map(id=>{const subject=subjects.find(s=>s.id===id)!;const items=familyEntries(id);return <article class="area-card"><Preview entry={covers[id]} path={path}/><p class="preview-caption">{byId[covers[id]].title}</p><a class="area-cover" href={url(`/demos/${id}/`,path)}><h3>{subject.title} ↗</h3></a><p>{subject.subtitle}</p><div class="scene-links">{items.map(e=><a href={url(entryPath(e),path)}>{e.title}</a>)}</div></article>;})}</div>}
  </section>)}
</Layout>
