---
import ScenePage from '../../../components/ScenePage.astro';
import {familyEntries} from '../../../data/catalog';
export function getStaticPaths(){return familyEntries('sdf').map(entry=>({params:{scene:entry.id},props:{entry}}));}
const {entry}=Astro.props;
---
<ScenePage entry={entry} path={`/demos/sdf/${entry.id}/`}/>
