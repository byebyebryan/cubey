---
import Layout from '../../../layouts/Layout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import Card from '../../../components/Card.astro';
import {familyEntries} from '../../../data/catalog';
import {url} from '../../../lib/urls';
const path='/demos/sdf/';
---
<Layout title="SDF forms" description="A sculpture and a robot, shaped by combining and cutting simple solids, then rendered from signed-distance fields." path={path}><PageTitle subject="SDF forms" title="Sculpture and construction." intro="A sculpture and a robot, shaped by combining and cutting simple solids. Their surfaces are rendered directly from signed-distance fields." path={path}/><section class="section"><div class="grid two">{familyEntries('sdf').map(e=><Card entry={e} path={path}/>)}</div><p class="note">See what happens inside these solids in the <a href={url('/demos/materials/#sdf-materials',path)}>material cut study ↗</a>.</p></section></Layout>
