---
import Layout from '../../../layouts/Layout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import Card from '../../../components/Card.astro';
import {familyEntries} from '../../../data/catalog';
import {url} from '../../../lib/urls';
const path='/demos/sdf/';
---
<Layout title="SDF forms" path={path}><PageTitle subject="SDF forms" title="Shapes, built from operations." intro="An authored sculpture and a mechanical construction, rendered from their signed-distance fields." path={path}/><section class="section"><div class="grid two">{familyEntries('sdf').map(e=><div class:list={{square:e.id==='guardian'}}><Card entry={e} path={path}/></div>)}</div><p class="note">For the shared procedural recipes and cuts through a material field, visit <a href={url('/demos/materials/#sdf-materials',path)}>Materials ↗</a>.</p></section></Layout>
