---
import Layout from '../../layouts/Layout.astro';
import PageTitle from '../../components/PageTitle.astro';
import Chapter from '../../components/Chapter.astro';
import Media from '../../components/Media.astro';
import Picture from '../../components/Picture.astro';
import Connection from '../../components/Connection.astro';
import MaterialCutComparison from '../../components/MaterialCutComparison.astro';
import MaterialLibrary from '../../components/MaterialLibrary.astro';
import {subjects,familyEntries,asset,selected,sourceURL,media} from '../../data/catalog';
import {url} from '../../lib/urls';
export function getStaticPaths(){return subjects.filter(f=>!['simulation','sdf'].includes(f.id)).map(subject=>({params:{subject:subject.id},props:{subject}}));}
const {subject}=Astro.props;const path=`/demos/${subject.id}/`;const items=familyEntries(subject.id);
const chapterItems=items.filter(e=>e.id!=='day-night'&&e.id!=='mesh-materials');
const titles:Record<string,string>={terrain:'Land, then flow.',ocean:'Open water.',atmosphere:'Light. Clouds. A turning sky.',materials:'Surfaces with character.',gltf:'Imported scenes, in detail.'};
const intros:Record<string,string>={terrain:'Rocky landforms and surface detail, followed by water winding through a mountain basin.',ocean:'Waves, whitecaps and changing light across an open horizon.',atmosphere:'From clear-sky light to moving clouds, stars and the return of daylight.',materials:'Twelve materials, shared by forward PBR and SDF ray marching.',gltf:'A native glTF importer and renderer: materials, transparency, textures and motion, one feature at a time.'};
const chapterPage=['terrain','atmosphere','materials','gltf'].includes(subject.id);
const filmCaptions:Record<string,string>={'terrain-water':'Water motion replayed from SynxFlow data, with lighting animated separately.','sdf-materials':'Wood, marble, rusted steel and clear glass · one saved cut sequence.','atmosphere-light':'Low sun · direct scattering through the clear atmosphere.','clouds':'Broken cumulus · accelerated cloud drift under a fixed afternoon sun.','night-sky':'Procedural stars and Milky Way · native sky rendering.','gltf-layers':'Barn Lamp · authored anisotropy and clearcoat on an imported material.','gltf-optics':'Dispersion Test · transmission, volume thickness, IOR and dispersion.','gltf-motion':'Fox · the Walk clip demonstrates core animation and skinning.','gltf-textures':'Texture Transform Multi Test · authored UV transforms across different surfaces.'};
---
<Layout title={subject.title} path={path} description={intros[subject.id]}>
  <PageTitle subject={subject.title} title={titles[subject.id]} intro={intros[subject.id]} path={path}/>
  {chapterPage ? <>
    <nav class="chapter-nav" aria-label="On this page">{subject.id==='materials'&&<a href="#material-library">All twelve materials</a>}{chapterItems.map(e=><a href={`#${e.id}`}>{e.title}</a>)}</nav>
    {subject.id==='materials'&&<MaterialLibrary path={path}/>}
    {chapterItems.map((entry,i)=><Chapter entry={entry} path={path} number={i+1} caption={filmCaptions[entry.id]}>
      {entry.id==='sdf-materials' && <MaterialCutComparison path={path}/>}
      {entry.id==='night-sky'&&<div class="supporting-motion" id="day-night"><h3>Day, night, and daylight again.</h3><p class="note">An accelerated full solar day: afternoon, sunset, stars and returning daylight.</p><Media entry="day-night" path={path} title="The solar cycle" caption="Twenty-four solar hours in twelve seconds · native recorded playback."/></div>}
      {entry.id==='gltf-motion' && media.selections['gltf-morph'] && <div class="supporting-motion"><h3>A separate morph-target example.</h3><Media entry="gltf-morph" path={path} title="Animated morph cube" caption="Animated Morph Cube · a separate target-deformation example."/></div>}
      {selected(entry.id).gallery && <div class="gallery">{selected(entry.id).gallery!.map(id=><figure><Picture id={id} path={path} alt={asset(id).caption}/><figcaption>{asset(id).caption}</figcaption></figure>)}</div>}
    </Chapter>)}
  </> : <>
    <div class="full-stage"><Media entry={items[0].id} path={path} title={items[0].title} eager caption={subject.id==='ocean'?'Windy sea state · native recorded lighting arc.':undefined}/></div>
    <section class="section scene-detail"><div class="aside-label">In this scene</div><div><p class="body-copy">{items[0].summary}</p><div class="cues">{items[0].cues.map(c=><span class="cue">{c}</span>)}</div><a class="source-link" href={sourceURL(items[0])}>Scene guide &amp; source ↗</a><details><summary>About this scene</summary><p class="note">{items[0].scope}</p></details></div></section>
  </>}
  {subject.id==='terrain' && <Connection id="water-to-terrain" target="shallow-water" path={path} boundary text="The 2.5D fluid experiments led into the terrain-water work. Shared terrain rendering lets improvements travel between the projects."/>}
  {subject.id==='atmosphere' && <Connection id="sky-to-materials" target="mesh-materials" path={path} text="The same shared sky and cloud services also provide lighting and backdrop for the material workshops. A sky experiment becomes useful to a different subject."/>}
  {subject.id==='materials' && <><section class="section"><p class="body-copy">A material field is one part of the story. <a href={url('/demos/sdf/',path)}>See authored forms and construction ↗</a></p></section><Connection id="sky-to-materials" target="atmosphere-light" path={path} text="The material workshops reuse the atmosphere and cloud services explored in the sky project. Changing the environment gives the same material a different setting."/></>}
  {subject.id==='gltf' && <section class="section"><h2>Supported glTF features.</h2><p class="body-copy">The examples above show a few visible features. The source notes list the supported extensions and explain where the renderer's approximations matter.</p><details><summary>Supported extensions and limits</summary><ul class="support-list">{items.flatMap(e=>e.extensions).map(extension=><li><code>{extension}</code></li>)}</ul><p class="note">The transparent path combines screen-space and environment transport. It does not provide exact multiple-bounce refraction, transparent shadows or order-independent transparency. This supported set has a documented scope; it is not a claim of complete glTF compatibility or certification.</p><a class="source-link" href="https://github.com/byebyebryan/cubey/blob/main/docs/architecture/gltf-assets.md">glTF support and renderer notes ↗</a></details></section>}
  {subject.id==='ocean' && <section class="section about"><h2>Light across the water.</h2><div><p>The shared atmosphere supplies sky light and reflections to the ocean surface.</p><a class="text-link" href={url('/demos/atmosphere/',path)}>Explore Atmosphere &amp; light ↗</a></div></section>}
</Layout>
