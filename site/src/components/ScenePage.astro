---
import Layout from '../layouts/Layout.astro';
import Media from './Media.astro';
import Card from './Card.astro';
import ViewButtons from './ViewButtons.astro';
import {asset,subjects,byId,sourceURL,connections,type Entry} from '../data/catalog';
import {url} from '../lib/urls';
interface Props {entry:Entry;path:string}
const {entry:e,path}=Astro.props;const family=subjects.find(f=>f.id===e.family)!;
const guardian=e.id==='guardian';const views=[{id:'marble',label:'Marble',asset:'guardian',caption:'Guardian in restrained marble.'},{id:'limestone',label:'Limestone',asset:'guardian-limestone',caption:'Guardian in limestone.'}];
const image=guardian?asset('guardian'):undefined;
const connection=connections.find(c=>c.id==='water-to-terrain')!;
const reasons=(e as Entry & {related_reasons?:Record<string,string>}).related_reasons;
---
<Layout title={e.title} description={e.summary} path={path}>
  <section class="page-title"><div class="crumbs"><a href={url('/demos/',path)}>Demos</a><span>/</span><a href={url(`/demos/${e.family}/`,path)}>{family.title}</a><span>/</span><span>{e.title}</span></div><div class="scene-layout" data-comparison={guardian?true:undefined}><div><span class="eyebrow">{e.dimension==='2.5D'?'Surface flow':e.dimension} / {family.title}</span><h1>{e.title}</h1><p class="intro">{e.summary}</p>{guardian && <><ViewButtons views={views} path={path} label="Guardian material"/><p class="comparison-caption" aria-live="polite" data-comparison-caption>{views[0].caption}</p><noscript><a href={url(asset('guardian-limestone').file,path)}>Open the limestone view</a></noscript></>}</div><div class:list={['feature-panel',{'form-stage':e.family==='sdf'}]}>{guardian&&image?<img data-comparison-image src={url(image.file,path)} width={image.width} height={image.height} alt={views[0].caption} fetchpriority="high"/>:<Media entry={e.id} path={path} title={e.title} eager caption={e.id==='robot'?'Playback of the saved authored construction.':undefined}/>}</div></div></section>
  <section class="section scene-detail"><div class="aside-label">In this scene</div><div><div class="cues">{e.cues.map(c=><span class="cue">{c}</span>)}</div><a class="source-link" href={sourceURL(e)}>Run locally / source ↗</a><details><summary>About this scene</summary><p class="note">{e.scope}</p></details></div></section>
  {e.related.length>0 && <section class="section"><div class="section-head"><h2>{e.id==='shallow-water'?'Where this led.':'Keep exploring.'}</h2></div>{e.id==='shallow-water'&&<div class="related-context" data-connection="water-to-terrain"><p>{connection.summary}</p><p class="note">{connection.public_boundary}</p></div>}<div class="grid cards">{e.related.map(id=><Card entry={byId[id]} path={path} reason={reasons?.[id]}/>)}</div></section>}
</Layout>
