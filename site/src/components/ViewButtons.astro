---
import {asset} from '../data/catalog';
import {url} from '../lib/urls';
export interface View {id:string; label:string; asset:string; caption:string}
interface Props {views:View[]; path:string; label:string}
const {views,path,label}=Astro.props;
---
<div class="comparison-controls" role="group" aria-label={label}>{views.map((v,i)=><button class="filter" data-view={v.id} data-image={url(asset(v.asset).file,path)} data-caption={v.caption} aria-pressed={i===0?'true':'false'}>{v.label}</button>)}</div>
