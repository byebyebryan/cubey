---
import ViewButtons from './ViewButtons.astro';
import {asset} from '../data/catalog';
import {url} from '../lib/urls';
interface Props {path:string; initial?:'intact'|'section'}
const {path,initial='intact'}=Astro.props;
const views=[
  {id:'observatory-intact',label:'Intact',asset:'csg-observatory-intact',caption:'The finished observatory: a hollow drum and dome surround the telescope and keeper room.'},
  {id:'observatory-section',label:'Section',asset:'csg-observatory-section',caption:'A saved cut opens the architecture while the telescope, mount and keeper-room contents remain in place.'},
];
const active=views[initial==='section'?1:0];const image=asset(active.asset);
---
<div class="comparison-view" id="observatory-cutaway" data-comparison>
  <div class="comparison-description"><h2>Open the observatory.</h2><p>The same solid description gives the building its outside and its inside. A cut reveals the shell, the telescope mount and the room beside it.</p><ViewButtons views={views} path={path} label="Observatory cutaway" initial={active.id}/><p class="comparison-caption" aria-live="polite" data-comparison-caption>{active.caption}</p><p class="note">Native renders · matching camera and light · saved architectural cut.</p><noscript><p><a href={url(asset(views[0].asset).file,path)}>Open the intact view</a> · <a href={url(asset(views[1].asset).file,path)}>Open the section view</a></p></noscript></div>
  <div class="comparison-media"><img data-comparison-image src={url(image.file,path)} width={image.width} height={image.height} alt={active.caption} loading="lazy"/></div>
</div>
