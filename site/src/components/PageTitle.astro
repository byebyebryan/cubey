---
import {url} from '../lib/urls';
interface Props { subject: string; title: string; intro: string; path: string }
const {subject,title,intro,path}=Astro.props;
---
<section class="page-title"><nav class="crumbs" aria-label="Breadcrumb"><a href={url('/demos/',path)}>Demos</a><span aria-hidden="true">/</span><span aria-current="page">{subject}</span></nav><h1>{title}</h1><p class="intro">{intro}</p></section>
