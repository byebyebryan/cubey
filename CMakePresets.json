{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CUBEY_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CUBEY_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Dev Debug + ASan/UBSan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tidy",
      "displayName": "Dev Debug + clang-tidy",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "CUBEY_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "dev-terrain-studies",
      "displayName": "Dev Debug + Terrain Studies",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-terrain-studies",
      "cacheVariables": {
        "CUBEY_BUILD_TERRAIN_STUDIES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "dev-terrain-studies",
      "configurePreset": "dev-terrain-studies"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "filter": {
        "exclude": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-windowed",
      "displayName": "Dev Windowed Smoke",
      "configurePreset": "dev",
      "environment": {
        "CUBEY_ALLOW_WINDOWED_TESTS": "1"
      },
      "filter": {
        "include": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "filter": {
        "exclude": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-terrain-studies",
      "configurePreset": "dev-terrain-studies",
      "filter": {
        "exclude": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
