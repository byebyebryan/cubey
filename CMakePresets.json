{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CUBEY_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "CUBEY_ENABLE_WARNINGS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Dev Debug + ASan/UBSan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Dev Debug + TSan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CUBEY_ENABLE_TSAN_TESTS": "ON",
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=thread"
      }
    },
    {
      "name": "tidy",
      "displayName": "Dev Debug + clang-tidy",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "CUBEY_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "dev-cloud-studies",
      "displayName": "Dev Debug + Cloud Reference Study",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-cloud-studies",
      "cacheVariables": {
        "CUBEY_BUILD_CLOUD_STUDIES": "ON"
      }
    },
    {
      "name": "dev-planet-studies",
      "displayName": "Dev Debug + Paused Planet Study",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-planet-studies",
      "cacheVariables": {
        "CUBEY_BUILD_PLANET_STUDIES": "ON"
      }
    },
    {
      "name": "dev-terrain-studies",
      "displayName": "Dev Debug + Terrain Studies",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-terrain-studies",
      "cacheVariables": {
        "CUBEY_BUILD_TERRAIN_STUDIES": "ON"
      }
    },
    {
      "name": "dev-gltf-conformance",
      "displayName": "Dev Debug + glTF Sample Conformance",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-gltf-conformance",
      "cacheVariables": {
        "CUBEY_FETCH_GLTF_SAMPLE_ASSETS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-cloud-studies",
      "configurePreset": "dev-cloud-studies"
    },
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "dev-terrain-studies",
      "configurePreset": "dev-terrain-studies"
    },
    {
      "name": "dev-gltf-conformance",
      "configurePreset": "dev-gltf-conformance"
    },
    {
      "name": "dev-planet-studies",
      "configurePreset": "dev-planet-studies"
    }
  ],
  "testPresets": [
    {
      "name": "dev-cloud-studies",
      "configurePreset": "dev-cloud-studies",
      "filter": {
        "include": {
          "label": "^reference$"
        },
        "exclude": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "filter": {
        "exclude": {
          "label": "^(windowed|sync_validation|fluid_domain)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-windowed",
      "displayName": "Dev Windowed Smoke",
      "configurePreset": "dev",
      "environment": {
        "CUBEY_ALLOW_WINDOWED_TESTS": "1"
      },
      "filter": {
        "include": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "displayName": "Owned-code ASan/UBSan",
      "description": "Sanitizer gate for Cubey-owned non-windowed, non-GPU, non-artifact tests.",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:suppressions=${sourceDir}/cmake/ubsan.supp"
      },
      "filter": {
        "exclude": {
          "label": "^(windowed|gpu|artifact|fluid_domain)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-gpu",
      "displayName": "Headless GPU ASan/UBSan",
      "description": "Headless GPU sanitizer lane with driver-bound leak detection disabled.",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1:suppressions=${sourceDir}/cmake/ubsan.supp"
      },
      "filter": {
        "include": {
          "label": "^gpu$"
        },
        "exclude": {
          "label": "^(windowed|sanitizer_external|sync_validation)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer Core Runtime",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "filter": {
        "include": {
          "name": "^cubey_tsan_concurrency_tests$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-terrain-studies",
      "configurePreset": "dev-terrain-studies",
      "filter": {
        "exclude": {
          "label": "^(windowed|sync_validation|fluid_domain)$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-gltf-conformance",
      "displayName": "glTF Sample Conformance",
      "configurePreset": "dev-gltf-conformance",
      "filter": {
        "include": {
          "label": "^(gltf|gltf_sample|conformance)$"
        },
        "exclude": {
          "label": "^windowed$"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-planet-studies",
      "configurePreset": "dev-planet-studies",
      "filter": {
        "include": {
          "label": "^planet_study$"
        },
        "exclude": {
          "label": "windowed"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-sync-validation",
      "displayName": "Foundation synchronization validation",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^sync_validation$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-docs",
      "displayName": "Documentation, media integrity and native recipe parsing",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "name": "^(documentation_.*|project_layout_.*|fluid_25d_presentation_docs|fluid_25d_presentation_media|gltf_viewer_showcase_media)$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-foundation",
      "displayName": "Core, build and foundation policy",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "name": "^(cubey_core_tests|foundation_.*|project_layout_.*|cmake_app_policy_rules|shader_build_rules)$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-capture-media",
      "displayName": "Decoded capture media contracts",
      "configurePreset": "dev",
      "environment": {
        "CUBEY_REQUIRE_CAPTURE_MEDIA_TESTS": "1"
      },
      "filter": {
        "include": {
          "name": "^capture_media_"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev-fluid-domains",
      "displayName": "Fluid CPU domain contracts",
      "description": "Alternative domain selectors over the same 64 cases as fluid_25d_tests.",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^fluid_domain$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
